;; Views and components: a small language for describing the document, compiled to patches (std/web/patches).
(require-unqualified host/events)
(require-unqualified std/web/patches)
(require-unqualified std/web/canvas)

(provide view messages component emit! send! ui-root request! subscribe! unsubscribe!
         ui-text-set! ui-text-slot! ui-attr-set! ui-attr-slot! ui-int-set! ui-int-slot! ui-truth-set! ui-truth-slot!
         ui-number-set! ui-number-slot! ui-focus-slot! ui-scroll-end-slot! ui-pointer-lock-slot! ui-read-with!
         ui-event-text ui-event-truth ui-event-number ui-is ui-listener ui-listen ui-heard ui-listener-heard
         ui-instance ui-parent-listener ui-instance-start! ui-instance-end! ui-enter! ui-leave! ui-hear! ui-deliver
         ui-emit ui-send ui-root! ui-root-with! ui-render! ui-flush-with!
         ui-row ui-rows ui-each! ui-each-clear!)

;; ---- run-time support: slots ----

(define (keep-text! [cache (ptr string)] [s string]) -> bool
  (when (== (@ cache) s) (return #f))
  (free (-> (@ cache) bytes))
  (set! (@ cache) (string-copy s))
  #t)

(define (ui-text-set! [cache (ptr string)] [node u32] [s string])
  (set! (@ cache) (string-copy s))
  (dom-set-text! node (@ cache)))

(define (ui-text-slot! [cache (ptr string)] [node u32] [s string])
  (when (keep-text! cache s) (dom-set-text! node (@ cache))))

(define (ui-attr-set! [cache (ptr string)] [node u32] [name string] [s string])
  (set! (@ cache) (string-copy s))
  (dom-set-attr! node name (@ cache)))

(define (ui-attr-slot! [cache (ptr string)] [node u32] [name string] [s string])
  (when (keep-text! cache s) (dom-set-attr! node name (@ cache))))

(define (int-text [n i64]) -> string
  (let* ([p (cast (ptr u8) (dom-frame-alloc 24))] [i u32 24] [u u64 (if (< n 0) (- 0 n) n)])
    (while #t
      (-= i 1)
      (set! (@ p i) (+ 48 (cast i32 (% u 10))))
      (set! u (/ u 10))
      (when (== u 0) (break)))
    (when (< n 0)
      (-= i 1)
      (set! (@ p i) 45))
    (cast string (slice (+ p i) (- 24 i)))))

(define (ui-int-set! [cache (ptr i64)] [node u32] [n i64])
  (set! (@ cache) n)
  (dom-set-text! node (int-text n)))

(define (ui-int-slot! [cache (ptr i64)] [node u32] [n i64])
  (when (!= (@ cache) n) (ui-int-set! cache node n)))

(define (ui-truth-set! [cache (ptr bool)] [node u32] [name string] [on bool])
  (set! (@ cache) on)
  (when on (dom-set-attr! node name "")))

(define (ui-truth-slot! [cache (ptr bool)] [node u32] [name string] [on bool])
  (when (!= (@ cache) on)
    (set! (@ cache) on)
    (if on (dom-set-attr! node name "") (dom-remove-attr! node name))))

(define (ui-number-set! [cache (ptr i64)] [node u32] [name string] [n i64])
  (set! (@ cache) n)
  (dom-set-attr! node name (int-text n)))

(define (ui-number-slot! [cache (ptr i64)] [node u32] [name string] [n i64])
  (when (!= (@ cache) n) (ui-number-set! cache node name n)))

(define (changed! [cache (ptr i64)] [n i64]) -> bool
  (when (== (@ cache) n) (return #f))
  (set! (@ cache) n)
  #t)

(define (ui-focus-slot! [cache (ptr i64)] [node u32] [n i64])
  (when (changed! cache n) (dom-call! node "focus")))

(define (ui-scroll-end-slot! [cache (ptr i64)] [node u32] [n i64])
  (when (changed! cache n) (dom-write-number! node "scrollTop" 1000000000.0)))

(define (ui-pointer-lock-slot! [cache (ptr i64)] [node u32] [n i64])
  (when (changed! cache n)
    (if (!= n 0) (dom-call! node "requestPointerLock") (dom-call! dom-document "exitPointerLock"))))

;; ---- run-time support: event listeners ----

;; A listener's slot. It is also the tag of the listener's event.
(struct ui-listener
  [handle handler] [node u32] [fill (fn ((ptr void) u32))] [instance (ptr ui-instance)] [message (ptr void)])

(define (ui-listen [node u32] [event string] [l (ptr ui-listener)] [message (ptr void)] [fill (fn ((ptr void) u32))]
                   [window bool])
  (set! (-> l handle) ui-listener-heard)
  (set! (-> l node) node)
  (set! (-> l fill) fill)
  (set! (-> l instance) current)
  (set! (-> l message) message)
  (if window (dom-listen-window! node event (cast (ptr void) l)) (dom-listen! node event (cast (ptr void) l))))

(define (ui-heard [at (ptr void)]) -> (ptr void)
  (let* ([l (cast (ptr ui-listener) at)] [fill (-> l fill)])
    (when (!= fill 0) (fill (-> l message) (-> l node)))
    (-> l message)))

(define (ui-listener-heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (ui-deliver (-> (cast (ptr ui-listener) tag) instance) (ui-heard tag)))

;; The reads of the current event and of the document, by name (std/web/dom.sub).
(define event-texts (fn (string) -> string) 0)
(define event-numbers (fn (string) -> f64) 0)
(define node-is (fn (u32 u32 string) -> bool) 0)

(define (ui-read-with! [texts (fn (string) -> string)] [numbers (fn (string) -> f64)]
                       [is (fn (u32 u32 string) -> bool)])
  (set! event-texts texts)
  (set! event-numbers numbers)
  (set! node-is is))

(define (ui-event-text [path string]) -> string
  (let ([f event-texts])
    (if (== f 0) "" (f path))))

(define (ui-event-number [path string]) -> f64
  (let ([f event-numbers])
    (if (== f 0) 0.0 (f path))))

(define (ui-event-truth [path string]) -> bool (!= (ui-event-number path) 0.0))

(define (ui-is [node u32] [from u32] [path string]) -> bool
  (let ([f node-is])
    (and (!= f 0) (f node from path))))

;; ---- run-time support: components ----

;; The header that every instance begins with.
(struct ui-instance
  [update (fn ((ptr void) (ptr void)))] [trapped (fn ((ptr void) string))] [state (ptr void)] [parent (ptr ui-instance)]
  [messages string] [events string] [heard (ptr ui-parent-listener)] [heard-count u32] [requests (ptr ui-request)])

(struct ui-parent-listener [call (fn ((ptr void) (ptr void)))] [parent (ptr ui-instance)])

;; A request's tag, from request! or subscribe!.
(struct ui-request [handle handler] [instance (ptr ui-instance)] [run handler] [once bool] [next (ptr ui-request)])

(typedef ui-render (fn ()))

(define current (ptr ui-instance) 0)
(define depth u32 0)

(define roots (array ui-render 32))
(define root-count u32 0)
(define flush ui-render 0)

(define (ui-enter! [i (ptr ui-instance)]) -> (ptr ui-instance)
  (let ([outer current])
    (set! current i)
    (+= depth 1)
    outer))

(define (ui-leave! [outer (ptr ui-instance)])
  (set! current outer)
  (-= depth 1))

(define (ui-instance-start! [i (ptr ui-instance)] [state (ptr void)] [update (fn ((ptr void) (ptr void)))]
                            [trapped (fn ((ptr void) string))] [messages string] [events string]
                            [heard (ptr ui-parent-listener)] [heard-count u32])
  (set! (-> i update) update)
  (set! (-> i trapped) trapped)
  (set! (-> i state) state)
  (set! (-> i parent) current)
  (set! (-> i messages) messages)
  (set! (-> i events) events)
  (set! (-> i heard) heard)
  (set! (-> i heard-count) heard-count)
  (set! (-> i requests) 0)
  (when (!= trapped 0) (trap-handler! ui-trapped)))

;; An ended instance's requests drop their events. One from request! is freed when its event comes, and one from
;; subscribe! is kept.
(define (ui-instance-end! [i (ptr ui-instance)])
  (let ([r (-> i requests)])
    (while (!= r 0)
      (let ([next (-> r next)])
        (set! (-> r instance) 0)
        (set! (-> r next) 0)
        (set! r next))))
  (set! (-> i requests) 0)
  (set! (-> i update) 0))

(define (ui-hear! [heard (ptr ui-parent-listener)] [k u32] [call (fn ((ptr void) (ptr void)))])
  (let ([h (+ heard k)])
    (set! (-> h call) call)
    (set! (-> h parent) current)))

(define (ui-deliver [i (ptr ui-instance)] [message (ptr void)])
  (when (and (!= i 0) (!= (-> i update) 0))
    (let ([outer (ui-enter! i)])
      ((-> i update) (-> i state) message)
      (ui-leave! outer)
      (when (== depth 0) (ui-render!)))))

(define (ui-root! [render ui-render])
  (when (== root-count 32) (host-trap "ui: more than 32 components are attached"))
  (set! (@ roots root-count) render)
  (+= root-count 1))

(define (ui-flush-with! [f ui-render]) (set! flush f))

;; ui-root-with! makes render a root of this copy of web-ui. The copy that attaches the root gives its event reads and
;; its flush. Each view and component names the ui-root-with! of the copy that made it.
(define (ui-root-with! [render ui-render] [texts (fn (string) -> string)] [numbers (fn (string) -> f64)]
                       [is (fn (u32 u32 string) -> bool)] [f ui-render])
  (ui-read-with! texts numbers is)
  (ui-flush-with! f)
  (ui-root! render))

(define (ui-render!)
  (for ([k u32 0]) (< k root-count) (+= k 1) ((@ roots k)))
  (let ([f flush])
    (when (!= f 0) (f))))

(define (wrong-type! [who string] [kind string] [declared string] [given string])
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) who)
    (if (== (-> declared length) 0)
        (begin
          (buffer-add-string! (& b) ": this component declares no ")
          (buffer-add-string! (& b) kind))
        (begin
          (buffer-add-string! (& b) ": this component's ")
          (buffer-add-string! (& b) kind)
          (buffer-add-string! (& b) " are ")
          (buffer-add-string! (& b) declared)
          (buffer-add-string! (& b) ", not ")
          (buffer-add-string! (& b) given)))
    (host-trap (buffer-string (& b)))))

(define (running [who string]) -> (ptr ui-instance)
  (let ([i current])
    (when (== i 0)
      (let ([b (make-buffer)])
        (buffer-add-string! (& b) who)
        (buffer-add-string! (& b) ": no component's code is running")
        (host-trap (buffer-string (& b)))))
    i))

(define (ui-emit [events string] [e (ptr void)])
  (let ([i (running "emit!")])
    (unless (== (-> i events) events) (wrong-type! "emit!" "events" (-> i events) events))
    (for ([k u32 0]) (< k (-> i heard-count)) (+= k 1)
      (let ([h (+ (-> i heard) k)])
        ((-> h call) (cast (ptr void) (-> h parent)) e)))))

(define (ui-send [messages string] [m (ptr void)])
  (let ([i (running "send!")])
    (unless (== (-> i messages) messages) (wrong-type! "send!" "messages" (-> i messages) messages))
    (ui-deliver i m)))

;; ---- run-time support: requests ----

(define (ui-request-heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (let* ([r (cast (ptr ui-request) tag)] [i (-> r instance)] [once (-> r once)])
    (when (!= i 0)
      (let ([outer (ui-enter! i)])
        ((-> r run) source kind id tag value)
        (ui-leave! outer)))
    (when once
      (when (!= i 0) (unlink! i r))
      (free r))
    (when (and (!= i 0) (== depth 0)) (ui-render!))))

(define (unlink! [i (ptr ui-instance)] [r (ptr ui-request)])
  (if (== (-> i requests) r)
      (set! (-> i requests) (-> r next))
      (let ([p (-> i requests)])
        (while (and (!= p 0) (!= (-> p next) r)) (set! p (-> p next)))
        (when (!= p 0) (set! (-> p next) (-> r next))))))

(define (new-request [h handler] [once bool] [who string]) -> (ptr void)
  (let ([i (running who)] [r (cast (ptr ui-request) (malloc (sizeof ui-request)))])
    (set! (-> r handle) ui-request-heard)
    (set! (-> r instance) i)
    (set! (-> r run) h)
    (set! (-> r once) once)
    (set! (-> r next) (-> i requests))
    (set! (-> i requests) r)
    (cast (ptr void) r)))

;; A tag for a host call that answers with one event. The event runs h for the component whose code asked, and the tag
;; is freed after it.
(define (request! [h handler]) -> (ptr void) (new-request h #t "request!"))

;; A tag for a host call whose events keep coming, such as a worker's. Each runs h for the component whose code asked,
;; until unsubscribe! frees the tag.
(define (subscribe! [h handler]) -> (ptr void) (new-request h #f "subscribe!"))

(define (unsubscribe! [tag (ptr void)])
  (let* ([r (cast (ptr ui-request) tag)] [i (-> r instance)])
    (when (-> r once) (host-trap "unsubscribe!: this tag is from request!, which frees itself"))
    (when (!= i 0) (unlink! i r))
    (free r)))

;; ---- run-time support: traps ----

(define (ui-trapped [why string])
  (let ([i current])
    (set! depth 0)
    (set! current 0)
    (while (and (!= i 0) (== (-> i trapped) 0)) (set! i (-> i parent)))
    (when (== i 0)
      (let ([b (make-buffer)])
        (buffer-add-string! (& b) "error: ")
        (buffer-add-string! (& b) why)
        (host-exit -1 (buffer-string (& b)))))
    (dom-discard!)
    ((-> i trapped) (-> i state) why)
    (ui-render!)))

;; ---- run-time support: each ----

(struct ui-row [key u64] [state (ptr void)])
(struct ui-rows [items (ptr ui-row)] [count u32])

;; Every instance state begins with the number of its copy.
(define (first-of [state (ptr void)]) -> u32 (@ (cast (ptr u32) state)))

(define (table-key [key u64]) -> u64 (bit-or (<< key 1) 1))

(define (ui-each! [b (ptr ui-rows)] [parent u32] [anchor u32] [n u32] [size u32]
                  [key-of (closure (u32) -> u64)]
                  [mount (closure (u32 (ptr void) u32 u32))]
                  [update (closure (u32 (ptr void)))]
                  [unmount (closure ((ptr void) bool))])
  (let ([old (-> b items)] [m (-> b count)] [p u32 0] [s u32 0])
    (while (and (< p m) (< p n) (== (-> (+ old p) key) (key-of p)))
      (update p (-> (+ old p) state))
      (+= p 1))
    (when (and (== p m) (== p n)) (return))
    (while (and (< s (- m p)) (< s (- n p)) (== (-> (+ old (- m 1 s)) key) (key-of (- n 1 s)))) (+= s 1))
    (let* ([rows (-> (new 0 ui-row (+ n 1)) items)]
           [middle (- m p s)] [between (- n p s)]
           [used (-> (new 0 u8 (+ middle 1)) items)]
           [from (-> (new 0 i32 (+ between 1)) items)]
           [stays (-> (new 0 u8 (+ between 1)) items)]
           [index hash-table])
      (memset (& index) 0 (sizeof hash-table))
      (memcpy rows old (* p (sizeof ui-row)))
      (for ([i u32 0]) (< i middle) (+= i 1)
        (hash-set! (& index) (table-key (-> (+ old (+ p i)) key)) i))
      (for ([j u32 0]) (< j between) (+= j 1)
        (let* ([k (key-of (+ p j))] [found (hash-find (& index) (table-key k))] [r (+ rows (+ p j))])
          (set! (-> r key) k)
          (if (and (!= found 0) (== (-> (+ old (+ p (@ found))) key) k) (not (@ used (@ found))))
              (let ([i (@ found)])
                (set! (@ used i) 1)
                (set! (@ from j) (cast i32 i))
                (set! (-> r state) (-> (+ old (+ p i)) state)))
              (begin
                (set! (@ from j) -1)
                (set! (-> r state) 0)))))
      (for ([i u32 0]) (< i middle) (+= i 1)
        (unless (@ used i)
          (let ([state (-> (+ old (+ p i)) state)])
            (unmount state #t)
            (free state))))
      (for ([i u32 0]) (< i s) (+= i 1)
        (set! (@ rows (+ (- n s) i)) (@ old (+ (- m s) i)))
        (update (+ (- n s) i) (-> (+ rows (+ (- n s) i)) state)))
      (longest-rising (slice from between) (slice stays between))
      (let ([j between])
        (while (> j 0)
          (-= j 1)
          (let* ([at (+ p j)] [r (+ rows at)]
                 [before (if (< (+ at 1) n) (first-of (-> (+ rows (+ at 1)) state)) anchor)])
            (cond [(== (-> r state) 0)
                   (set! (-> r state) (malloc size))
                   (mount at (-> r state) parent before)]
                  [else
                   (update at (-> r state))
                   (unless (@ stays j) (dom-move! (first-of (-> r state)) parent before))]))))
      (hash-free! (& index))
      (free used)
      (free from)
      (free stays)
      (free old)
      (set! (-> b items) rows)
      (set! (-> b count) n))))

(define (longest-rising [xs (slice i32)] [stays (slice u8)])
  (let* ([n (-> xs length)] [ends (-> (new 0 u32 (+ n 1)) items)] [before (-> (new 0 i32 (+ n 1)) items)]
         [length u32 0])
    (for ([i u32 0]) (< i n) (+= i 1)
      (when (>= (@ xs i) 0)
        (let ([lo u32 0] [hi length])
          (while (< lo hi)
            (let ([mid (/ (+ lo hi) 2)])
              (if (< (@ xs (@ ends mid)) (@ xs i)) (set! lo (+ mid 1)) (set! hi mid))))
          (set! (@ before i) (if (> lo 0) (cast i32 (@ ends (- lo 1))) -1))
          (set! (@ ends lo) i)
          (when (== lo length) (+= length 1)))))
    (let ([i i32 (if (> length 0) (cast i32 (@ ends (- length 1))) -1)])
      (while (>= i 0)
        (set! (@ stays i) 1)
        (set! i (@ before i))))
    (free ends)
    (free before)))

(define (ui-each-clear! [b (ptr ui-rows)] [detach bool] [unmount (closure ((ptr void) bool))])
  (for ([i u32 0]) (< i (-> b count)) (+= i 1)
    (let ([state (-> (+ (-> b items) i) state)])
      (unmount state detach)
      (free state)))
  (free (-> b items))
  (set! (-> b items) 0)
  (set! (-> b count) 0))

;; ---- the `view` macro ----

(begin-for-syntax
  (require-unqualified compiler/macros)
  (require-unqualified std/meta/type-info)
  (require-unqualified std/html)

  (struct block [html buffer] [nodes u32] [fields datum] [mount datum] [update datum] [unmount datum]
          [state datum] [template datum] [unmounter datum])

  (define view-name datum 0)
  (define message-type datum 0)
  (define listening bool #f)
  (define blocks u32 0)
  (define fields u32 0)
  (define fills datum 0)
  (define definitions datum 0)
  (define in-rows bool #f)

  (define (fail [where datum] [message datum]) -> datum (raise-syntax-error 'view (datum->string message) where))

  (define (literal [d datum]) -> datum (datum->syntax #'here d 0))
  (define (number [n u32]) -> datum (literal (make-integer n)))

  (define (named [what datum]) -> datum
    (datum->syntax view-name (string->symbol (format-message "~a.~a" `(,(syntax-e view-name) ,what))) view-name))

  (define (new-block [top bool]) -> (ptr block)
    (let ([b (cast (ptr block) (arena-alloc (current-arena) (sizeof block)))] [n blocks])
      (+= blocks 1)
      (set! (-> b html) (make-buffer))
      (set! (-> b nodes) 0)
      (set! (-> b fields) nil)
      (set! (-> b mount) nil)
      (set! (-> b update) nil)
      (set! (-> b unmount) nil)
      (set! (-> b state) (named (if top '"state" (format "block~a" `(,(make-integer n))))))
      (set! (-> b template) (named (format "template~a" `(,(make-integer n)))))
      (set! (-> b unmounter) (named (if top '"unmount" (format "unmount~a" `(,(make-integer n))))))
      b))

  ;; ---- helpers for building a block ----

  (define (html-of [b (ptr block)]) -> (ptr buffer) (& (-> b html)))

  (define (node! [b (ptr block)]) -> datum
    (+= (-> b nodes) 1)
    #`(+ (-> bs first) #,(number (-> b nodes))))

  (define (field! [b (ptr block)] [type datum]) -> datum
    (let ([f (literal (string->symbol (format-message "f~a" `(,(make-integer fields)))))])
      (+= fields 1)
      (set! (-> b fields) (cons #`[#,f #,type] (-> b fields)))
      f))

  (define (mount! [b (ptr block)] [code datum]) (set! (-> b mount) (cons code (-> b mount))))
  (define (update! [b (ptr block)] [code datum]) (set! (-> b update) (cons code (-> b update))))
  (define (unmount! [b (ptr block)] [code datum]) (set! (-> b unmount) (cons code (-> b unmount))))
  (define (both! [b (ptr block)] [code datum]) (mount! b code) (update! b code))

  (define (statements [code datum]) -> datum (if (null? code) `(,#'(begin)) (reverse code)))

  (define (mount-code [b (ptr block)]) -> datum
    (let ([html (literal (string->datum (buffer-string (& (-> b html)))))])
      `(,#`(when (== #,(-> b template) 0) (set! #,(-> b template) (dom-template #,html)))
        ,#`(set! (-> bs first) (dom-add! #,(-> b template) parent before))
        ,@(reverse (-> b mount)))))

  (define (finish! [b (ptr block)])
    (set! definitions
          (append `(,#`(define (#,(-> b unmounter) [bs (ptr #,(-> b state))] [detach bool])
                         #,@(reverse (-> b unmount))
                         (if detach
                             (dom-remove! (-> bs first) #,(-> b template))
                             (dom-forget! (-> bs first) #,(-> b template))))
                    ,#`(define #,(-> b template) u32 0)
                    ,#`(struct #,(-> b state) [first u32] #,@(reverse (-> b fields))))
                  definitions)))

  ;; ---- the HTML vocabulary ----

  (define number-attributes datum '(cols colspan height maxlength minlength rows rowspan size span start tabindex width))

  (define events datum
    '(abort animationcancel animationend animationiteration animationstart auxclick beforeinput beforetoggle blur cancel
      canplay canplaythrough change click close compositionend compositionstart compositionupdate contextmenu copy cut
      dblclick drag dragend dragenter dragleave dragover dragstart drop durationchange ended error focus focusin focusout
      input invalid keydown keypress keyup load loadeddata loadedmetadata mousedown mouseenter mouseleave mousemove
      mouseout mouseover mouseup paste pause play playing pointercancel pointerdown pointerenter pointerleave pointermove
      pointerout pointerover pointerup progress reset scroll scrollend seeked seeking select submit timeupdate toggle
      touchcancel touchend touchmove touchstart transitioncancel transitionend transitionrun transitionstart visibility
      volumechange wheel))

  (define window-events datum '(frame resize hashchange popstate online offline visibilitychange pointerlockchange pointerlockerror))

  ;; ---- compiling a block's children ----

  (define (view-of [head datum]) -> datum
    (if (== (identifier-binding-kind head) 'compile-time-value)
        (let ([v (syntax-local-value head)])
          (if (and (pair? v) (== (car v) 'ui-view)) v 0))
        0))

  (define (component-of [head datum]) -> datum
    (if (== (identifier-binding-kind head) 'compile-time-value)
        (let ([c (syntax-local-value head)])
          (if (and (pair? c) (== (car c) 'ui-component)) c 0))
        0))

  ;; The ui-root-with! of the copy of web-ui that made a view or component, or 0 when a web-ui older than 0.10.2
  ;; made it.
  (define (copy-root [r datum]) -> datum
    (let ([l (if (== (car r) 'ui-view) (cddddr r) (cdr (cddddr r)))]) (if (pair? l) (car l) 0)))

  (define (older! [head datum] [r datum])
    (when (== (copy-root r) 0)
      (fail head (format "~a was made by a web-ui older than 0.10.2, so this web-ui cannot use it"
                         `(,(syntax-e head))))))

  (define (own! [head datum] [r datum])
    (older! head r)
    (unless (free-identifier=? (copy-root r) #'ui-root-with!)
      (fail head (format "~a was made by another copy of web-ui, so only attach can put it in the document"
                         `(,(syntax-e head))))))

  (define (view-names [v datum]) -> datum (syntax->list (cadr v)))

  (define (view-messages [v datum]) -> datum (let ([m (cadddr v)]) (if (identifier? m) m 0)))

  (define (shape [x datum]) -> datum (syntax->datum (datum->syntax #'here x 0)))

  (define (same-type? [a datum] [b datum]) -> bool (equal? (shape (type-info a)) (shape (type-info b))))

  (define (type-name [t datum]) -> datum (syntax-e t))

  ;; A variant's case named c, as type-info gives it: (case (field . type) ...), or 0.
  (define (variant-case [t datum] [c datum]) -> datum
    (let ([cases (caddr (type-info t))] [found datum 0])
      (while (pair? cases)
        (when (== (syntax-e (car (car cases))) (syntax-e c)) (set! found (car cases)))
        (set! cases (cdr cases)))
      found))

  (define (case-names [t datum]) -> datum
    (for/list ([c (caddr (type-info t))]) (syntax-e (car c))))

  (define (single-case? [t datum]) -> bool (== (length (caddr (type-info t))) 1))

  ;; The name of a variant's type as a string, for the run-time checks of emit! and send!.
  (define (type-text [t datum]) -> datum
    (if (== t 0) (literal '"") (literal (string->datum (symbol->string (syntax-e (cadr (type-info t))))))))

  (define (check-arguments! [f datum] [v datum] [arguments datum])
    (let ([n (length (syntax->list (caddr v)))])
      (unless (== (length arguments) n)
        (fail f (format "the view ~a takes ~a argument~a, but this passes ~a"
                        `(,(syntax-e (car (syntax->list f))) ,(make-integer n) ,(if (== n 1) '"" '"s")
                          ,(make-integer (length arguments))))))))

  (define (attributes? [x datum]) -> bool
    (let ([l (syntax->list x)])
      (and (!= l 0) (or (null? l) (not (identifier? (car l)))))))

  (define (compile-children! [b (ptr block)] [children datum])
    (while (pair? children)
      (compile-child! b (car children))
      (set! children (cdr children))))

  (define (compile-child! [b (ptr block)] [f datum])
    (let ([e (syntax-e f)] [l (syntax->list f)])
      (cond [(string? e) (html-text! (html-of b) (datum->string e))]
            [(or (== l 0) (null? l) (not (identifier? (car l))))
             (fail f '"expected a child: text in quotes, an element (tag ...), (text e), (int e), (if c child child), (when c child ...), (each [x items n] #:key k child ...), a view (v e ...) or a component (c ([parameter value] ...))")]
            [else
             (let ([word (syntax-e (car l))])
               (cond [(== word 'text) (text! b f l)]
                     [(== word 'int) (int! b f l)]
                     [(== word 'if) (if! b f l)]
                     [(== word 'when) (when! b f l)]
                     [(== word 'each) (each! b f l)]
                     [(!= (view-of (car l)) 0) (own! (car l) (view-of (car l))) (call! b f l (view-of (car l)))]
                     [(!= (component-of (car l)) 0)
                      (own! (car l) (component-of (car l)))
                      (component-call! b f l (component-of (car l)))]
                     [else (element! b f l)]))])))

  (define (text! [b (ptr block)] [f datum] [l datum])
    (unless (== (length l) 2) (fail f '"expected (text e)"))
    (html-comment! (html-of b) "t")
    (let ([node (node! b)] [slot (field! b #'string)])
      (mount! b #`(ui-text-set! (& (-> bs #,slot)) #,node #,(cadr l)))
      (update! b #`(ui-text-slot! (& (-> bs #,slot)) #,node #,(cadr l)))
      (unmount! b #`(free (-> bs #,slot bytes)))))

  (define (int! [b (ptr block)] [f datum] [l datum])
    (unless (== (length l) 2) (fail f '"expected (int e)"))
    (html-comment! (html-of b) "t")
    (let ([node (node! b)] [slot (field! b #'i64)])
      (mount! b #`(ui-int-set! (& (-> bs #,slot)) #,node #,(cadr l)))
      (update! b #`(ui-int-slot! (& (-> bs #,slot)) #,node #,(cadr l)))))

  (define (element! [b (ptr block)] [f datum] [l datum])
    (let* ([tag (syntax-e (car l))]
           [given (and (pair? (cdr l)) (attributes? (cadr l)))]
           [attributes (if given (syntax->list (cadr l)) nil)]
           [children (if given (cddr l) (cdr l))]
           [node datum 0])
      (when (or (== tag 'svg) (== tag 'math))
        (fail (car l) (format "~a is not supported: a view can contain HTML elements only, not SVG or MathML" `(,tag))))
      (unless (or (html-element? (symbol->string tag)) (custom-element? (symbol->string tag)))
        (fail (car l) (format "unknown element ~a: it is not an HTML element or a view (a custom element's name must be lower-case and contain a hyphen)" `(,tag))))
      (html-open! (html-of b) (symbol->string tag))
      (while (pair? attributes)
        (let* ([a (car attributes)] [al (syntax->list a)])
          (unless (and (!= al 0) (pair? al) (or (identifier? (car al)) (string? (syntax-e (car al)))))
            (fail a '"expected [name value], [name], [on event message], [draw key code], [node place], [focus e], [scroll-end e] or [pointer-lock e]"))
          (attribute! b tag a al (& node)))
        (set! attributes (cdr attributes)))
      (html-opened! (html-of b))
      (if (void-element? (symbol->string tag))
          (unless (null? children) (fail f (format "the element ~a cannot have children" `(,tag))))
          (begin
            (compile-children! b children)
            (html-close! (html-of b) (symbol->string tag))))))

  (define (marked! [b (ptr block)] [node (ptr datum)]) -> datum
    (when (== (@ node) 0)
      (set! (@ node) (node! b))
      (html-flag! (html-of b) "data-n"))
    (@ node))

  (define (attribute-html! [b (ptr block)] [name datum] [value datum])
    (if (== value 0)
        (html-flag! (html-of b) (symbol->string name))
        (html-attribute! (html-of b) (symbol->string name) (datum->string value))))

  (define (attribute! [b (ptr block)] [tag datum] [a datum] [al datum] [node (ptr datum)])
    (let* ([word (syntax-e (car al))] [checked (symbol? word)] [name (if checked word (string->symbol (datum->string word)))])
      (unless (attribute-name? (symbol->string name))
        (fail (car al) '"invalid attribute name: it must not be empty or contain spaces, quotes, >, / or ="))
      (cond [(and checked (== name 'on)) (listener! b a al node #f)]
            [(and checked (== name 'on-window)) (listener! b a al node #t)]
            [(and checked (== name 'draw)) (draw! b tag a al node)]
            [(and checked (== name 'node))
             (unless (== (length al) 2) (fail a '"expected [node place]"))
             (mount! b #`(set! #,(cadr al) #,(marked! b node)))]
            [(and checked (or (== name 'focus) (== name 'scroll-end) (== name 'pointer-lock)))
             (unless (== (length al) 2) (fail a (format "expected [~a e]" `(,name))))
             (let ([slot (field! b #'i64)] [at (marked! b node)]
                   [run (cond [(== name 'focus) #'ui-focus-slot!]
                              [(== name 'scroll-end) #'ui-scroll-end-slot!]
                              [else #'ui-pointer-lock-slot!])])
               (mount! b #`(set! (-> bs #,slot) #,(cadr al)))
               (update! b #`(#,run (& (-> bs #,slot)) #,at #,(cadr al))))]
            [(== name 'data-n) (fail (car al) '"the attribute data-n is reserved: ui.sub uses it to mark elements")]
            [(and checked (not (attribute-of? (symbol->string tag) (symbol->string name))))
             (fail (car al) (format "unknown attribute ~a for the element ~a (to use an attribute that HTML does not define, write its name as a string: [\"~a\" value])" `(,name ,tag ,name)))]
            [(and checked (boolean-attribute? (symbol->string name))) (truth-attribute! b a al name node)]
            [(and checked (!= (memq name number-attributes) 0)) (number-attribute! b a al name node)]
            [else (text-attribute! b tag a al name node)])))

  (define (text-attribute! [b (ptr block)] [tag datum] [a datum] [al datum] [name datum] [node (ptr datum)])
    (unless (== (length al) 2) (fail a (format "expected [~a e], where e is a string" `(,name))))
    (let ([v (cadr al)])
      (if (and (string? (syntax-e v)) (not (and (== name 'value) (or (== tag 'textarea) (== tag 'select)))))
          (attribute-html! b name (syntax-e v))
          (let ([slot (field! b #'string)] [at (marked! b node)])
            (mount! b #`(ui-attr-set! (& (-> bs #,slot)) #,at #,(literal (string->datum (symbol->string name))) #,v))
            (update! b #`(ui-attr-slot! (& (-> bs #,slot)) #,at #,(literal (string->datum (symbol->string name))) #,v))
            (unmount! b #`(free (-> bs #,slot bytes)))))))

  (define (truth-attribute! [b (ptr block)] [a datum] [al datum] [name datum] [node (ptr datum)])
    (cond [(== (length al) 1) (attribute-html! b name 0)]
          [(or (!= (length al) 2) (string? (syntax-e (cadr al))))
           (fail a (format "~a is a boolean attribute: write [~a], or [~a e] where e is a condition" `(,name ,name ,name)))]
          [else
           (let ([slot (field! b #'bool)] [at (marked! b node)] [text (literal (string->datum (symbol->string name)))])
             (mount! b #`(ui-truth-set! (& (-> bs #,slot)) #,at #,text #,(cadr al)))
             (update! b #`(ui-truth-slot! (& (-> bs #,slot)) #,at #,text #,(cadr al))))]))

  (define (number-attribute! [b (ptr block)] [a datum] [al datum] [name datum] [node (ptr datum)])
    (unless (== (length al) 2) (fail a (format "expected [~a n], where n is an integer" `(,name))))
    (let* ([v (cadr al)] [d (syntax-e v)])
      (cond [(string? d) (attribute-html! b name d)]
            [(integer? d) (attribute-html! b name (format "~a" `(,d)))]
            [else
             (let ([slot (field! b #'i64)] [at (marked! b node)] [text (literal (string->datum (symbol->string name)))])
               (mount! b #`(ui-number-set! (& (-> bs #,slot)) #,at #,text #,v))
               (update! b #`(ui-number-slot! (& (-> bs #,slot)) #,at #,text #,v)))])))

  (define (draw! [b (ptr block)] [tag datum] [a datum] [al datum] [node (ptr datum)])
    (unless (== tag 'canvas) (fail (car al) '"draw can only be used on a canvas element"))
    (unless (== (length al) 3) (fail a '"expected [draw key code]"))
    (let ([slot (field! b #'i64)] [at (marked! b node)] [key (cadr al)] [code (caddr al)])
      (mount! b #`(let ([key i64 #,key])
                    (set! (-> bs #,slot) key)
                    (canvas-begin! #,at)
                    #,code
                    (canvas-end!)))
      (update! b #`(let ([key i64 #,key])
                     (when (!= (-> bs #,slot) key)
                       (set! (-> bs #,slot) key)
                       (canvas-begin! #,at)
                       #,code
                       (canvas-end!))))))

  (define (listener! [b (ptr block)] [a datum] [al datum] [node (ptr datum)] [window bool])
    (unless (== (length al) 3) (fail a (if window '"expected [on-window event message]" '"expected [on event message]")))
    (when (== message-type 0)
      (fail a '"a listener needs a message type: give the component #:messages, or add (messages TYPE) to this module before the view"))
    (let* ([event (syntax-e (cadr al))] [m (caddr al)] [filled (event-fill m)]
           [slot (field! b #'ui-listener)] [message (field! b message-type)] [at (marked! b node)])
      (when (and (not window) (symbol? event) (!= (memq event window-events) 0))
        (fail (cadr al) (format "~a is an event of the window, not of an element: write [on-window ~a message]" `(,event ,event))))
      (unless (or (string? event)
                  (and (symbol? event)
                       (or (!= (memq event events) 0) (and window (!= (memq event window-events) 0)))))
        (fail (cadr al) (format "unknown event ~s (to listen for an event that the DOM does not define, write its name as a string: [~a \"~a\" message])"
                                `(,event ,(if window 'on-window 'on) ,event))))
      (set! listening #t)
      (both! b #`(set! (-> bs #,message) #,(if (== filled 0) m (car filled))))
      (mount! b #`(ui-listen #,at #,(literal (if (string? event) event (string->datum (symbol->string event)))) (& (-> bs #,slot))
                             (cast (ptr void) (& (-> bs #,message))) #,(if (== filled 0) #'0 (cdr filled))
                             #,(literal (boolean window))))))

  (define (event-data [x datum]) -> datum
    (let ([l (syntax->list x)])
      (unless (and (!= l 0) (== (length l) 2) (identifier? (car l))) (return 0))
      (let ([form (syntax-e (car l))] [d (syntax-e (cadr l))])
        (cond [(== form 'event-number)
               (unless (string? d) (fail x '"expected (event-number \"name\")"))
               (cons #'f64 #`(ui-event-number #,(cadr l)))]
              [(== form 'event-text)
               (unless (string? d) (fail x '"expected (event-text \"name\")"))
               (cons #'string #`(ui-event-text #,(cadr l)))]
              [(!= form 'event) 0]
              [(== d 'value) (cons #'string #'(ui-event-text "target.value"))]
              [(== d 'key) (cons #'string #'(ui-event-text "key"))]
              [(== d 'shift) (cons #'bool #'(ui-event-truth "shiftKey"))]
              [(== d 'control) (cons #'bool #'(ui-event-truth "ctrlKey"))]
              [(== d 'alt) (cons #'bool #'(ui-event-truth "altKey"))]
              [(== d 'meta) (cons #'bool #'(ui-event-truth "metaKey"))]
              [(== d 'checked) (cons #'bool #'(ui-event-truth "target.checked"))]
              [(== d 'locked) (cons #'bool #'(ui-is node dom-document "pointerLockElement"))]
              [(== d 'time) (cons #'f64 #'(ui-event-number "timeStamp"))]
              [(== d 'x) (cons #'i32 #'(cast i32 (ui-event-number "offsetX")))]
              [(== d 'y) (cons #'i32 #'(cast i32 (ui-event-number "offsetY")))]
              [(== d 'movement-x) (cons #'i32 #'(cast i32 (ui-event-number "movementX")))]
              [(== d 'movement-y) (cons #'i32 #'(cast i32 (ui-event-number "movementY")))]
              [(== d 'button) (cons #'i32 #'(cast i32 (ui-event-number "button")))]
              [(== d 'visible) (cons #'bool #'(ui-event-truth "isIntersecting"))]
              [else (fail x '"unknown event data: expected (event value), (event key), (event shift), (event control), (event alt), (event meta), (event checked), (event locked), (event time), (event x), (event y), (event movement-x), (event movement-y), (event button), (event visible), (event-number \"name\") or (event-text \"name\")")]))))

  (define (event-fill [m datum]) -> datum
    (let ([parts (syntax->list m)] [arguments nil] [variables nil] [sets nil] [i u32 0])
      (when (or (== parts 0) (null? parts) (not (identifier? (car parts)))) (return 0))
      (for-each (lambda ([x datum])
                  (let ([data (event-data x)])
                    (if (== data 0)
                        (begin
                          (set! arguments (cons x arguments))
                          (set! variables (cons #'_ variables)))
                        (let ([field (literal (string->symbol (format-message "d~a" `(,(make-integer i)))))]
                              [d (cadr (syntax->list x))])
                          (set! arguments (cons (syntax-rewrap d (syntax-e #`(let ([z #,(car data)]) z))) arguments))
                          (set! variables (cons field variables))
                          (set! sets (cons #`(let ([z #,(car data) #,(cdr data)]) (set! #,field z)) sets))))
                    (+= i 1)))
                (cdr parts))
      (when (null? sets) (return 0))
      (let ([fill (named (format "fill~a" `(,(make-integer (length fills)))))]
            [others (if (one-case-message-type?) nil `(,#'[_ (begin)]))])
        (set! fills
              (cons #`(define (#,fill [at (ptr void)] [node u32])
                        (match (cast (ptr #,message-type) at)
                          [(#,(car parts) #,@(reverse variables)) #,@(reverse sets)]
                          #,@others))
                    fills))
        (cons (syntax-rewrap m (cons (car parts) (reverse arguments))) fill))))

  (define (one-case-message-type?) -> bool
    (let ([info (type-info message-type)]) (and (pair? info) (== (car info) 'variant) (== (length (caddr info)) 1))))

  (define (if! [b (ptr block)] [f datum] [l datum])
    (unless (or (== (length l) 3) (== (length l) 4)) (fail f '"expected (if c child) or (if c child child)"))
    (branches! b (cadr l) (cons (caddr l) nil) (if (== (length l) 4) (cons (cadddr l) nil) 0)))

  (define (when! [b (ptr block)] [f datum] [l datum])
    (unless (>= (length l) 3) (fail f '"expected (when c child ...)"))
    (branches! b (cadr l) (cddr l) 0))

  (define (branches! [b (ptr block)] [c datum] [then datum] [other datum])
    (html-comment! (html-of b) "a")
    (let* ([anchor (node! b)] [which (field! b #'i32)] [state (field! b #'(ptr void))]
           [one (new-block #f)] [two (ptr block) (if (== other 0) 0 (new-block #f))])
      (compile-children! one then)
      (finish! one)
      (when (!= two 0)
        (compile-children! two other)
        (finish! two))
      (mount! b #`(set! (-> bs #,which) 0))
      (mount! b #`(set! (-> bs #,state) 0))
      (both! b #`(let ([now (if #,c 1 #,(number (if (== two 0) 0 2)))])
                   (if (== now (-> bs #,which))
                       (case now
                         [(1) (let ([bs (cast (ptr #,(-> one state)) (-> bs #,state))]) #,@(statements (-> one update)))]
                         #,@(if (== two 0)
                                nil
                                `(,#`[(2) (let ([bs (cast (ptr #,(-> two state)) (-> bs #,state))]) #,@(statements (-> two update)))])))
                       (begin
                         #,(branches-unmount one two which state #'#t)
                         (set! (-> bs #,which) now)
                         (case now
                           [(1)
                            (set! (-> bs #,state) (malloc (sizeof #,(-> one state))))
                            (let ([bs (cast (ptr #,(-> one state)) (-> bs #,state))] [parent 0] [before #,anchor])
                              #,@(mount-code one))]
                           #,@(if (== two 0)
                                  nil
                                  `(,#`[(2)
                                        (set! (-> bs #,state) (malloc (sizeof #,(-> two state))))
                                        (let ([bs (cast (ptr #,(-> two state)) (-> bs #,state))] [parent 0] [before #,anchor])
                                          #,@(mount-code two))]))
                           [else (set! (-> bs #,state) 0)])))))
      (unmount! b (branches-unmount one two which state #'#f))))

  (define (branches-unmount [one (ptr block)] [two (ptr block)] [which datum] [state datum] [detach datum]) -> datum
    #`(begin
        (case (-> bs #,which)
          [(1) (#,(-> one unmounter) (cast (ptr #,(-> one state)) (-> bs #,state)) #,detach)]
          #,@(if (== two 0) nil `(,#`[(2) (#,(-> two unmounter) (cast (ptr #,(-> two state)) (-> bs #,state)) #,detach)])))
        (free (-> bs #,state))))

  (define (each! [b (ptr block)] [f datum] [l datum])
    (let ([binding (if (>= (length l) 5) (syntax->list (cadr l)) 0)])
      (unless (and (!= binding 0) (== (length binding) 3) (identifier? (car binding)) (== (syntax-e (caddr l)) '#:key))
        (fail f '"expected (each [x items n] #:key k child ...)"))
      (when in-rows
        (fail f '"an each cannot be written directly inside another each: move the inner each into a view of its own, and use that view here"))
      (html-comment! (html-of b) "a")
      (let* ([anchor (node! b)] [rows (field! b #'ui-rows)] [x (car binding)] [key (cadddr l)]
             [children (cddddr l)] [only (if (null? (cdr children)) (syntax->list (car children)) 0)]
             [v (if (and (!= only 0) (pair? only) (identifier? (car only))) (view-of (car only)) 0)]
             [state datum 0] [mount datum 0] [update datum 0] [unmount datum 0])
        (if (!= v 0)
            (let ([names (view-names v)])
              (own! (car only) v)
              (check-arguments! (car children) v (cdr only))
              (set! state (car names))
              (set! mount #`(#,(cadr names) bs parent before #,@(cdr only)))
              (set! update #`(#,(caddr names) bs #,@(cdr only)))
              (set! unmount (cadddr names)))
            (let ([row (new-block #f)])
              (set! in-rows #t)
              (compile-children! row children)
              (set! in-rows #f)
              (finish! row)
              (set! state (-> row state))
              (set! mount #`(begin #,@(mount-code row)))
              (set! update #`(begin #,@(statements (-> row update))))
              (set! unmount (-> row unmounter))))
        (mount! b #`(set! (-> bs #,rows items) 0))
        (mount! b #`(set! (-> bs #,rows count) 0))
        (both! b #`(let ([items #,(cadr binding)] [anchor #,anchor] [rows (& (-> bs #,rows))])
                     (ui-each! rows 0 anchor #,(caddr binding) (sizeof #,state)
                               (lambda ([i u32]) -> u64 (let ([#,x (+ items i)]) (let ([key u64 #,key]) key)))
                               (lambda ([i u32] [row (ptr void)] [parent u32] [before u32])
                                 (let ([#,x (+ items i)] [bs (cast (ptr #,state) row)]) #,mount))
                               (lambda ([i u32] [row (ptr void)])
                                 (let ([#,x (+ items i)] [bs (cast (ptr #,state) row)]) #,update))
                               (lambda ([row (ptr void)] [detach bool]) (#,unmount (cast (ptr #,state) row) detach)))))
        (unmount! b #`(ui-each-clear! (& (-> bs #,rows)) #f
                                      (lambda ([row (ptr void)] [detach bool]) (#,unmount (cast (ptr #,state) row) detach)))))))

  (define (call! [b (ptr block)] [f datum] [l datum] [v datum])
    (check-arguments! f v (cdr l))
    (let ([sent (view-messages v)])
      (unless (or (== sent 0) (and (!= message-type 0) (same-type? sent message-type)))
        (fail f (format "the view ~a sends messages of the type ~a, but ~a"
                        `(,(syntax-e (car l)) ,(type-name sent)
                          ,(if (== message-type 0)
                               '"this view has no message type"
                               (format "this view's messages are ~a" `(,(type-name message-type)))))))))
    (html-comment! (html-of b) "a")
    (let ([anchor (node! b)] [names (view-names v)])
      (let ([state (field! b (car names))])
        (mount! b #`(#,(cadr names) (& (-> bs #,state)) 0 #,anchor #,@(cdr l)))
        (update! b #`(#,(caddr names) (& (-> bs #,state)) #,@(cdr l)))
        (unmount! b #`(#,(cadddr names) (& (-> bs #,state)) #f)))))

  ;; ---- using a component ----

  (define (component-text [l datum]) -> datum (syntax-e (car l)))

  (define (attribute-named [attributes datum] [name datum]) -> datum
    (let ([found datum 0])
      (while (pair? attributes)
        (when (== (syntax-e (car (car attributes))) name) (set! found (car attributes)))
        (set! attributes (cdr attributes)))
      found))

  ;; (c ([parameter value] ... [on event message] ...))
  (define (component-attributes [f datum] [l datum] [c datum]) -> datum
    (let ([params (syntax->list (caddr c))] [given nil] [listeners nil]
          [attributes (cond [(null? (cdr l)) nil]
                            [(and (null? (cddr l)) (!= (syntax->list (cadr l)) 0)) (syntax->list (cadr l))]
                            [else (fail f '"expected (component ([parameter value] ... [on event message] ...))")])])
      (for-each (lambda ([a datum])
                  (let ([al (syntax->list a)])
                    (unless (and (!= al 0) (pair? al) (identifier? (car al)))
                      (fail a '"expected [parameter value] or [on event message]"))
                    (cond [(== (syntax-e (car al)) 'on)
                           (unless (and (== (length al) 3) (identifier? (cadr al)) (identifier? (caddr al)))
                             (fail a '"expected [on event message], with the names of a case of the component's events and a case of this view's messages"))
                           (set! listeners (cons al listeners))]
                          [(!= (attribute-named given (syntax-e (car al))) 0)
                           (fail (car al) (format "the parameter ~a is given twice" `(,(syntax-e (car al)))))]
                          [(== (attribute-named (for/list ([p params]) (syntax->list p)) (syntax-e (car al))) 0)
                           (fail (car al) (format "the component ~a has no parameter ~a" `(,(component-text l) ,(syntax-e (car al)))))]
                          [(!= (length al) 2) (fail a '"expected [parameter value]")]
                          [else (set! given (cons al given))])))
                attributes)
      (cons (for/list ([p params])
              (let ([found (attribute-named given (syntax-e (car (syntax->list p))))])
                (when (== found 0)
                  (fail f (format "the component ~a needs the parameter ~a" `(,(component-text l) ,(syntax-e (car (syntax->list p)))))))
                (cadr found)))
            (reverse listeners))))

  (define (parent-listener! [l datum] [c datum] [al datum]) -> datum
    (let* ([events (cadddr c)] [event (cadr al)] [message (caddr al)]
           [fn (named (format "heard~a" `(,(make-integer (length fills)))))])
      (unless (identifier? events) (fail event (format "the component ~a raises no events" `(,(component-text l)))))
      (when (== message-type 0)
        (fail message '"a listener needs a message type: give the component #:messages, or add (messages TYPE) to this module before the view"))
      (let ([event-case (variant-case events event)] [message-case (variant-case message-type message)])
        (when (== event-case 0)
          (fail event (format "~a is not an event of the component ~a, whose events are ~a"
                              `(,(syntax-e event) ,(component-text l) ,(case-names events)))))
        (when (== message-case 0)
          (fail message (format "~a is not a message of this view, whose messages are ~a" `(,(syntax-e message) ,(case-names message-type)))))
        (let ([carried (shape (for/list ([x (cdr event-case)]) (cdr x)))] [taken (shape (for/list ([x (cdr message-case)]) (cdr x)))])
          (unless (or (null? taken) (equal? carried taken))
            (fail message (format "the message ~a takes ~a, but the event ~a carries ~a"
                                  `(,(syntax-e message) ,taken ,(syntax-e event) ,carried)))))
        (let* ([vars (for/list ([x (cdr event-case)]) (literal (string->symbol (format-message "v~a" `(,(syntax-e (car x)))))))]
               [pattern (if (null? vars) (car event-case) #`(#,(car event-case) #,@vars))]
               [made (if (null? (cdr message-case)) (car message-case) #`(#,(car message-case) #,@vars))])
          (set! fills
                (cons #`(define (#,fn [parent (ptr void)] [e (ptr void)])
                          (match (cast (ptr #,events) e)
                            [#,pattern
                             (let ([m #,message-type #,made]) (ui-deliver (cast (ptr ui-instance) parent) (cast (ptr void) (& m))))]
                            #,@(if (single-case? events) nil `(,#'[_ (begin)]))))
                      fills))
          fn))))

  (define (key-of [l datum]) -> datum
    (while (and (pair? l) (pair? (cdr l)) (not (null? (cddr l)))) (set! l (cdr l)))
    (if (and (pair? l) (pair? (cdr l)) (== (syntax-e (car l)) '#:key)) (cadr l) 0))

  (define (without-key [l datum]) -> datum
    (if (or (null? l) (and (== (syntax-e (car l)) '#:key) (pair? (cdr l)) (null? (cddr l))))
        nil
        (cons (car l) (without-key (cdr l)))))

  ;; (c ([parameter value] ...) #:key k) mounts the component again, with a new state, when the u64 k changes.
  (define (component-call! [b (ptr block)] [f datum] [l datum] [c datum])
    (let* ([key (key-of l)] [names (syntax->list (cadr c))] [parsed (component-attributes f (without-key l) c)]
           [values (car parsed)] [listeners (cdr parsed)] [n (length listeners)])
      (html-comment! (html-of b) "a")
      (let* ([anchor (node! b)] [instance (field! b (car names))]
             [heard datum (if (== n 0) 0 (field! b #`(array ui-parent-listener #,(number n))))]
             [hears nil] [k u32 0])
        (for-each (lambda ([al datum])
                    (set! hears (cons #`(ui-hear! (cast (ptr ui-parent-listener) (& (-> bs #,heard))) #,(number k)
                                                  #,(parent-listener! l c al))
                                      hears))
                    (+= k 1))
                  listeners)
        (let ([mounting #`(begin
                            #,@(reverse hears)
                            (#,(cadr names) (& (-> bs #,instance)) 0 #,anchor
                                            #,(if (== n 0) #'0 #`(cast (ptr ui-parent-listener) (& (-> bs #,heard))))
                                            #,(number n) #,@values))]
              [updating #`(#,(caddr names) (& (-> bs #,instance)) #,@values)])
          (if (== key 0)
              (begin
                (mount! b mounting)
                (update! b updating))
              (let ([slot (field! b #'u64)])
                (mount! b #`(set! (-> bs #,slot) #,key))
                (mount! b mounting)
                (update! b #`(let ([key u64 #,key])
                               (if (== key (-> bs #,slot))
                                   #,updating
                                   (begin
                                     (set! (-> bs #,slot) key)
                                     (#,(cadddr names) (& (-> bs #,instance)) #t)
                                     #,mounting)))))))
        (unmount! b #`(#,(cadddr names) (& (-> bs #,instance)) #f)))))

  (define (cddddr [l datum]) -> datum (cdr (cdddr l)))

  ;; ---- the macros themselves ----

  (define (message-type-name [s datum]) -> datum (datum->syntax s 'ui-message-type s))

  (define (messages-form [s datum]) -> datum
    (syntax-match s
      [(_ (? identifier? m)) #`(define-syntax #,(message-type-name s) (quote-syntax #,m))]))

  ;; (view (v parameter ...) option ... child ...). The option #:messages TYPE gives the view's listeners a message type
  ;; other than the module's, and #:messages #f gives them none. #:style css is a stylesheet, added to the document when
  ;; the view is first mounted.
  (define (view-form [s datum]) -> datum
    (syntax-match s
      [(_ ((? identifier? v) parameter ...) child ...)
       (let* ([declared (message-type-name s)] [options nil] [children child])
         (while (and (pair? children) (keyword? (syntax-e (car children))))
           (unless (!= (memq (syntax-e (car children)) '(#:messages #:style)) 0)
             (fail (car children) '"the options are #:messages TYPE and #:style css"))
           (unless (pair? (cdr children)) (fail (car children) '"expected a value after the option"))
           (set! options (cons (cons (syntax-e (car children)) (cadr children)) options))
           (set! children (cddr children)))
         (set! view-name v)
         (set! message-type
               (cond [(!= (assq '#:messages options) 0)
                      (if (== (syntax-e (option-of options '#:messages)) '#f) 0 (option-of options '#:messages))]
                     [(== (identifier-binding-kind declared) 'compile-time-value) (syntax-local-value declared)]
                     [else 0]))
         (set! listening #f)
         (set! blocks 0)
         (set! fields 0)
         (set! fills nil)
         (set! definitions nil)
         (set! in-rows #f)
         (let ([b (new-block #t)] [style (option-of options '#:style)] [styled (named '"styled")])
           (compile-children! b children)
           (finish! b)
           #`(begin
               #,@(reverse definitions)
               #,@(if (== style 0) nil `(,#`(define #,styled bool #f)))
               (define (#,(named '"mount") [bs (ptr #,(-> b state))] [parent u32] [before u32] #,@parameter)
                 #,@(if (== style 0) nil `(,#`(unless #,styled (set! #,styled #t) (dom-stylesheet! #,style))))
                 #,@(mount-code b))
               (define (#,(named '"update") [bs (ptr #,(-> b state))] #,@parameter)
                 #,@(statements (-> b update)))
               #,@(reverse fills)
               (define-syntax #,v
                 (view-value (quote-syntax ((#,(-> b state) #,(named '"mount") #,(named '"update") #,(-> b unmounter))
                                            (#,@parameter)
                                            #,(if listening message-type #'#f)
                                            ui-root-with!)))))))]))

  (define (view-value [parts datum]) -> datum
    (let ([l (syntax->list parts)]) `(ui-view ,(car l) ,(cadr l) ,(caddr l) ,(cadddr l))))

  ;; ---- components ----

  (define (component-name [base datum] [what datum]) -> datum
    (datum->syntax base (string->symbol (format-message "~a.~a" `(,(syntax-e base) ,what))) base))

  (define (option-of [options datum] [word datum]) -> datum
    (let ([found (assq word options)]) (if (== found 0) 0 (cdr found))))

  (define (variant! [who datum] [t datum] [what datum])
    (unless (and (identifier? t) (let ([info (type-info t)]) (and (pair? info) (== (car info) 'variant))))
      (raise-syntax-error who (datum->string (format "the ~a must be a variant type" `(,what))) t)))

  ;; (component (c parameter ...) option ... child ...), with the options #:state [s TYPE], #:messages TYPE, #:update f,
  ;; #:init f, #:changed f, #:free f, #:events TYPE, #:trapped f and #:style css. Its instances each have a state, which
  ;; the children see as s. #:init runs when an instance is mounted. #:changed runs before a drawing whose parameters
  ;; differ, bit for bit, from those of the drawing before. Both take the state and the parameters. The stylesheet is
  ;; added to the document when the first instance is mounted.
  (define (component-form [s datum]) -> datum
    (syntax-match s
      [(_ ((? identifier? name) parameter ...) rest ...)
       (let ([options nil] [children rest])
         (while (and (pair? children) (keyword? (syntax-e (car children))))
           (let ([word (syntax-e (car children))])
             (unless (!= (memq word '(#:state #:messages #:update #:init #:changed #:free #:events #:trapped #:style)) 0)
               (raise-syntax-error 'component "the options are #:state, #:messages, #:update, #:init, #:changed, #:free, #:events, #:trapped and #:style" (car children)))
             (unless (pair? (cdr children)) (raise-syntax-error 'component "expected a value after the option" (car children)))
             (unless (== (assq word options) 0) (raise-syntax-error 'component "this option is given twice" (car children)))
             (set! options (cons (cons word (cadr children)) options))
             (set! children (cddr children))))
         (let* ([state (option-of options '#:state)] [state-l (if (== state 0) 0 (syntax->list state))]
                [messages (option-of options '#:messages)] [update (option-of options '#:update)]
                [init (option-of options '#:init)] [changed (option-of options '#:changed)] [free (option-of options '#:free)]
                [events (option-of options '#:events)] [trapped (option-of options '#:trapped)]
                [style (option-of options '#:style)])
           (unless (and (!= state-l 0) (== (length state-l) 2) (identifier? (car state-l)))
             (raise-syntax-error 'component "a component needs #:state [name TYPE]" (if (== state 0) s state)))
           (when (and (== messages 0) (!= update 0)) (raise-syntax-error 'component "#:update needs #:messages" update))
           (when (and (!= messages 0) (== update 0)) (raise-syntax-error 'component "#:messages needs #:update" messages))
           (when (and (!= changed 0) (null? parameter)) (raise-syntax-error 'component "#:changed needs parameters" changed))
           (unless (== messages 0) (variant! 'component messages '"messages"))
           (unless (== events 0) (variant! 'component events '"events"))
           (let* ([s-name (car state-l)] [t (cadr state-l)] [view (component-name name '"view")]
                  [instance (component-name name '"instance")] [mount (component-name name '"mount")]
                  [update-fn (component-name name '"update")] [unmount (component-name name '"unmount")]
                  [adapter (component-name name '"message")] [trap (component-name name '"trap")]
                  [names (for/list ([p parameter]) (car (syntax->list p)))]
                  [types (for/list ([p parameter]) (cadr (syntax->list p)))]
                  [lasts (if (== changed 0) nil (for/list ([n names]) (component-name n '"last")))])
             #`(begin
                 (view (#,view [#,s-name (ptr #,t)] #,@parameter) #:messages #,(if (== messages 0) #'#f messages)
                       #,@(if (== style 0) nil `(,#'#:style ,style))
                       #,@children)
                 (struct #,instance [head ui-instance] [state #,t] [view #,(component-name view '"state")]
                         #,@(for/list ([l lasts] [ty types]) #`[#,l #,ty]))
                 #,@(if (== messages 0)
                        nil
                        `(,#`(define (#,adapter [state (ptr void)] [message (ptr void)])
                               (#,update (cast (ptr #,t) state) (cast (ptr #,messages) message)))))
                 #,@(if (== trapped 0)
                        nil
                        `(,#`(define (#,trap [state (ptr void)] [why string]) (#,trapped (cast (ptr #,t) state) why))))
                 (define (#,mount [i (ptr #,instance)] [parent u32] [before u32] [heard (ptr ui-parent-listener)]
                                  [heard-count u32] #,@parameter)
                   (ui-instance-start! (& (-> i head)) (cast (ptr void) (& (-> i state)))
                                       #,(if (== messages 0) #'0 adapter) #,(if (== trapped 0) #'0 trap)
                                       #,(type-text messages) #,(type-text events) heard heard-count)
                   (memset (& (-> i state)) 0 (sizeof #,t))
                   #,@(for/list ([l lasts] [n names]) #`(set! (-> i #,l) #,n))
                   (let ([outer (ui-enter! (& (-> i head)))])
                     #,@(if (== init 0) nil `(,#`(#,init (& (-> i state)) #,@names)))
                     (#,(component-name view '"mount") (& (-> i view)) parent before (& (-> i state)) #,@names)
                     (ui-leave! outer)))
                 (define (#,update-fn [i (ptr #,instance)] #,@parameter)
                   (let ([outer (ui-enter! (& (-> i head)))])
                     #,@(if (== changed 0)
                            nil
                            `(,#`(when (or #,@(for/list ([l lasts] [n names] [ty types])
                                                 #`(let ([now #,ty #,n])
                                                     (!= (memcmp (cast (ptr u8) (& (-> i #,l))) (cast (ptr u8) (& now))
                                                                 (sizeof #,ty))
                                                         0))))
                                   #,@(for/list ([l lasts] [n names]) #`(set! (-> i #,l) #,n))
                                   (#,changed (& (-> i state)) #,@names))))
                     (#,(component-name view '"update") (& (-> i view)) (& (-> i state)) #,@names)
                     (ui-leave! outer)))
                 (define (#,unmount [i (ptr #,instance)] [detach bool])
                   (let ([outer (ui-enter! (& (-> i head)))])
                     (#,(component-name view '"unmount") (& (-> i view)) detach)
                     #,@(if (== free 0) nil `(,#`(#,free (& (-> i state)))))
                     (ui-instance-end! (& (-> i head)))
                     (ui-leave! outer)))
                 (define-syntax #,name
                   (component-value (quote-syntax ((#,instance #,mount #,update-fn #,unmount) (#,@parameter)
                                                   #,(if (== events 0) #'#f events)
                                                   #,(if (== messages 0) #'#f messages)
                                                   ui-root-with!))))))))]))

  (define (component-value [parts datum]) -> datum
    (let ([l (syntax->list parts)]) `(ui-component ,(car l) ,(cadr l) ,(caddr l) ,(cadddr l) ,(car (cddddr l)))))

  (define (constructed-type [who datum] [e datum]) -> datum
    (let* ([l (syntax->list e)] [head (if (and (!= l 0) (pair? l)) (car l) e)]
           [v (if (and (identifier? head) (== (identifier-binding-kind head) 'macro)) (syntax-local-value head) 0)])
      (syntax-match v
        [('#%form _ ('#%substrate-construct t _ _)) t]
        [_ (raise-syntax-error who "expected a case of a variant: (case value ...), or case alone" e)])))

  (define (emit-form [s datum]) -> datum
    (syntax-match s
      [(_ e) (let ([t (constructed-type 'emit! e)])
               #`(let ([event #,t #,e]) (ui-emit #,(type-text t) (cast (ptr void) (& event)))))]
      [_ (raise-syntax-error 'emit! "expected (emit! (event value ...))" s)]))

  (define (send-form [s datum]) -> datum
    (syntax-match s
      [(_ e) (let ([t (constructed-type 'send! e)])
               #`(let ([message #,t #,e]) (ui-send #,(type-text t) (cast (ptr void) (& message)))))]
      [_ (raise-syntax-error 'send! "expected (send! (message value ...))" s)]))

  ;; (ui-root mount node (c ([parameter value] ...))) defines mount. mount puts an instance of c in the node and makes
  ;; it a root, and each drawing updates the roots. A root can also be a view, (v e ...), when it has no listeners.
  (define (root-form [s datum]) -> datum
    (syntax-match s
      [(_ (? identifier? mount) node call)
       (let* ([l (syntax->list call)] [head (if (and (!= l 0) (pair? l) (identifier? (car l))) (car l) 0)]
              [v (if (== head 0) 0 (view-of head))] [c (if (or (== head 0) (!= v 0)) 0 (component-of head))])
         (cond [(!= v 0)
                (let ([names (view-names v)])
                  (older! head v)
                  (check-arguments! call v (cdr l))
                  (unless (== (view-messages v) 0)
                    (raise-syntax-error 'ui-root "a view put in an element has no component to take its messages" call))
                  #`(begin
                      (define state #,(car names))
                      (define (render) (#,(caddr names) (& state) #,@(cdr l)))
                      (define (#,mount)
                        (#,(cadr names) (& state) #,node 0 #,@(cdr l))
                        (#,(copy-root v) render event-texts event-numbers node-is flush))))]
               [(== c 0) (raise-syntax-error 'ui-root "expected a component, (c ([parameter value] ...)), or a view, (v e ...)" call)]
               [else
                (older! head c)
                (let* ([names (syntax->list (cadr c))] [parsed (component-attributes call l c)] [values (car parsed)])
                  (unless (null? (cdr parsed))
                    (raise-syntax-error 'ui-root "a component put in an element has no parent to listen to its events" call))
                  #`(begin
                      (define instance #,(car names))
                      (define (render) (#,(caddr names) (& instance) #,@values))
                      (define (#,mount)
                        (#,(cadr names) (& instance) #,node 0 0 0 #,@values)
                        (#,(copy-root c) render event-texts event-numbers node-is flush))))]))]
      [_ (raise-syntax-error 'ui-root "expected (ui-root mount node (c ([parameter value] ...))) or (ui-root mount node (v e ...))" s)])))

(define-syntax messages messages-form)
(define-syntax view view-form)
(define-syntax component component-form)
(define-syntax emit! emit-form)
(define-syntax send! send-form)
(define-syntax ui-root root-form)
