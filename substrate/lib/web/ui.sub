;; Lifecycle: experimental.
;;
;; A small language for describing web pages, built on the C-like Lisp.
;;
;; A "view" is a template. It looks like the HTML it produces, with holes
;; for the parts that depend on the program's data:
;;
;;   (view (counter [m (ptr model)])
;;     (div ([class "counter"])
;;       (button ([on click decrement]) "-")
;;       (span (int (-> m count)))
;;       (button ([on click increment]) "+")))
;;
;; Views are compiled, not interpreted. For each view, the `view` macro
;; generates two functions at compile time:
;;   - "mount" creates the view's page elements (DOM nodes), once;
;;   - "update" is called whenever the data may have changed. It
;;     recomputes only the holes, compares each with the value it had
;;     last time, and changes the page only where a value differs.
;; The parts of a template that never change cost nothing after the first
;; draw. There is no "virtual DOM" and no comparison of whole trees: the
;; cost of an update depends on the number of holes, not on the size of
;; the page.
;;
;; web.sub combines views with a model and messages into a whole program.
;;
;; ---- Writing views ----
;;
;;   (messages M)
;;       Declares the variant type M as the type of the messages that
;;       this module's event listeners produce. It must come before any
;;       view that has a listener.
;;
;;   (view (v [x T] ...) child ...)
;;       Defines the view v, with parameters x .... The children are its
;;       content.
;;
;; A child is one of:
;;
;;   "some text"            Fixed text.
;;   (tag child ...)        An HTML element, for example (p "hello").
;;   (tag ([name value] ...) child ...)
;;                          An element with attributes (see below).
;;   (text e)               Text that can change. e is an expression that
;;                          gives a C string, (ptr u8).
;;   (int e)                A number that can change, shown in decimal.
;;                          e gives an integer.
;;   (if c child)           Shows the child only while c is true (not 0).
;;   (if c child1 child2)   Shows child1 while c is true, else child2.
;;   (when c child ...)     Shows all the children while c is true.
;;   (each [x items n] #:key k child ...)
;;                          Repeats the children for each element of an
;;                          array. `items` points to the first element and
;;                          `n` is the number of elements. Inside the
;;                          children, `x` points to the current element.
;;                          `k` is an integer that identifies the element,
;;                          for example its id; it must differ between
;;                          elements. When the array changes, an element
;;                          whose key is still present keeps its DOM
;;                          nodes: they are moved, not rebuilt.
;;                          Limitation: an each cannot be written directly
;;                          inside another each. Put the inner each in a
;;                          view of its own and use that view as the
;;                          child.
;;   (v e ...)              Another view, with arguments.
;;
;; An attribute is one of:
;;
;;   [name "text"]          A fixed attribute, such as [class "title"].
;;   [name e]               An attribute that can change. e gives a C
;;                          string, or 0 (a null pointer) to remove the
;;                          attribute.
;;   [name], [name c]       For boolean attributes such as disabled,
;;                          checked and hidden. [disabled] always sets it;
;;                          [disabled c] sets it while c is true.
;;   [name 3], [name e]     For numeric attributes such as colspan, rows
;;                          and tabindex: a constant, or an expression
;;                          that gives an integer.
;;   [on event message]     An event listener. `event` is a DOM event name
;;                          such as click or input. When the event fires,
;;                          the program's update function receives
;;                          `message`, a value of the type declared with
;;                          (messages M).
;;                          A message can carry data from the event: an
;;                          argument written (event d) is filled in when
;;                          the event fires. d is one of:
;;                            value    the element's value, such as the
;;                                     text in a text field: a (ptr u8)
;;                            key      the name of the key pressed, such
;;                                     as "Enter": a (ptr u8)
;;                            shift, control, alt, meta
;;                                     1 if that key was held: an i32
;;                            checked  1 if the element is a ticked
;;                                     checkbox: an i32
;;                            x, y     where the mouse was, in pixels from
;;                                     the element's top left corner: i32
;;                            movement-x, movement-y
;;                                     how far the mouse moved since the
;;                                     last mouse event, in pixels: i32.
;;                                     Meaningful while the pointer is
;;                                     locked (see [pointer-lock e]), when
;;                                     the mouse has no position
;;                            button   which mouse button: 0 the left,
;;                                     1 the middle, 2 the right: an i32
;;                            locked   1 if the pointer is locked: an i32
;;                            time     when the event happened, in
;;                                     milliseconds: an f64
;;                          Example: [on input (text-changed (event value))]
;;   [on-window event message]
;;                          Like `on`, but listens on the browser window
;;                          instead of on the element. Use it for things
;;                          that do not happen to one element: a key
;;                          pressed anywhere on the page
;;                          ([on-window keydown ...]), or the window being
;;                          resized. The listener lasts as long as the
;;                          element it is written on.
;;                          The event name `frame` is special. It sends
;;                          the message once for every frame the browser
;;                          draws, about 60 times a second, which is what
;;                          an animation or a game needs:
;;                          [on-window frame (tick (event time))]
;;   [draw key code]        Only on a canvas element. `code` draws on the
;;                          canvas by calling the functions of canvas.sub.
;;                          It runs when the canvas is created, and again
;;                          each time the integer `key` changes. To redraw
;;                          on every update, use a key that changes on
;;                          every update, such as a frame counter.
;;   [focus e]              Gives the element the keyboard focus each time
;;                          the integer e changes.
;;   [scroll-end e]         Scrolls the element to its bottom each time
;;                          the integer e changes.
;;   [pointer-lock e]       Each time the integer e changes: to 0, releases
;;                          the pointer; to anything else, asks the
;;                          browser to lock it to the element, which
;;                          hides the cursor and reports unlimited mouse
;;                          movement. Browsers only grant this during a
;;                          click or key press, so change e in response
;;                          to one. Escape ends the lock; the window
;;                          event pointerlockchange reports every change,
;;                          with (event locked).
;;   [node place]           Stores the element's node number in `place`,
;;                          a variable or a field of the program's, when
;;                          the element is created. Another host module
;;                          can then be given the element: the "gpu"
;;                          module draws on a canvas named this way
;;                          (gpu.sub). The number is only good while the
;;                          element is on the page.
;;
;; e, c, k and message are ordinary C-like Lisp expressions. They can use
;; the view's parameters and, inside an each, its x.
;;
;; What is checked at compile time: the macro knows the names of HTML's
;; elements, each element's attributes, and the DOM's events, and reports
;; a misspelt name as an error at the word. Expressions are type-checked,
;; and errors point at the expression. To use something the macro does
;; not know:
;;   - an element whose name contains a hyphen is a custom element, such
;;     as (my-widget ...), and may have any attributes;
;;   - attributes named data-... or aria-... are allowed on any element;
;;   - an attribute or event name written as a string is not checked:
;;     ["my-attribute" e], [on "my-event" m].
;; SVG and MathML are not supported.
;;
;; ---- What `view` generates ----
;;
;; For a view v, the macro defines:
;;
;;   v.state   A struct type: the memory that one instance of the view
;;             needs (the last value of each hole, and node numbers).
;;   (v.mount st parent before x ...)
;;             Creates an instance. st points to a v.state that the caller
;;             provides. The instance's nodes are inserted into the node
;;             `parent`, before the node `before` (or at the end, if
;;             `before` is 0).
;;   (v.update st x ...)
;;             Brings the instance up to date with the current x ....
;;   (v.unmount st detach)
;;             Destroys the instance. With detach = 1 its nodes are also
;;             removed from the page. detach = 0 is used when an enclosing
;;             node is being removed anyway.
;;
;; web.sub's `app` form calls these for the page's top-level view. Tests
;; call them directly.
;;
;; ---- Patches: how the page gets changed ----
;;
;; The generated code never touches the page. It appends "patches", small
;; binary instructions, to a buffer. Later the whole buffer is handed to
;; the host in one call (web.sub's flush!), and the host applies the
;; patches to the DOM (host/web/dom.mjs). This design means one call from
;; wasm to JavaScript per update, however many changes there are. It also
;; means views can be tested without a browser, by printing the patches
;; (trace.sub).
;;
;; The program refers to DOM nodes by number. Node 0 is the page's root
;; element. The program chooses the other numbers.
;;
;; Templates and copies. The constant part of a view (or of the body of an
;; if, when or each) becomes an HTML string at compile time, called a
;; template. The host parses each template once and clones it for every
;; instance; a clone is called a copy. Inside the HTML, the nodes that
;; the program will need to refer to are marked:
;;
;;   <!--t-->   becomes an empty text node: the place of a (text e) or
;;              (int e)
;;   <!--a-->   stays as a comment node, called an anchor. It marks the
;;              place where the nodes of an if, an each or a nested view
;;              are inserted (just before it).
;;   an element with the attribute data-n
;;              an element with changing attributes or listeners. The
;;              attribute is removed.
;;
;; When a copy is made with the number `first`, its marked nodes get the
;; numbers first+1, first+2, ... in document order. `first` itself names
;; the copy as a whole: all of its top-level nodes.
;;
;; A patch is a sequence of 32-bit words: its number, then its operands.
;; A text operand is two words, the address and the length of the bytes
;; in the program's memory.
;;
;;   1 template t html len
;;       Defines template number t from the HTML text.
;;   2 clone t first n parent before
;;       Makes a copy of template t, numbered `first`, with n marked
;;       nodes. Inserts it before the node `before`; or, if `before` is 0,
;;       at the end of the node `parent`.
;;   3 remove first n
;;       Removes copy `first` from the page, and forgets its number and
;;       its n marked nodes' numbers.
;;   4 free first n
;;       Forgets the numbers only. Used when the nodes have already gone,
;;       because a copy that contained them was removed.
;;   5 move first parent before
;;       Moves copy `first` to a new place (given as for clone).
;;   6 text node s len
;;       Sets the text of a text node.
;;   7 attr node name len s len
;;       Sets an attribute of an element.
;;   8 unattr node name len
;;       Removes an attribute.
;;   9 listen node event len m
;;       Adds an event listener to an element. m is a number that the host
;;       passes back to the program's on-event function when the event
;;       fires. (It is the address of the listener's record; see "event
;;       listeners" below.)
;;   10 focus node
;;       Gives the element the keyboard focus.
;;   11 scroll-end node
;;       Scrolls the element to its bottom.
;;   12 listen-window node event len m
;;       Adds an event listener to the browser window. It is removed when
;;       the number `node` is freed. The event "frame" asks for a call on
;;       every animation frame.
;;   13 draw node count
;;       Draws on a canvas element. The next `count` words are drawing
;;       commands, which canvas.sub lists.
;;   14 image id path len
;;       Starts loading an image file, and gives it the number `id`. The
;;       path names one of the program's files (its assets are among
;;       them), or else is taken as a URL. A drawing command can draw the
;;       image once it has loaded.
;;   15 pointer-lock node lock
;;       Asks the browser to lock the pointer to the element if `lock`
;;       is 1, and releases the pointer if it is 0.
(require-unqualified base "../../compiler/base/base.sub")

(provide view messages
         ui-patches ui-patches-done! ui-frame-alloc
         ui-template ui-clone ui-remove ui-move ui-text ui-attr ui-listen
         ui-text-slot! ui-attr-slot! ui-int-set! ui-int-slot! ui-truth-set! ui-truth-slot! ui-number-set! ui-number-slot!
         ui-effect-slot! ui-pointer-lock-slot! ui-listener ui-event-source! ui-event-text ui-event-truth ui-event-number ui-heard
         ui-canvas-begin ui-canvas-end ui-canvas-drawing? ui-image
         ui-row ui-rows ui-each! ui-each-clear!)

(memory from base)
(table from base)

;; ---- Run-time support: writing patches ----
;;
;; The functions from here to the `view` macro are called by the code
;; that the macro generates. Programs do not normally call them.

;; patches        the patches written since the last flush
;; frame          short-lived memory, for text that a patch points to and
;;                that nothing else keeps (for example the digits of a
;;                number). It is all freed once the patches have been
;;                applied.
;; next-id        the next unused node number
;; next-template  the next unused template number
;; drawing        0, or, while a draw patch is open, the offset in the
;;                buffer just past that patch's word count (see
;;                "drawing on a canvas" below)
(define patches buffer)
(define frame arena)
(define next-id u32 1)
(define next-template u32 1)
(define drawing u32 0)

;; Returns the patch buffer, for the code that hands it to the host
;; (flush! in web.sub) or prints it (trace.sub).
(define (ui-patches) -> (ptr buffer) (& patches))

;; Call this once the patches have been applied or printed. It empties
;; the buffer and frees the short-lived memory. It also closes a draw
;; patch that was left open, which happens if the drawing code trapped.
(define (ui-patches-done!)
  (set! (-> patches length) 0)
  (set! drawing 0)
  (arena-free (& frame)))

;; Allocates n bytes of short-lived memory, valid until the next
;; ui-patches-done!.
(define (ui-frame-alloc [n u32]) -> (ptr void) (arena-alloc (& frame) n))

;; Appends n 32-bit words to the patch buffer.
(define (words! [w (ptr u32)] [n u32]) (buffer-add! (& patches) (cast (ptr u8) w) (* 4 n)))

;; Writes a "template" patch for the HTML string and returns the new
;; template's number. The string must stay valid; in generated code it is
;; a constant.
(define (ui-template [html (ptr u8)]) -> u32
  (let ([t next-template])
    (+= next-template 1)
    (words! (array-of u32 1 t (cast u32 html) (strlen html)) 4)
    t))

;; Writes a "clone" patch: a copy of template t, which has n marked nodes,
;; inserted in `parent` before `before`. Returns the copy's number. Its
;; marked nodes have the n numbers that follow it.
(define (ui-clone [t u32] [n u32] [parent u32] [before u32]) -> u32
  (let ([first next-id])
    (+= next-id (+ n 1))
    (words! (array-of u32 2 t first n parent before) 6)
    first))

;; The other patches; the top of the file lists their operands. ui-remove
;; writes "remove" if detach is 1 and "free" if it is 0.
(define (ui-remove [first u32] [n u32] [detach i32]) (words! (array-of u32 (if detach 3 4) first n) 3))
(define (ui-move [first u32] [parent u32] [before u32]) (words! (array-of u32 5 first parent before) 4))
(define (ui-text [node u32] [s (ptr u8)]) (words! (array-of u32 6 node (cast u32 s) (strlen s)) 4))

;; Sets the attribute `name` of `node` to `value`, or removes the
;; attribute if `value` is 0.
(define (ui-attr [node u32] [name (ptr u8)] [value (ptr u8)])
  (if (== value 0)
      (words! (array-of u32 8 node (cast u32 name) (strlen name)) 4)
      (words! (array-of u32 7 node (cast u32 name) (strlen name) (cast u32 value) (strlen value)) 6)))

;; Writes a "listen" patch, or a "listen-window" patch if `window` is 1.
;; `message` is the address of the listener's record (see "event
;; listeners" below).
(define (ui-listen [node u32] [event (ptr u8)] [message (ptr void)] [window i32])
  (words! (array-of u32 (if window 12 9) node (cast u32 event) (strlen event) (cast u32 message)) 5))

;; ---- Run-time support: drawing on a canvas ----
;;
;; A "draw" patch (number 13) carries a list of drawing commands for one
;; canvas. Its layout is: 13, the canvas's node number, the number of
;; words that follow, then the commands. The functions of canvas.sub
;; write the commands; that file lists them.

;; Writes an "image" patch: asks the host to load the image file at
;; `path` under the number `id`. canvas.sub's load-image calls it.
(define (ui-image [id u32] [path (ptr u8)]) (words! (array-of u32 14 id (cast u32 path) (strlen path)) 4))

;; Opens a draw patch for the canvas `node`. Generated code calls it
;; before running the code of a [draw key code] attribute.
(define (ui-canvas-begin [node u32])
  (words! (array-of u32 13 node 0) 3)
  (set! drawing (-> patches length)))

;; Closes the open draw patch: stores how many words of commands were
;; written since ui-canvas-begin.
(define (ui-canvas-end)
  (when (!= drawing 0)
    (let ([count (cast (ptr u32) (+ (-> patches bytes) (- drawing 4)))])
      (set! (@ count) (/ (- (-> patches length) drawing) 4)))
    (set! drawing 0)))

;; Returns 1 while a draw patch is open. canvas.sub's functions write
;; nothing unless it is, because a drawing command outside a draw patch
;; would be read as some other patch.
(define (ui-canvas-drawing?) -> i32 (!= drawing 0))

;; ---- Run-time support: slots ----
;;
;; A "slot" is the remembered value of one hole in a template. It is a
;; field of the view instance's state struct. Every update recomputes the
;; hole's value and compares it with the slot. If they differ, the slot
;; is set to the new value and a patch is written. If they are equal,
;; nothing happens.
;;
;; A text slot holds its own copy of the string, so the program is free
;; to change or free the string it passed in.

;; Returns 1 if two C strings are equal. Either may be 0 (null); null only
;; equals null.
(define (same-text? [a (ptr u8)] [b (ptr u8)]) -> i32
  (if (or (== a 0) (== b 0))
      (== a b)
      (let ([i u32 0])
        (while (and (== (@ a i) (@ b i)) (!= (@ a i) 0)) (+= i 1))
        (== (@ a i) (@ b i)))))

;; Updates the text slot at `cache`. If s differs from the string in the
;; slot, replaces that string with a copy of s and returns 1. Otherwise
;; returns 0.
(define (keep-text! [cache (ptr (ptr u8))] [s (ptr u8)]) -> i32
  (if (same-text? (@ cache) s)
      0
      (begin
        (free (@ cache))
        (set! (@ cache) (if (== s 0)
                            0
                            (let* ([n (+ (strlen s) 1)] [p (cast (ptr u8) (malloc n))])
                              (memcpy p s n)
                              p)))
        1)))

;; A (text e) hole: sets the text of `node` if s has changed.
(define (ui-text-slot! [cache (ptr (ptr u8))] [node u32] [s (ptr u8)])
  (when (keep-text! cache s) (ui-text node (if (== (@ cache) 0) "" (@ cache)))))

;; A text attribute: sets it, or removes it if s is 0, if s has changed.
(define (ui-attr-slot! [cache (ptr (ptr u8))] [node u32] [name (ptr u8)] [s (ptr u8)])
  (when (keep-text! cache s) (ui-attr node name (@ cache))))

;; Returns n as a decimal string, in short-lived memory.
(define (int-text [n i64]) -> (ptr u8)
  (let* ([p (cast (ptr u8) (ui-frame-alloc 24))] [i u32 23] [u u64 (if (< n 0) (- 0 n) n)])
    (set! (@ p 23) 0)
    (while 1
      (-= i 1)
      (set! (@ p i) (+ 48 (cast i32 (% u 10))))
      (set! u (/ u 10))
      (when (== u 0) (break)))
    (when (< n 0)
      (-= i 1)
      (set! (@ p i) 45))
    (+ p i)))

;; An (int e) hole. ui-int-set! is used when mounting and always writes
;; the patch. ui-int-slot! is used when updating and writes it only if n
;; has changed.
(define (ui-int-set! [cache (ptr i64)] [node u32] [n i64])
  (set! (@ cache) n)
  (ui-text node (int-text n)))

(define (ui-int-slot! [cache (ptr i64)] [node u32] [n i64])
  (when (!= (@ cache) n) (ui-int-set! cache node n)))

;; A boolean attribute such as `disabled`: present while `on` is 1, absent
;; while it is 0. As above, the -set! function is for mounting and the
;; -slot! function is for updating.
(define (ui-truth-set! [cache (ptr i32)] [node u32] [name (ptr u8)] [on i32])
  (set! (@ cache) on)
  (when on (ui-attr node name "")))

(define (ui-truth-slot! [cache (ptr i32)] [node u32] [name (ptr u8)] [on i32])
  (when (!= (@ cache) on)
    (set! (@ cache) on)
    (ui-attr node name (if on "" 0))))

;; A numeric attribute such as `colspan`, written in decimal.
(define (ui-number-set! [cache (ptr i64)] [node u32] [name (ptr u8)] [n i64])
  (set! (@ cache) n)
  (ui-attr node name (int-text n)))

(define (ui-number-slot! [cache (ptr i64)] [node u32] [name (ptr u8)] [n i64])
  (when (!= (@ cache) n) (ui-number-set! cache node name n)))

;; [focus e] and [scroll-end e]: writes the patch `op` (10 is focus, 11 is
;; scroll-end) for `node` each time n differs from the slot.
(define (ui-effect-slot! [cache (ptr i64)] [node u32] [n i64] [op u32])
  (when (!= (@ cache) n)
    (set! (@ cache) n)
    (words! (array-of u32 op node) 2)))

;; [pointer-lock e]: each time n differs from the slot, writes the patch
;; that locks the pointer to `node`, or, when n is 0, releases it.
(define (ui-pointer-lock-slot! [cache (ptr i64)] [node u32] [n i64])
  (when (!= (@ cache) n)
    (set! (@ cache) n)
    (words! (array-of u32 15 node (if (!= n 0) 1 0)) 3)))

;; ---- Run-time support: event listeners ----
;;
;; In a template, [on click m] attaches the message m to the click event.
;; A message is data (a value of the module's message type M), not a
;; function, because the C-like Lisp has no closures that can be stored.
;;
;; Each listener has a record in the view instance's state:
;;
;;   offset 0   fill      a function that copies data from the event into
;;                        the message, or 0 if the message uses none
;;   offset 4   unused    padding, so that the message is at offset 8
;;                        whatever its alignment
;;   offset 8   message   the message
;;
;; The "listen" patch gives the host the record's address. When the event
;; fires, the host passes that address to the program's on-event function,
;; which calls ui-heard to get the message.
;;
;; ui-listener is the record's type for a message type M. listener-head is
;; the part that does not depend on M, which is all that ui-heard needs.

(struct #:forall (M) ui-listener [fill (fn ((ptr void)))] [unused u32] [message M])
(struct listener-head [fill (fn ((ptr void)))] [unused u32])

;; Where event data comes from: three function pointers, set with
;; ui-event-source!.
;;   event-text     (which) -> a C string. which = 0: the value of the
;;                  element the event came from. which = 1: the name of
;;                  the key that was pressed.
;;   event-truths   () -> bits: 1 = Shift, 2 = Control, 4 = Alt, 8 = Meta,
;;                  16 = the element is a ticked checkbox, 32 = the
;;                  pointer is locked.
;;   event-numbers  (which) -> a number. which = 0: the time of the event,
;;                  in milliseconds. which = 1 and 2: the x and y position
;;                  of the mouse, relative to the element. which = 3 and
;;                  4: how far the mouse moved. which = 5: the mouse
;;                  button.
;; A page's program sets them to functions that ask the browser (web.sub).
;; A test can set them to functions that return made-up data. While they
;; are not set, text is "", every bit is 0 and every number is 0.
(define event-text (fn (u32) -> (ptr u8)) 0)
(define event-truths (fn () -> u32) 0)
(define event-numbers (fn (u32) -> f64) 0)

(define (ui-event-source! [text (fn (u32) -> (ptr u8))] [truths (fn () -> u32)] [numbers (fn (u32) -> f64)])
  (set! event-text text)
  (set! event-truths truths)
  (set! event-numbers numbers))

;; Generated code calls these three functions to get (event value),
;; (event shift), (event time), and so on.
(define (ui-event-text [which u32]) -> (ptr u8)
  (let ([f event-text])
    (if (== f 0) "" (f which))))

(define (ui-event-truth [bit u32]) -> i32
  (let ([f event-truths])
    (if (== f 0) 0 (!= (bit-and (f) bit) 0))))

(define (ui-event-number [which u32]) -> f64
  (let ([f event-numbers])
    (if (== f 0) 0.0 (f which))))

;; Called when an event fires. `at` is the address of the listener's
;; record. Runs the record's fill function, if it has one, to copy the
;; event's data into the message. Returns the address of the message (a
;; pointer to an M).
(define (ui-heard [at (ptr void)]) -> (ptr void)
  (let ([fill (-> (cast (ptr listener-head) at) fill)] [message (cast (ptr void) (+ (cast (ptr u8) at) 8))])
    (when (!= fill 0) (fill message))
    message))

;; ---- Run-time support: each ----
;;
;; An each keeps one "row" per array element: the element's key, and a
;; pointer to the state of the instance that shows that element. Every
;; instance state begins with the number of its copy, which first-of
;; reads.

(struct ui-row [key u64] [state (ptr void)])
(struct ui-rows [items (ptr ui-row)] [count u32])

(define (first-of [state (ptr void)]) -> u32 (@ (cast (ptr u32) state)))

;; The hash table used below cannot hold the key 0, so each key is first
;; turned into an odd number.
(define (table-key [key u64]) -> u64 (bit-or (<< key 1) 1))

;; Brings the rows of an each up to date with the array as it is now,
;; creating, updating, moving and removing rows as needed. (Other UI
;; libraries call this a keyed list diff.)
;;
;;   b        the rows as the previous update left them
;;   parent, anchor
;;            where the rows are: a new row is inserted before the node
;;            `anchor`
;;   n        the number of elements now
;;   size     the size in bytes of one row's instance state
;;   key-of   (i) -> the key of element i
;;   mount    (i, state, parent, before): creates the instance for
;;            element i
;;   update   (i, state): updates the instance for element i
;;   unmount  (state, detach): destroys an instance
;;
;; The steps:
;;   1. Rows at the start whose keys are unchanged are only updated, and
;;      so are rows at the end. So appending rows, or removing one row,
;;      costs nothing for the rest.
;;   2. For the rows in the middle, old rows are matched to new elements
;;      by key, with a hash table. Old rows whose key is gone are
;;      unmounted.
;;   3. Of the rows that are kept, the longest run that is already in the
;;      right order stays in place (see longest-rising). Only the other
;;      kept rows are moved. Swapping two rows therefore moves two rows,
;;      however many rows lie between them.
;;   4. The middle rows are then placed from last to first: new rows are
;;      mounted, and rows that must move are moved, each just before the
;;      row that follows it.
(define (ui-each! [b (ptr ui-rows)] [parent u32] [anchor u32] [n u32] [size u32]
                  [key-of (closure (u32) -> u64)]
                  [mount (closure (u32 (ptr void) u32 u32))]
                  [update (closure (u32 (ptr void)))]
                  [unmount (closure ((ptr void) i32))])
  (let ([old (-> b items)] [m (-> b count)] [p u32 0] [s u32 0])
    ;; Step 1. p counts the unchanged rows at the start, s those at the end.
    ;; m is the old number of rows.
    (while (and (< p m) (< p n) (== (-> (+ old p) key) (key-of p)))
      (update p (-> (+ old p) state))
      (+= p 1))
    (when (and (== p m) (== p n)) (return))
    (while (and (< s (- m p)) (< s (- n p)) (== (-> (+ old (- m 1 s)) key) (key-of (- n 1 s)))) (+= s 1))
    (let* ([rows (cast (ptr ui-row) (malloc (* (+ n 1) (sizeof ui-row))))]
           [middle (- m p s)] [between (- n p s)]
           [used (cast (ptr u8) (calloc (+ middle 1) 1))]
           ;; For each new element of the middle section: from[j] is the
           ;; position, in the old middle section, of the row it keeps, or
           ;; -1 if it is a new row; stays[j] is 1 if that row does not
           ;; have to move.
           [from (cast (ptr i32) (malloc (* 4 (+ between 1))))]
           [stays (cast (ptr u8) (calloc (+ between 1) 1))]
           [index hash-table])
      ;; Step 2. `index` maps each old middle row's key to its position
      ;; plus 1. `used` marks the old rows that a new element has claimed.
      (memset (& index) 0 (sizeof hash-table))
      (memcpy rows old (* p (sizeof ui-row)))
      (for ([i u32 0]) (< i middle) (+= i 1)
        (hash-set! (& index) (table-key (-> (+ old (+ p i)) key)) (+ i 1)))
      (for ([j u32 0]) (< j between) (+= j 1)
        (let* ([k (key-of (+ p j))] [i (hash-ref (& index) (table-key k))] [r (+ rows (+ p j))])
          (set! (-> r key) k)
          (if (and (!= i 0) (== (-> (+ old (+ p (- i 1))) key) k) (not (@ used (- i 1))))
              (begin
                (set! (@ used (- i 1)) 1)
                (set! (@ from j) (cast i32 (- i 1)))
                (set! (-> r state) (-> (+ old (+ p (- i 1))) state)))
              (begin
                (set! (@ from j) -1)
                (set! (-> r state) 0)))))
      ;; Unmount the old middle rows that no new element claimed.
      (for ([i u32 0]) (< i middle) (+= i 1)
        (unless (@ used i)
          (let ([state (-> (+ old (+ p i)) state)])
            (unmount state 1)
            (free state))))
      ;; The unchanged rows at the end: copy them over and update them.
      (for ([i u32 0]) (< i s) (+= i 1)
        (set! (@ rows (+ (- n s) i)) (@ old (+ (- m s) i)))
        (update (+ (- n s) i) (-> (+ rows (+ (- n s) i)) state)))
      ;; Step 3.
      (longest-rising from between stays)
      ;; Step 4. Place the middle rows from last to first, each just before
      ;; the row after it, or before the anchor if it is the last row.
      (let ([j between])
        (while (> j 0)
          (-= j 1)
          (let* ([at (+ p j)] [r (+ rows at)]
                 [before (if (< (+ at 1) n) (first-of (-> (+ rows (+ at 1)) state)) anchor)])
            (cond [(== (-> r state) 0)
                   (set! (-> r state) (malloc size))
                   (mount at (-> r state) parent before)]
                  [else
                   (update at (-> r state))
                   (unless (@ stays j) (ui-move (first-of (-> r state)) parent before))]))))
      (hash-free! (& index))
      (free used)
      (free from)
      (free stays)
      (free old)
      (set! (-> b items) rows)
      (set! (-> b count) n))))

;; Finds a longest strictly increasing subsequence of the n numbers at
;; xs, ignoring entries that are -1, and sets stays[i] to 1 for each index
;; i in it.
;;
;; In ui-each!, xs[j] is the old position of the row that new element j
;; keeps. Rows whose old positions increase are already in the right
;; order relative to each other, so a longest increasing subsequence is
;; the largest set of rows that can stay where they are.
;;
;; This is the standard O(n log n) algorithm. ends[k] is the index of the
;; smallest number that ends an increasing run of length k+1; each number
;; finds its run by binary search. before[i] is the index that comes
;; before i in its run, so the result can be read back from its last
;; element.
(define (longest-rising [xs (ptr i32)] [n u32] [stays (ptr u8)])
  (let* ([ends (cast (ptr u32) (malloc (* 4 (+ n 1))))] [before (cast (ptr i32) (malloc (* 4 (+ n 1))))] [length u32 0])
    (for ([i u32 0]) (< i n) (+= i 1)
      (when (>= (@ xs i) 0)
        (let ([lo u32 0] [hi length])
          (while (< lo hi)
            (let ([mid (/ (+ lo hi) 2)])
              (if (< (@ xs (@ ends mid)) (@ xs i)) (set! lo (+ mid 1)) (set! hi mid))))
          (set! (@ before i) (if (> lo 0) (cast i32 (@ ends (- lo 1))) -1))
          (set! (@ ends lo) i)
          (when (== lo length) (+= length 1)))))
    (let ([i i32 (if (> length 0) (cast i32 (@ ends (- length 1))) -1)])
      (while (>= i 0)
        (set! (@ stays i) 1)
        (set! i (@ before i))))
    (free ends)
    (free before)))

;; Destroys every row of an each. Used when the each itself is unmounted.
(define (ui-each-clear! [b (ptr ui-rows)] [detach i32] [unmount (closure ((ptr void) i32))])
  (for ([i u32 0]) (< i (-> b count)) (+= i 1)
    (let ([state (-> (+ (-> b items) i) state)])
      (unmount state detach)
      (free state)))
  (free (-> b items))
  (set! (-> b items) 0)
  (set! (-> b count) 0))

;; ---- The `view` macro ----
;;
;; Everything inside begin-for-syntax runs at compile time. It turns a
;; view's template into the definitions described at the top of the file.
;;
;; The macro works on "blocks". A block is a piece of template that is
;; created and destroyed as a unit:
;;   - the body of a view;
;;   - the body of each branch of an if or a when;
;;   - the body of an each, which has one instance per array element.
;; Each block becomes one HTML template and one state struct.
;;
;; The macro walks a block's children once, in order. For each child:
;;   - constant content is appended to the block's HTML string;
;;   - a hole (a part that can change) adds a marked node to the HTML,
;;     one or more fields to the block's state struct, and statements to
;;     the block's mount, update and unmount code.
;;
;; In the generated statements, `bs` ("block state") is a pointer to the
;; block's state. In mount code, `parent` and `before` say where the
;; block's copy goes. A nested block (the body of an if or an each) is
;; compiled in the same way, and its statements are placed inside code
;; that rebinds `bs` to the nested block's state.

(begin-for-syntax
  (require-unqualified base "../../compiler/base/base.sub")
  (require-unqualified kd "../../compiler/kernel.sub")
  (require sm "../../compiler/base/syntax-match.sub" syntax-match _ ... ?)

  ;; A block while it is being compiled.
  ;;   html       its HTML so far
  ;;   nodes      how many marked nodes it has so far
  ;;   fields     the fields of its state struct so far, each [name type]
  ;;   mount, update, unmount
  ;;              its statements so far
  ;;   state      the name of its state struct
  ;;   template   the name of the global variable that holds its template
  ;;              number (0 until the template is first used)
  ;;   unmounter  the name of its unmount function
  ;; The fields and the three statement lists are kept in reverse order,
  ;; newest first.
  (struct block [html buffer] [nodes u32] [fields datum] [mount datum] [update datum] [unmount datum]
          [state datum] [template datum] [unmounter datum])

  ;; The state of the view being compiled. Macros run one at a time, so
  ;; global variables are safe here.
  ;;   view-name     the view's name
  ;;   message-type  the type declared with (messages M), or 0 if none
  ;;   blocks        how many blocks the view has so far (used to name
  ;;                 them)
  ;;   fields        how many state fields so far (used to name them)
  ;;   fills         the "fill" functions generated for listeners whose
  ;;                 messages use event data, newest first
  ;;   definitions   the structs and functions generated for the view's
  ;;                 blocks, newest first
  ;;   in-rows       1 while the body of an each is being compiled
  (define view-name datum 0)
  (define message-type datum 0)
  (define blocks u32 0)
  (define fields u32 0)
  (define fills datum 0)
  (define definitions datum 0)
  (define in-rows i32 0)

  ;; Reports a compile error in a template, located at the syntax `where`.
  (define (fail [where datum] [message datum]) -> datum (raise-syntax-error 'view message where))

  ;; Turns a value into code. `number` does the same for an integer.
  (define (literal [d datum]) -> datum (datum->syntax #'here d 0))
  (define (number [n u32]) -> datum (literal (make-integer n)))

  ;; Makes the name of one of the view's generated definitions: the view's
  ;; name, a dot, and `what`. For the view `row` and "mount" it is
  ;; `row.mount`. The name is created as if it were written where the
  ;; view's name is, so that the user's code can refer to it.
  (define (named [what datum]) -> datum
    (datum->syntax view-name (string->symbol (format '"~a.~a" `(,(syntax-e view-name) ,what))) view-name))

  ;; Starts a new block. `top` is 1 for the view's own body, whose struct
  ;; and unmount function get the public names v.state and v.unmount.
  ;; Nested blocks get numbered names such as v.block2 and v.unmount2.
  (define (new-block [top i32]) -> (ptr block)
    (let ([b (cast (ptr block) (alloc-in (current-arena) (sizeof block)))] [n blocks])
      (+= blocks 1)
      (set! (-> b html) (make-buffer))
      (set! (-> b nodes) 0)
      (set! (-> b fields) nil)
      (set! (-> b mount) nil)
      (set! (-> b update) nil)
      (set! (-> b unmount) nil)
      (set! (-> b state) (named (if top '"state" (format '"block~a" `(,(make-integer n))))))
      (set! (-> b template) (named (format '"template~a" `(,(make-integer n)))))
      (set! (-> b unmounter) (named (if top '"unmount" (format '"unmount~a" `(,(make-integer n))))))
      b))

  ;; ---- Helpers for building a block ----

  ;; Appends a C string to the block's HTML.
  (define (html! [b (ptr block)] [s (ptr u8)]) (buffer-add-string! (& (-> b html)) s))

  ;; Appends n bytes to the block's HTML, escaping the characters that are
  ;; special in HTML: &, < and >, and also " when `value` is 1 (that is,
  ;; inside an attribute's value).
  (define (html-escaped! [b (ptr block)] [p (ptr u8)] [n u32] [value i32])
    (for ([i u32 0]) (< i n) (+= i 1)
      (let ([c (@ p i)])
        (cond [(== c #\&) (html! b "&amp;")]
              [(== c #\<) (html! b "&lt;")]
              [(== c #\>) (html! b "&gt;")]
              [(and value (== c 34)) (html! b "&quot;")]
              [else (buffer-add-byte! (& (-> b html)) c)]))))

  ;; Counts one more marked node in the block. Returns the code that gives
  ;; the node's number at run time: the copy's number plus the node's
  ;; position among the marked nodes.
  (define (node! [b (ptr block)]) -> datum
    (+= (-> b nodes) 1)
    #`(+ (-> bs first) #,(number (-> b nodes))))

  ;; Adds a field of the given type to the block's state struct. Returns
  ;; the field's name (f0, f1, ...).
  (define (field! [b (ptr block)] [type datum]) -> datum
    (let ([f (literal (string->symbol (format '"f~a" `(,(make-integer fields)))))])
      (+= fields 1)
      (set! (-> b fields) (cons #`[#,f #,type] (-> b fields)))
      f))

  ;; These add a statement to the block's mount, update or unmount code.
  ;; both! adds it to mount and to update.
  (define (mount! [b (ptr block)] [code datum]) (set! (-> b mount) (cons code (-> b mount))))
  (define (update! [b (ptr block)] [code datum]) (set! (-> b update) (cons code (-> b update))))
  (define (unmount! [b (ptr block)] [code datum]) (set! (-> b unmount) (cons code (-> b unmount))))
  (define (both! [b (ptr block)] [code datum]) (mount! b code) (update! b code))

  ;; Turns a reversed statement list into a function body: the statements
  ;; in order, or one statement that does nothing if there are none.
  (define (statements [code datum]) -> datum (if (null? code) `(,#'(begin)) (reverse code)))

  ;; Returns the block's complete mount code: define the template if this
  ;; is its first use, clone it, then run the block's mount statements.
  (define (mount-code [b (ptr block)]) -> datum
    (let ([html (literal (bytes->string (-> b html bytes) (-> b html length)))])
      `(,#`(when (== #,(-> b template) 0) (set! #,(-> b template) (ui-template #,html)))
        ,#`(set! (-> bs first) (ui-clone #,(-> b template) #,(number (-> b nodes)) parent before))
        ,@(reverse (-> b mount)))))

  ;; Finishes a block: adds its state struct, its template-number variable
  ;; and its unmount function to the view's definitions.
  (define (finish! [b (ptr block)])
    (set! definitions
          (append `(,#`(define (#,(-> b unmounter) [bs (ptr #,(-> b state))] [detach i32])
                         #,@(reverse (-> b unmount))
                         (ui-remove (-> bs first) #,(number (-> b nodes)) detach))
                    ,#`(define #,(-> b template) u32 0)
                    ,#`(struct #,(-> b state) [first u32] #,@(reverse (-> b fields))))
                  definitions)))

  ;; ---- The HTML vocabulary ----
  ;;
  ;; These lists let the macro catch misspelt element, attribute and event
  ;; names at compile time. They follow the HTML standard. A name that is
  ;; not listed can still be used: see "What is checked at compile time"
  ;; at the top of the file.

  ;; Every HTML element.
  (define elements datum
    '(a abbr address area article aside audio b base bdi bdo blockquote body br button canvas caption cite code col colgroup
      data datalist dd del details dfn dialog div dl dt em embed fieldset figcaption figure footer form h1 h2 h3 h4 h5 h6
      head header hgroup hr html i iframe img input ins kbd label legend li link main map mark menu meta meter nav noscript
      object ol optgroup option output p picture pre progress q rp rt ruby s samp script search section select slot small
      source span strong style sub summary sup table tbody td template textarea tfoot th thead time title tr track u ul var
      video wbr))

  ;; The "void" elements: they have no closing tag and cannot have
  ;; children.
  (define void-elements datum '(area base br col embed hr img input link meta source track wbr))

  ;; The attributes that are allowed on every element.
  (define global-attributes datum
    '(accesskey autocapitalize autocorrect autofocus class contenteditable dir draggable enterkeyhint exportparts hidden id
      inert inputmode is itemid itemprop itemref itemscope itemtype lang nonce part popover role slot spellcheck style
      tabindex title translate writingsuggestions))

  ;; The attributes that belong to particular elements. Each entry is an
  ;; element's name followed by its attributes. `value` is listed for
  ;; textarea and select although HTML has no such attribute for them: the
  ;; host sets the element's value property instead (host/web/dom.mjs).
  (define element-attributes datum
    '((a download href hreflang ping referrerpolicy rel target type)
      (area alt coords download href ping referrerpolicy rel shape target)
      (audio autoplay controls crossorigin loop muted preload src)
      (base href target)
      (blockquote cite)
      (button command commandfor disabled form formaction formenctype formmethod formnovalidate formtarget name popovertarget
              popovertargetaction type value)
      (canvas height width)
      (col span)
      (colgroup span)
      (data value)
      (del cite datetime)
      (details name open)
      (dialog closedby open)
      (embed height src type width)
      (fieldset disabled form name)
      (form accept-charset action autocomplete enctype method name novalidate rel target)
      (iframe allow allowfullscreen height loading name referrerpolicy sandbox src srcdoc width)
      (img alt crossorigin decoding fetchpriority height ismap loading referrerpolicy sizes src srcset usemap width)
      (input accept alpha alt autocomplete checked colorspace dirname disabled form formaction formenctype formmethod
             formnovalidate formtarget height list max maxlength min minlength multiple name pattern placeholder popovertarget
             popovertargetaction readonly required size src step type value width)
      (ins cite datetime)
      (label for)
      (li value)
      (link as blocking color crossorigin disabled fetchpriority href hreflang imagesizes imagesrcset integrity media
            referrerpolicy rel sizes type)
      (map name)
      (meta charset content http-equiv media name)
      (meter high low max min optimum value)
      (object data form height name type width)
      (ol reversed start type)
      (optgroup disabled label)
      (option disabled label selected value)
      (output for form name)
      (progress max value)
      (q cite)
      (script async blocking crossorigin defer fetchpriority integrity nomodule referrerpolicy src type)
      (select autocomplete disabled form multiple name required size value)
      (slot name)
      (source height media sizes src srcset type width)
      (style blocking media)
      (td colspan headers rowspan)
      (template shadowrootclonable shadowrootdelegatesfocus shadowrootmode shadowrootserializable)
      (textarea autocomplete cols dirname disabled form maxlength minlength name placeholder readonly required rows value wrap)
      (th abbr colspan headers rowspan scope)
      (time datetime)
      (track default kind label src srclang)
      (video autoplay controls crossorigin height loop muted playsinline poster preload src width)))

  ;; The boolean attributes (present or absent) and the numeric ones.
  ;; Every other attribute is treated as text.
  (define truth-attributes datum
    '(allowfullscreen async autofocus autoplay checked controls default defer disabled formnovalidate hidden inert ismap
      itemscope loop multiple muted nomodule novalidate open playsinline readonly required reversed selected
      shadowrootclonable shadowrootdelegatesfocus shadowrootserializable))
  (define number-attributes datum '(cols colspan height maxlength minlength rows rowspan size span start tabindex width))

  ;; The DOM's event names.
  (define events datum
    '(abort animationcancel animationend animationiteration animationstart auxclick beforeinput beforetoggle blur cancel
      canplay canplaythrough change click close compositionend compositionstart compositionupdate contextmenu copy cut
      dblclick drag dragend dragenter dragleave dragover dragstart drop durationchange ended error focus focusin focusout
      input invalid keydown keypress keyup load loadeddata loadedmetadata mousedown mouseenter mouseleave mousemove
      mouseout mouseover mouseup paste pause play playing pointercancel pointerdown pointerenter pointerleave pointermove
      pointerout pointerover pointerup progress reset scroll scrollend seeked seeking select submit timeupdate toggle
      touchcancel touchend touchmove touchstart transitioncancel transitionend transitionrun transitionstart volumechange
      wheel))

  ;; Events that only [on-window event message] accepts, in addition to
  ;; the names above. `frame` is not a real DOM event: the host sends it
  ;; once for every animation frame (see the top of the file).
  (define window-events datum '(frame resize hashchange popstate online offline visibilitychange pointerlockchange pointerlockerror))

  ;; Returns 1 if the symbol s starts with the C string `prefix`.
  (define (starts? [s datum] [prefix (ptr u8)]) -> i32
    (let ([n (strlen prefix)])
      (and (>= (symbol-length s) n) (== (memcmp (symbol-bytes s) prefix n) 0))))

  ;; Returns 1 if `tag` is a valid custom-element name: lower-case
  ;; letters, digits, dots, underscores and hyphens, starting with a
  ;; letter, with at least one hyphen.
  (define (own-element? [tag datum]) -> i32
    (let ([p (symbol-bytes tag)] [hyphens 0])
      (for ([i u32 0]) (< i (symbol-length tag)) (+= i 1)
        (let ([c (@ p i)])
          (cond [(== c #\-) (+= hyphens 1)]
                [(and (>= c #\a) (<= c #\z)) (begin)]
                [(and (> i 0) (or (and (>= c #\0) (<= c #\9)) (== c #\.) (== c #\_))) (begin)]
                [else (return 0)])))
      (and (> hyphens 0) (!= (@ p 0) #\-))))

  ;; Returns 1 if the n bytes at p can be written as an attribute name in
  ;; HTML: they are not empty and contain no white space, quotes, >, / or
  ;; =.
  (define (attribute-name? [p (ptr u8)] [n u32]) -> i32
    (for ([i u32 0]) (< i n) (+= i 1)
      (let ([c (@ p i)])
        (when (or (<= c 32) (== c 34) (== c 39) (== c #\>) (== c #\/) (== c #\=) (== c 127)) (return 0))))
    (> n 0))

  ;; Returns 1 if the element `tag` may have the attribute `name`.
  (define (attribute-of? [tag datum] [name datum]) -> i32
    (or (own-element? tag) (starts? name "data-") (starts? name "aria-")
        (!= (memq name global-attributes) 0)
        (let ([own (assq tag element-attributes)]) (and (!= own 0) (!= (memq name (cdr own)) 0)))))

  ;; ---- Compiling a block's children ----

  ;; If the identifier `head` is the name of a view, returns the value the
  ;; name is bound to at compile time: the list (ui-view names
  ;; parameters), where
  ;;   names       is syntax for (state mount update unmount): the names
  ;;               of the view's struct and functions
  ;;   parameters  is syntax for the view's parameters, ([x T] ...)
  ;; Otherwise returns 0.
  (define (view-of [head datum]) -> datum
    (if (== (identifier-binding-kind head) 'compile-time-value)
        (let ([v (syntax-local-value head)])
          (if (and (pair? v) (== (car v) 'ui-view)) v 0))
        0))

  ;; The four names in a view's compile-time value, as a list.
  (define (view-names [v datum]) -> datum (syntax->list (cadr v)))

  ;; Reports an error at the form f, which uses the view v, unless the
  ;; number of arguments matches the view's parameters.
  (define (check-arguments! [f datum] [v datum] [arguments datum])
    (let ([n (length (syntax->list (caddr v)))])
      (unless (== (length arguments) n)
        (fail f (format '"the view ~a takes ~a argument~a, but this passes ~a"
                        `(,(syntax-e (car (syntax->list f))) ,(make-integer n) ,(if (== n 1) '"" '"s")
                          ,(make-integer (length arguments))))))))

  ;; Decides whether x, the form that follows an element's tag, is the
  ;; attribute list ([name value] ...) or the first child. An attribute
  ;; list is a list that does not start with an identifier; a child that
  ;; is a list always starts with one.
  (define (attributes? [x datum]) -> i32
    (let ([l (syntax->list x)])
      (and (!= l 0) (or (null? l) (not (identifier? (car l)))))))

  ;; Compiles each child, in order, into block b.
  (define (compile-children! [b (ptr block)] [children datum])
    (while (pair? children)
      (compile-child! b (car children))
      (set! children (cdr children))))

  ;; Compiles one child form f into block b, according to what it is.
  (define (compile-child! [b (ptr block)] [f datum])
    (let ([e (syntax-e f)] [l (syntax->list f)])
      (cond [(string? e) (html-escaped! b (string-bytes e) (string-length e) 0)]
            [(or (== l 0) (null? l) (not (identifier? (car l))))
             (fail f '"expected a child: text in quotes, an element (tag ...), (text e), (int e), (if c child child), (when c child ...), (each [x items n] #:key k child ...) or a view (v e ...)")]
            [else
             (let ([word (syntax-e (car l))])
               (cond [(== word 'text) (text! b f l)]
                     [(== word 'int) (int! b f l)]
                     [(== word 'if) (if! b f l)]
                     [(== word 'when) (when! b f l)]
                     [(== word 'each) (each! b f l)]
                     [(!= (view-of (car l)) 0) (call! b f l (view-of (car l)))]
                     [else (element! b f l)]))])))

  ;; (text e): an empty text node, marked, and a text slot.
  (define (text! [b (ptr block)] [f datum] [l datum])
    (unless (== (length l) 2) (fail f '"expected (text e)"))
    (html! b "<!--t-->")
    (let ([node (node! b)] [slot (field! b #'(ptr u8))])
      (mount! b #`(set! (-> bs #,slot) 0))
      (both! b #`(ui-text-slot! (& (-> bs #,slot)) #,node #,(cadr l)))
      (unmount! b #`(free (-> bs #,slot)))))

  ;; (int e): the same, with an integer slot.
  (define (int! [b (ptr block)] [f datum] [l datum])
    (unless (== (length l) 2) (fail f '"expected (int e)"))
    (html! b "<!--t-->")
    (let ([node (node! b)] [slot (field! b #'i64)])
      (mount! b #`(ui-int-set! (& (-> bs #,slot)) #,node #,(cadr l)))
      (update! b #`(ui-int-slot! (& (-> bs #,slot)) #,node #,(cadr l)))))

  ;; An element: (tag child ...) or (tag ([name value] ...) child ...).
  ;; Writes the opening tag, the constant attributes, the children and the
  ;; closing tag into the block's HTML. `node` is 0 until the element has
  ;; been marked (see marked!); after that it is the code for the
  ;; element's node number.
  (define (element! [b (ptr block)] [f datum] [l datum])
    (let* ([tag (syntax-e (car l))]
           [given (and (pair? (cdr l)) (attributes? (cadr l)))]
           [attributes (if given (syntax->list (cadr l)) nil)]
           [children (if given (cddr l) (cdr l))]
           [node datum 0])
      (when (or (== tag 'svg) (== tag 'math))
        (fail (car l) (format '"~a is not supported: a view can contain HTML elements only, not SVG or MathML" `(,tag))))
      (unless (or (!= (memq tag elements) 0) (own-element? tag))
        (fail (car l) (format '"unknown element ~a: it is not an HTML element or a view (a custom element's name must be lower-case and contain a hyphen)" `(,tag))))
      (html! b "<")
      (buffer-add! (& (-> b html)) (symbol-bytes tag) (symbol-length tag))
      (while (pair? attributes)
        (let* ([a (car attributes)] [al (syntax->list a)])
          (unless (and (!= al 0) (pair? al) (or (identifier? (car al)) (string? (syntax-e (car al)))))
            (fail a '"expected [name value], [name], [on event message], [draw key code], [node place], [focus e], [scroll-end e] or [pointer-lock e]"))
          (attribute! b tag a al (& node)))
        (set! attributes (cdr attributes)))
      (html! b ">")
      (if (!= (memq tag void-elements) 0)
          (unless (null? children) (fail f (format '"the element ~a cannot have children" `(,tag))))
          (begin
            (compile-children! b children)
            (html! b "</")
            (buffer-add! (& (-> b html)) (symbol-bytes tag) (symbol-length tag))
            (html! b ">")))))

  ;; Marks the element being compiled, the first time it turns out to have
  ;; a changing attribute or a listener: counts it as a marked node and
  ;; adds the data-n attribute to its HTML. Returns the code for its node
  ;; number. An element with nothing that changes is never marked.
  (define (marked! [b (ptr block)] [node (ptr datum)]) -> datum
    (when (== (@ node) 0)
      (set! (@ node) (node! b))
      (html! b " data-n"))
    (@ node))

  ;; Appends a constant attribute to the block's HTML: name="value", or
  ;; only the name if `value` is 0.
  (define (html-attribute! [b (ptr block)] [name datum] [value datum])
    (html! b " ")
    (buffer-add! (& (-> b html)) (symbol-bytes name) (symbol-length name))
    (when (!= value 0)
      (html! b "=\"")
      (html-escaped! b (string-bytes value) (string-length value) 1)
      (html! b "\"")))

  ;; Compiles one attribute form `a` of the element `tag`. `al` is the
  ;; form as a list. A name written as an identifier is checked against
  ;; the HTML vocabulary (`checked` is 1). A name written as a string is
  ;; not.
  (define (attribute! [b (ptr block)] [tag datum] [a datum] [al datum] [node (ptr datum)])
    (let* ([word (syntax-e (car al))] [checked (symbol? word)] [name (if checked word (string->symbol word))])
      (unless (attribute-name? (symbol-bytes name) (symbol-length name))
        (fail (car al) '"invalid attribute name: it must not be empty or contain spaces, quotes, >, / or ="))
      (cond [(and checked (== name 'on)) (listener! b a al node 0)]
            [(and checked (== name 'on-window)) (listener! b a al node 1)]
            [(and checked (== name 'draw)) (draw! b tag a al node)]
            [(and checked (== name 'node))
             (unless (== (length al) 2) (fail a '"expected [node place]"))
             (mount! b #`(set! #,(cadr al) #,(marked! b node)))]
            [(and checked (or (== name 'focus) (== name 'scroll-end)))
             (unless (== (length al) 2) (fail a '"expected [focus e] or [scroll-end e]"))
             (let ([slot (field! b #'i64)] [at (marked! b node)])
               (mount! b #`(set! (-> bs #,slot) #,(cadr al)))
               (update! b #`(ui-effect-slot! (& (-> bs #,slot)) #,at #,(cadr al) #,(number (if (== name 'focus) 10 11)))))]
            [(and checked (== name 'pointer-lock))
             (unless (== (length al) 2) (fail a '"expected [pointer-lock e]"))
             (let ([slot (field! b #'i64)] [at (marked! b node)])
               (mount! b #`(set! (-> bs #,slot) #,(cadr al)))
               (update! b #`(ui-pointer-lock-slot! (& (-> bs #,slot)) #,at #,(cadr al))))]
            [(== name 'data-n) (fail (car al) '"the attribute data-n is reserved: ui.sub uses it to mark elements")]
            [(and checked (not (attribute-of? tag name)))
             (fail (car al) (format '"unknown attribute ~a for the element ~a (to use an attribute that HTML does not define, write its name as a string: [\"~a\" value])" `(,name ,tag ,name)))]
            [(and checked (!= (memq name truth-attributes) 0)) (truth-attribute! b a al name node)]
            [(and checked (!= (memq name number-attributes) 0)) (number-attribute! b a al name node)]
            [else (text-attribute! b tag a al name node)])))

  ;; A text attribute. [name "text"] is constant and goes into the HTML.
  ;; [name e] can change, and gets a slot.
  ;;
  ;; The exception is the value of a textarea or a select. HTML has no
  ;; `value` attribute for them, so even a constant value must be set at
  ;; run time, by the host, as the element's value property.
  (define (text-attribute! [b (ptr block)] [tag datum] [a datum] [al datum] [name datum] [node (ptr datum)])
    (unless (== (length al) 2) (fail a (format '"expected [~a e], where e is a string" `(,name))))
    (let ([v (cadr al)])
      (if (and (string? (syntax-e v)) (not (and (== name 'value) (or (== tag 'textarea) (== tag 'select)))))
          (html-attribute! b name (syntax-e v))
          (let ([slot (field! b #'(ptr u8))] [at (marked! b node)])
            (mount! b #`(set! (-> bs #,slot) 0))
            (both! b #`(ui-attr-slot! (& (-> bs #,slot)) #,at #,(literal (symbol->string name)) #,v))
            (unmount! b #`(free (-> bs #,slot)))))))

  ;; A boolean attribute. [name] is constant. [name e] is present while e
  ;; is true.
  (define (truth-attribute! [b (ptr block)] [a datum] [al datum] [name datum] [node (ptr datum)])
    (cond [(== (length al) 1) (html-attribute! b name 0)]
          [(or (!= (length al) 2) (string? (syntax-e (cadr al))))
           (fail a (format '"~a is a boolean attribute: write [~a], or [~a e] where e is a condition" `(,name ,name ,name)))]
          [else
           (let ([slot (field! b #'i32)] [at (marked! b node)] [text (literal (symbol->string name))])
             (mount! b #`(ui-truth-set! (& (-> bs #,slot)) #,at #,text (if #,(cadr al) 1 0)))
             (update! b #`(ui-truth-slot! (& (-> bs #,slot)) #,at #,text (if #,(cadr al) 1 0))))]))

  ;; A numeric attribute. [name 3] and [name "3"] are constant. [name e]
  ;; follows the integer e.
  (define (number-attribute! [b (ptr block)] [a datum] [al datum] [name datum] [node (ptr datum)])
    (unless (== (length al) 2) (fail a (format '"expected [~a n], where n is an integer" `(,name))))
    (let* ([v (cadr al)] [d (syntax-e v)])
      (cond [(string? d) (html-attribute! b name d)]
            [(integer? d) (html-attribute! b name (format '"~a" `(,d)))]
            [else
             (let ([slot (field! b #'i64)] [at (marked! b node)] [text (literal (symbol->string name))])
               (mount! b #`(ui-number-set! (& (-> bs #,slot)) #,at #,text #,v))
               (update! b #`(ui-number-slot! (& (-> bs #,slot)) #,at #,text #,v)))])))

  ;; [draw key code], on a canvas element: runs `code` when the canvas is
  ;; mounted, and again whenever the integer `key` differs from its value
  ;; at the previous update. `code` is wrapped in ui-canvas-begin and
  ;; ui-canvas-end, so the drawing functions it calls (canvas.sub) write
  ;; their commands into a draw patch for this canvas.
  ;;
  ;; The key is first stored in a variable of type i64, so that a key of
  ;; the wrong type is a compile error that points at it.
  (define (draw! [b (ptr block)] [tag datum] [a datum] [al datum] [node (ptr datum)])
    (unless (== tag 'canvas) (fail (car al) '"draw can only be used on a canvas element"))
    (unless (== (length al) 3) (fail a '"expected [draw key code]"))
    (let ([slot (field! b #'i64)] [at (marked! b node)] [key (cadr al)] [code (caddr al)])
      (mount! b #`(let ([key i64 #,key])
                    (set! (-> bs #,slot) key)
                    (ui-canvas-begin #,at)
                    #,code
                    (ui-canvas-end)))
      (update! b #`(let ([key i64 #,key])
                     (when (!= (-> bs #,slot) key)
                       (set! (-> bs #,slot) key)
                       (ui-canvas-begin #,at)
                       #,code
                       (ui-canvas-end))))))

  ;; An event listener: [on event m], or [on-window event m] if `window`
  ;; is 1. Adds a listener record (see "event listeners" above) to the
  ;; block's state, stores the message in it at mount and again at every
  ;; update, and writes the "listen" or "listen-window" patch at mount. If
  ;; the message uses event data, event-fill generates the record's fill
  ;; function.
  ;;
  ;; A window listener is still attached to an element in the template:
  ;; the element's lifetime is the listener's. When the element's node
  ;; number is freed, the host removes the listener from the window.
  (define (listener! [b (ptr block)] [a datum] [al datum] [node (ptr datum)] [window i32])
    (unless (== (length al) 3) (fail a (if window '"expected [on-window event message]" '"expected [on event message]")))
    (when (== message-type 0) (fail a '"a listener needs a message type: add (messages TYPE) to this module, before the view"))
    (let* ([event (syntax-e (cadr al))] [m (caddr al)] [filled (event-fill m)]
           [slot (field! b #`(ui-listener #,message-type))] [at (marked! b node)])
      (when (and (not window) (symbol? event) (!= (memq event window-events) 0))
        (fail (cadr al) (format '"~a is an event of the window, not of an element: write [on-window ~a message]" `(,event ,event))))
      (unless (or (string? event)
                  (and (symbol? event)
                       (or (!= (memq event events) 0) (and window (!= (memq event window-events) 0)))))
        (fail (cadr al) (format '"unknown event ~s (to listen for an event that the DOM does not define, write its name as a string: [~a \"~a\" message])"
                                `(,event ,(if window 'on-window 'on) ,event))))
      (mount! b #`(set! (-> bs #,slot fill) #,(if (== filled 0) #'0 (cdr filled))))
      (both! b #`(set! (-> bs #,slot message) #,(if (== filled 0) m (car filled))))
      (mount! b #`(ui-listen #,at #,(literal (if (string? event) event (symbol->string event))) (& (-> bs #,slot))
                             #,(number (cast u32 window))))))

  ;; If x is an event-data form, (event d), returns a pair: the type of d,
  ;; and the code that fetches it at run time. Returns 0 if x is anything
  ;; else.
  (define (event-data [x datum]) -> datum
    (let ([l (syntax->list x)])
      (if (and (!= l 0) (== (length l) 2) (identifier? (car l)) (== (syntax-e (car l)) 'event))
          (let ([d (syntax-e (cadr l))])
            (cond [(== d 'value) (cons #'(ptr u8) #'(ui-event-text 0))]
                  [(== d 'key) (cons #'(ptr u8) #'(ui-event-text 1))]
                  [(== d 'shift) (cons #'i32 #'(ui-event-truth 1))]
                  [(== d 'control) (cons #'i32 #'(ui-event-truth 2))]
                  [(== d 'alt) (cons #'i32 #'(ui-event-truth 4))]
                  [(== d 'meta) (cons #'i32 #'(ui-event-truth 8))]
                  [(== d 'checked) (cons #'i32 #'(ui-event-truth 16))]
                  [(== d 'locked) (cons #'i32 #'(ui-event-truth 32))]
                  [(== d 'time) (cons #'f64 #'(ui-event-number 0))]
                  [(== d 'x) (cons #'i32 #'(cast i32 (ui-event-number 1)))]
                  [(== d 'y) (cons #'i32 #'(cast i32 (ui-event-number 2)))]
                  [(== d 'movement-x) (cons #'i32 #'(cast i32 (ui-event-number 3)))]
                  [(== d 'movement-y) (cons #'i32 #'(cast i32 (ui-event-number 4)))]
                  [(== d 'button) (cons #'i32 #'(cast i32 (ui-event-number 5)))]
                  [else (fail x '"unknown event data: expected (event value), (event key), (event shift), (event control), (event alt), (event meta), (event checked), (event locked), (event time), (event x), (event y), (event movement-x), (event movement-y) or (event button)")]))
          0)))

  ;; Handles event data in a listener's message m.
  ;;
  ;; If no argument of m is an (event d) form, returns 0. Otherwise m must
  ;; be a constructor call, (case arg ...), and this returns a pair
  ;; (m2 . fill):
  ;;   m2     m with each (event d) argument replaced by 0. This is what
  ;;          is stored in the listener record.
  ;;   fill   the name of a generated function that, when the event fires,
  ;;          writes each d into its field of the message.
  ;;
  ;; For [on input (typed (-> m id) (event value))] in a view v, the fill
  ;; function is:
  ;;
  ;;   (define (v.fill0 [at (ptr void)])
  ;;     (match (cast (ptr M) at)
  ;;       [(typed _ d1) (let ([value (ptr u8) (ui-event-text 0)]) (set! d1 value))]
  ;;       [_ (begin)]))
  ;;
  ;; The event's data is first put in a variable of the right type, named
  ;; by the user's own word (`value` above). If the message's field has a
  ;; different type, the compiler's type error then points at that word in
  ;; the template.
  ;;
  ;; The last clause, [_ (begin)], is for the other cases of the message
  ;; type. It is left out when the type has no other case, because the
  ;; compiler rejects a clause that can never match.
  (define (event-fill [m datum]) -> datum
    (let ([parts (syntax->list m)] [arguments nil] [variables nil] [sets nil] [i u32 0])
      (when (or (== parts 0) (null? parts) (not (identifier? (car parts)))) (return 0))
      (for-each (lambda ([x datum])
                  (let ([data (event-data x)])
                    (if (== data 0)
                        (begin
                          (set! arguments (cons x arguments))
                          (set! variables (cons #'_ variables)))
                        (let ([field (literal (string->symbol (format '"d~a" `(,(make-integer i)))))]
                              [d (cadr (syntax->list x))])
                          (set! arguments (cons #'0 arguments))
                          (set! variables (cons field variables))
                          (set! sets (cons #`(let ([#,d #,(car data) #,(cdr data)]) (set! #,field #,d)) sets))))
                    (+= i 1)))
                (cdr parts))
      (when (null? sets) (return 0))
      (let ([fill (named (format '"fill~a" `(,(make-integer (length fills)))))]
            [others (if (one-case-message-type?) nil `(,#'[_ (begin)]))])
        (set! fills
              (cons #`(define (#,fill [at (ptr void)])
                        (match (cast (ptr #,message-type) at)
                          [(#,(car parts) #,@(reverse variables)) #,@(reverse sets)]
                          #,@others))
                    fills))
        (cons (syntax-rewrap m (cons (car parts) (reverse arguments))) fill))))

  ;; Returns 1 if the message type is a variant with exactly one case, and
  ;; 0 otherwise. It also returns 0 if the name is not a variant's at all;
  ;; the compiler reports that mistake itself, at the generated match.
  ;;
  ;; A variant's name is bound, at compile time, to the list
  ;; (c-struct name cases variant parameters), where `cases` is syntax for
  ;; the list of its cases (see variant-form in compiler/base/lang.sub).
  (define (one-case-message-type?) -> i32
    (if (== (identifier-binding-kind message-type) 'compile-time-value)
        (let ([v (syntax-local-value message-type)])
          (if (and (pair? v) (== (car v) 'c-struct) (== (length v) 5) (== (cadddr v) 'variant))
              (== (length (syntax->list (caddr v))) 1)
              0))
        0))

  ;; About unmounting nested blocks: when a block is unmounted, the blocks
  ;; nested in it are unmounted with detach = 0. Their nodes are inside
  ;; the outer block's copy and are removed together with it.

  ;; (if c child) and (if c child1 child2).
  (define (if! [b (ptr block)] [f datum] [l datum])
    (unless (or (== (length l) 3) (== (length l) 4)) (fail f '"expected (if c child) or (if c child child)"))
    (branches! b (cadr l) (cons (caddr l) nil) (if (== (length l) 4) (cons (cadddr l) nil) 0)))

  ;; (when c child ...).
  (define (when! [b (ptr block)] [f datum] [l datum])
    (unless (>= (length l) 3) (fail f '"expected (when c child ...)"))
    (branches! b (cadr l) (cddr l) 0))

  ;; Shared by if and when: shows the children `then` while c is true, and
  ;; the children `other` (0 if there are none) while it is false.
  ;;
  ;; Each alternative is a nested block. The outer block gets an anchor,
  ;; which marks where the shown alternative's nodes go, and two fields:
  ;;   which   1 if `then` is shown, 2 if `other` is, 0 if neither
  ;;   state   a pointer to the shown block's state (from malloc), or 0
  ;; On update: if the same alternative is still shown, it is updated;
  ;; otherwise it is unmounted and the other one is mounted.
  (define (branches! [b (ptr block)] [c datum] [then datum] [other datum])
    (html! b "<!--a-->")
    (let* ([anchor (node! b)] [which (field! b #'i32)] [state (field! b #'(ptr void))]
           [one (new-block 0)] [two (ptr block) (if (== other 0) 0 (new-block 0))])
      (compile-children! one then)
      (finish! one)
      (when (!= two 0)
        (compile-children! two other)
        (finish! two))
      (mount! b #`(set! (-> bs #,which) 0))
      (mount! b #`(set! (-> bs #,state) 0))
      (both! b #`(let ([now (if #,c 1 #,(number (if (== two 0) 0 2)))])
                   (if (== now (-> bs #,which))
                       (case now
                         [(1) (let ([bs (cast (ptr #,(-> one state)) (-> bs #,state))]) #,@(statements (-> one update)))]
                         #,@(if (== two 0)
                                nil
                                `(,#`[(2) (let ([bs (cast (ptr #,(-> two state)) (-> bs #,state))]) #,@(statements (-> two update)))])))
                       (begin
                         #,(branches-unmount one two which state #'1)
                         (set! (-> bs #,which) now)
                         (case now
                           [(1)
                            (set! (-> bs #,state) (malloc (sizeof #,(-> one state))))
                            (let ([bs (cast (ptr #,(-> one state)) (-> bs #,state))] [parent 0] [before #,anchor])
                              #,@(mount-code one))]
                           #,@(if (== two 0)
                                  nil
                                  `(,#`[(2)
                                        (set! (-> bs #,state) (malloc (sizeof #,(-> two state))))
                                        (let ([bs (cast (ptr #,(-> two state)) (-> bs #,state))] [parent 0] [before #,anchor])
                                          #,@(mount-code two))]))
                           [else (set! (-> bs #,state) 0)])))))
      (unmount! b (branches-unmount one two which state #'0))))

  ;; Returns the code that unmounts whichever alternative is shown, and
  ;; frees its state.
  (define (branches-unmount [one (ptr block)] [two (ptr block)] [which datum] [state datum] [detach datum]) -> datum
    #`(begin
        (case (-> bs #,which)
          [(1) (#,(-> one unmounter) (cast (ptr #,(-> one state)) (-> bs #,state)) #,detach)]
          #,@(if (== two 0) nil `(,#`[(2) (#,(-> two unmounter) (cast (ptr #,(-> two state)) (-> bs #,state)) #,detach)])))
        (free (-> bs #,state))))

  ;; (each [x items n] #:key k child ...).
  ;;
  ;; The outer block gets an anchor and a ui-rows field. The body is
  ;; compiled as a nested block, with one instance per element. As a
  ;; shortcut, if the body is a single use of a view, (v e ...), that
  ;; view's own state and functions are used, with no block around them.
  ;;
  ;; The generated code calls ui-each! with four closures: one returns
  ;; element i's key, and the others mount, update and unmount a row.
  (define (each! [b (ptr block)] [f datum] [l datum])
    (let ([binding (if (>= (length l) 5) (syntax->list (cadr l)) 0)])
      (unless (and (!= binding 0) (== (length binding) 3) (identifier? (car binding)) (== (syntax-e (caddr l)) '#:key))
        (fail f '"expected (each [x items n] #:key k child ...)"))
      ;; The body of an each is compiled into closures. In the C-like Lisp
      ;; a closure can use the variables of the function it is in, but not
      ;; those of a closure around it. An each directly inside another
      ;; each's body would need the latter, so it is rejected.
      (when in-rows
        (fail f '"an each cannot be written directly inside another each: move the inner each into a view of its own, and use that view here"))
      (html! b "<!--a-->")
      (let* ([anchor (node! b)] [rows (field! b #'ui-rows)] [x (car binding)] [key (cadddr l)]
             [children (cddddr l)] [only (if (null? (cdr children)) (syntax->list (car children)) 0)]
             [v (if (and (!= only 0) (pair? only) (identifier? (car only))) (view-of (car only)) 0)]
             [state datum 0] [mount datum 0] [update datum 0] [unmount datum 0])
        (if (!= v 0)
            (let ([names (view-names v)])
              (check-arguments! (car children) v (cdr only))
              (set! state (car names))
              (set! mount #`(#,(cadr names) bs parent before #,@(cdr only)))
              (set! update #`(#,(caddr names) bs #,@(cdr only)))
              (set! unmount (cadddr names)))
            (let ([row (new-block 0)])
              (set! in-rows 1)
              (compile-children! row children)
              (set! in-rows 0)
              (finish! row)
              (set! state (-> row state))
              (set! mount #`(begin #,@(mount-code row)))
              (set! update #`(begin #,@(statements (-> row update))))
              (set! unmount (-> row unmounter))))
        (mount! b #`(set! (-> bs #,rows items) 0))
        (mount! b #`(set! (-> bs #,rows count) 0))
        ;; The key expression is stored in a variable of type u64, so that
        ;; a key of the wrong type is a compile error that points at it.
        (both! b #`(let ([items #,(cadr binding)] [anchor #,anchor] [rows (& (-> bs #,rows))])
                     (ui-each! rows 0 anchor #,(caddr binding) (sizeof #,state)
                               (lambda ([i u32]) -> u64 (let ([#,x (+ items i)]) (let ([key u64 #,key]) key)))
                               (lambda ([i u32] [row (ptr void)] [parent u32] [before u32])
                                 (let ([#,x (+ items i)] [bs (cast (ptr #,state) row)]) #,mount))
                               (lambda ([i u32] [row (ptr void)])
                                 (let ([#,x (+ items i)] [bs (cast (ptr #,state) row)]) #,update))
                               (lambda ([row (ptr void)] [detach i32]) (#,unmount (cast (ptr #,state) row) detach)))))
        (unmount! b #`(ui-each-clear! (& (-> bs #,rows)) 0
                                      (lambda ([row (ptr void)] [detach i32]) (#,unmount (cast (ptr #,state) row) detach)))))))

  ;; A use of another view, (v e ...): an anchor, and a field that holds
  ;; the nested view's state.
  (define (call! [b (ptr block)] [f datum] [l datum] [v datum])
    (check-arguments! f v (cdr l))
    (html! b "<!--a-->")
    (let ([anchor (node! b)] [names (view-names v)])
      (let ([state (field! b (car names))])
        (mount! b #`(#,(cadr names) (& (-> bs #,state)) 0 #,anchor #,@(cdr l)))
        (update! b #`(#,(caddr names) (& (-> bs #,state)) #,@(cdr l)))
        (unmount! b #`(#,(cadddr names) (& (-> bs #,state)) 0)))))

  (define (cddddr [l datum]) -> datum (cdr (cdddr l)))

  ;; ---- The macros themselves ----

  ;; (messages M) records M by binding a hidden name, ui-message-type, in
  ;; the user's module. This function returns that name, created as if it
  ;; were written at the form s, so that the `view` and `send!` forms of
  ;; the same module can find it.
  (define (message-type-name [s datum]) -> datum (datum->syntax s 'ui-message-type s))

  ;; The macro for (messages M).
  (define (messages-form [s datum]) -> datum
    (syntax-match s
      [(_ (? identifier? m)) #`(define-syntax #,(message-type-name s) (quote-syntax #,m))]))

  ;; The macro for (view (v [x T] ...) child ...). It compiles the body as
  ;; the view's top block, then returns all the definitions: the nested
  ;; blocks' structs and functions, v.mount, v.update, the fill functions,
  ;; and a compile-time binding for the name v (see view-value).
  ;;
  ;; The fill functions are placed after v.mount and v.update on purpose.
  ;; The compiler reports the first error it finds, and a mistake in a
  ;; message is easier to understand when it is reported in the user's own
  ;; form (which appears in mount and update) than in a generated fill
  ;; function.
  (define (view-form [s datum]) -> datum
    (syntax-match s
      [(_ ((? identifier? v) parameter ...) child ...)
       (let ([declared (message-type-name s)])
         (set! view-name v)
         (set! message-type (if (== (identifier-binding-kind declared) 'compile-time-value) (syntax-local-value declared) 0))
         (set! blocks 0)
         (set! fields 0)
         (set! fills nil)
         (set! definitions nil)
         (set! in-rows 0)
         (let ([b (new-block 1)])
           (compile-children! b child)
           (finish! b)
           #`(begin
               #,@(reverse definitions)
               (define (#,(named '"mount") [bs (ptr #,(-> b state))] [parent u32] [before u32] #,@parameter)
                 #,@(mount-code b))
               (define (#,(named '"update") [bs (ptr #,(-> b state))] #,@parameter)
                 #,@(statements (-> b update)))
               #,@(reverse fills)
               (define-syntax #,v
                 (view-value (quote-syntax ((#,(-> b state) #,(named '"mount") #,(named '"update") #,(-> b unmounter))
                                            (#,@parameter))))))))]))

  ;; Builds the compile-time value that a view's name is bound to:
  ;; (ui-view names parameters). view-of reads it back.
  (define (view-value [parts datum]) -> datum
    (let ([l (syntax->list parts)]) `(ui-view ,(car l) ,(cadr l)))))

(define-syntax messages messages-form)
(define-syntax view view-form)
