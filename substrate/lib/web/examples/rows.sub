;; Lifecycle: experimental.
;;
;; A performance example: a table whose rows are created, updated,
;; swapped and removed with buttons. It is the test that the well-known
;; js-framework-benchmark uses to compare UI libraries, so the timings can
;; be compared with theirs. tests/web/rows.mjs measures each
;; operation in a browser; tests/web/pages.mjs checks the results.
;;
;; Each row is a view of its own (row-view), and the table is an `each`
;; over the rows, with the row's id as its key (see lib/web/ui.sub).
(require-unqualified base "../../../compiler/base/base.sub")
(require-unqualified ui "../ui.sub")
(require-unqualified web "../web.sub")
(memory from base)
(table from base)

;; A row: its id, and its label (a heap-allocated string).
(struct row [id u32] [label (ptr u8)])
;; The model: the rows (a growable array, `count` used out of `room`), how
;; many rows have ever been made (the next row's id is this plus 1), and
;; the id of the selected row (0 if none).
(struct model [rows (ptr row)] [count u32] [room u32] [made u32] [selected u32])
(variant message [create] [create-many] [append] [update-some] [swap] [clear] [select [id u32]] [remove [id u32]])
(messages message)

;; Labels are a random adjective and a random noun. `init` fills in the
;; two word lists.
(define adjectives (array (ptr u8) 8))
(define nouns (array (ptr u8) 8))
(define seed u32 1)

;; Returns a pseudo-random number below n. The seed is fixed, so every run
;; produces the same sequence.
(define (random [n u32]) -> u32
  (set! seed (+ (* seed 1103515245) 12345))
  (% (>> seed 16) n))

;; Returns a new label, "adjective noun", as a heap-allocated string.
(define (label) -> (ptr u8)
  (let* ([a (@ adjectives (random 8))] [b (@ nouns (random 8))] [n (strlen a)] [m (strlen b)]
         [p (cast (ptr u8) (malloc (+ n m 2)))])
    (memcpy p a n)
    (set! (@ p n) 32)
    (memcpy (+ p n 1) b (+ m 1))
    p))

;; Appends n new rows.
(define (add-rows! [m (ptr model)] [n u32])
  (when (> (+ (-> m count) n) (-> m room))
    (set! (-> m room) (+ (* 2 (-> m room)) n))
    (set! (-> m rows) (cast (ptr row) (realloc (-> m rows) (* (-> m room) (sizeof row))))))
  (for ([i u32 0]) (< i n) (+= i 1)
    (let ([r (+ (-> m rows) (-> m count))])
      (+= (-> m made) 1)
      (set! (-> r id) (-> m made))
      (set! (-> r label) (label))
      (+= (-> m count) 1))))

;; Removes every row.
(define (clear! [m (ptr model)])
  (for ([i u32 0]) (< i (-> m count)) (+= i 1) (free (-> (+ (-> m rows) i) label)))
  (set! (-> m count) 0))

(define (init [m (ptr model)])
  (set! (@ adjectives 0) "pretty") (set! (@ adjectives 1) "large") (set! (@ adjectives 2) "small")
  (set! (@ adjectives 3) "helpful") (set! (@ adjectives 4) "plain") (set! (@ adjectives 5) "quaint")
  (set! (@ adjectives 6) "clean") (set! (@ adjectives 7) "odd")
  (set! (@ nouns 0) "table") (set! (@ nouns 1) "chair") (set! (@ nouns 2) "house") (set! (@ nouns 3) "desk")
  (set! (@ nouns 4) "car") (set! (@ nouns 5) "pony") (set! (@ nouns 6) "cookie") (set! (@ nouns 7) "keyboard"))

(define (update [m (ptr model)] [e (ptr message)])
  (match e
    [create (clear! m) (add-rows! m 1000)]
    [create-many (clear! m) (add-rows! m 10000)]
    [append (add-rows! m 1000)]
    ;; Appends " !!!" to the label of every tenth row.
    [update-some
     (for ([i u32 0]) (< i (-> m count)) (+= i 10)
       (let* ([r (+ (-> m rows) i)] [n (strlen (-> r label))] [p (cast (ptr u8) (malloc (+ n 5)))])
         (memcpy p (-> r label) n)
         (memcpy (+ p n) " !!!" 5)
         (free (-> r label))
         (set! (-> r label) p)))]
    ;; Swaps the second row with the second-to-last row.
    [swap
     (when (> (-> m count) 3)
       (let ([a (+ (-> m rows) 1)] [b (+ (-> m rows) (- (-> m count) 2))] [t row])
         (set! t (@ a))
         (set! (@ a) (@ b))
         (set! (@ b) t)))]
    [clear (clear! m)]
    [(select id) (set! (-> m selected) id)]
    [(remove id)
     (for ([i u32 0]) (< i (-> m count)) (+= i 1)
       (when (== (-> (+ (-> m rows) i) id) id)
         (free (-> (+ (-> m rows) i) label))
         (memcpy (+ (-> m rows) i) (+ (-> m rows) (+ i 1)) (* (- (-> m count) i 1) (sizeof row)))
         (-= (-> m count) 1)
         (break)))]))

;; One table row. Clicking the label selects the row; clicking "remove"
;; deletes it. The row needs the model to know whether it is selected.
(view (row-view [r (ptr row)] [m (ptr model)])
  (tr ([class (if (== (-> r id) (-> m selected)) "selected" 0)])
    (td ([class "id"]) (int (-> r id)))
    (td (a ([on click (select (-> r id))]) (text (-> r label))))
    (td (a ([class "remove"] [on click (remove (-> r id))]) "remove"))))

;; The page: the buttons, and the table.
(view (rows [m (ptr model)])
  (nav
    (button ([id "create"] [on click create]) "create 1,000 rows")
    (button ([id "create-many"] [on click create-many]) "create 10,000 rows")
    (button ([id "append"] [on click append]) "append 1,000 rows")
    (button ([id "update"] [on click update-some]) "update every 10th row")
    (button ([id "swap"] [on click swap]) "swap rows")
    (button ([id "clear"] [on click clear]) "clear"))
  (table (tbody (each [r (-> m rows) (-> m count)] #:key (-> r id) (row-view r m)))))

(app model message init update rows)
