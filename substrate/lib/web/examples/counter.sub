;; Lifecycle: experimental.
;;
;; A counter: the smallest complete web-page program. It shows a number
;; with "-" and "+" buttons, and a "reset" button whenever the number is
;; not zero.
;;
;; A page's program has four parts (lib/web/web.sub explains them):
;;   - a model: all of the program's state;
;;   - a message type: one case for each thing that can happen;
;;   - an update function: changes the model when a message arrives;
;;   - a view: a template of the page, written in terms of the model
;;     (lib/web/ui.sub explains templates).
;;
;; To try it, in the dev shell:
;;
;;   lib/web/site.sh lib/web/examples/counter.sub build/web/counter
;;   host/web/serve.mjs build/web/counter
;;
;; tests/web/run.sh tests it in a browser.
(require-unqualified base "../../../compiler/base/base.sub")
(require-unqualified ui "../ui.sub")
(require-unqualified web "../web.sub")
(memory from base)
(table from base)

;; The model: the number.
(struct model [count i32])

;; The messages: one for each button.
(variant message [increment] [decrement] [reset])
(messages message)

;; Called once when the page loads.
(define (init [m (ptr model)]) (set! (-> m count) 0))

;; Called for each message, that is, for each click on a button.
(define (update [m (ptr model)] [e (ptr message)])
  (match e
    [increment (+= (-> m count) 1)]
    [decrement (-= (-> m count) 1)]
    [reset (set! (-> m count) 0)]))

;; The page. After every update it is brought up to date with the model:
;; the number, the span's CSS class, and whether the reset button exists.
(view (counter [m (ptr model)])
  (div ([class "counter"])
    (button ([on click decrement]) "-")
    (span ([class (if (< (-> m count) 0) "negative" "count")]) (int (-> m count)))
    (button ([on click increment]) "+")
    (when (!= (-> m count) 0) (button ([on click reset]) "reset"))))

;; Ties the parts together and defines the program's entry points.
(app model message init update counter)
