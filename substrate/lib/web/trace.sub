;; A test helper: prints the page changes (patches) that views produce, as text.
(require-unqualified substrate "../../compiler/substrate/substrate.sub")
(require-unqualified ui "ui.sub")
(require-unqualified gpu "gpu.sub")
(require print "../../compiler/print.sub")

(provide trace-patches! trace-listener trace-gpu!)

(define listeners (array u32 64))
(define listened u32 0)

(define (trace-listener [n u32]) -> (ptr void) (cast (ptr void) (@ listeners n)))

(define (number [n u32]) (print:write-u64 (cast u64 n)))

(define (node [n u32]) (print:write-byte #\#) (number n))

(define (written [w (ptr u32)]) (print:write-bytes (cast i32 (@ w 0)) (cast i32 (@ w 1))))

(define (quoted [w (ptr u32)]) (print:write-byte 34) (written w) (print:write-byte 34))

(define (remember-listener! [m u32])
  (when (< listened 64)
    (set! (@ listeners listened) m)
    (+= listened 1)))

(define (print-float [x f64])
  (when (< x 0.0)
    (print:write-byte #\-)
    (set! x (- 0.0 x)))
  (let* ([thousandths (cast u64 (+ (* x 1000.0) 0.5))] [fraction (% thousandths 1000)])
    (print:write-u64 (/ thousandths 1000))
    (when (!= fraction 0)
      (let ([digits (array u8 3)] [n u32 3])
        (set! (@ digits 0) (cast u8 (+ 48 (/ fraction 100))))
        (set! (@ digits 1) (cast u8 (+ 48 (% (/ fraction 10) 10))))
        (set! (@ digits 2) (cast u8 (+ 48 (% fraction 10))))
        (while (== (@ digits (- n 1)) 48) (-= n 1))
        (print:write-byte #\.)
        (print:write-bytes (cast i32 digits) (cast i32 n))))))

(define (floats [w (ptr u32)] [n u32])
  (for ([i u32 0]) (< i n) (+= i 1)
    (print-string " ")
    (print-float (@ (cast (ptr f32) w) i))))

(define (trace-command [w (ptr u32)]) -> u32
  (print-string "  ")
  (case (@ w 0)
    [(1) (print-string "clear-rect") (floats (+ w 1) 4) 5]
    [(2) (print-string "fill-style ") (quoted (+ w 1)) 3]
    [(3) (print-string "stroke-style ") (quoted (+ w 1)) 3]
    [(4) (print-string "line-width") (floats (+ w 1) 1) 2]
    [(5) (print-string "fill-rect") (floats (+ w 1) 4) 5]
    [(6) (print-string "stroke-rect") (floats (+ w 1) 4) 5]
    [(7) (print-string "begin-path") 1]
    [(8) (print-string "move-to") (floats (+ w 1) 2) 3]
    [(9) (print-string "line-to") (floats (+ w 1) 2) 3]
    [(10) (print-string "arc") (floats (+ w 1) 5) 6]
    [(11) (print-string "close-path") 1]
    [(12) (print-string "fill-path") 1]
    [(13) (print-string "stroke-path") 1]
    [(14) (print-string "set-font ") (quoted (+ w 1)) 3]
    [(15) (print-string "fill-text ") (quoted (+ w 1)) (floats (+ w 3) 2) 5]
    [(16) (print-string "text-align ") (quoted (+ w 1)) 3]
    [(17) (print-string "text-baseline ") (quoted (+ w 1)) 3]
    [(18) (print-string "save-state") 1]
    [(19) (print-string "restore-state") 1]
    [(20) (print-string "translate") (floats (+ w 1) 2) 3]
    [(21) (print-string "rotate") (floats (+ w 1) 1) 2]
    [(22) (print-string "scale") (floats (+ w 1) 2) 3]
    [(23) (print-string "global-alpha") (floats (+ w 1) 1) 2]
    [(24)
     (print-string "draw-sprite image ") (number (@ w 1))
     (print-string " frame ") (number (@ w 2))
     (when (!= (@ w 3) 0) (print-string " flipped"))
     (print-string " cell") (floats (+ w 4) 2)
     (print-string " at") (floats (+ w 6) 2)
     8]
    [else (print-string "?") 1000000]))

(define (trace-patch [w (ptr u32)]) -> u32
  (case (@ w 0)
    [(1) (print-string "template ") (number (@ w 1)) (print-string " ") (written (+ w 2)) 4]
    [(2) (print-string "clone ") (number (@ w 1)) (print-string " as ") (node (@ w 2))
         (print-string " with ") (number (@ w 3)) (print-string " in ") (node (@ w 4))
         (print-string " before ") (node (@ w 5)) 6]
    [(3) (print-string "remove ") (node (@ w 1)) (print-string " with ") (number (@ w 2)) 3]
    [(4) (print-string "free ") (node (@ w 1)) (print-string " with ") (number (@ w 2)) 3]
    [(5) (print-string "move ") (node (@ w 1)) (print-string " in ") (node (@ w 2))
         (print-string " before ") (node (@ w 3)) 4]
    [(6) (print-string "text ") (node (@ w 1)) (print-string " ") (quoted (+ w 2)) 4]
    [(7) (print-string "attr ") (node (@ w 1)) (print-string " ") (written (+ w 2)) (print-string "=") (quoted (+ w 4)) 6]
    [(8) (print-string "unattr ") (node (@ w 1)) (print-string " ") (written (+ w 2)) 4]
    [(9)
     (remember-listener! (@ w 4))
     (print-string "listen ") (node (@ w 1)) (print-string " ") (written (+ w 2)) 5]
    [(10) (print-string "focus ") (node (@ w 1)) 2]
    [(11) (print-string "scroll-end ") (node (@ w 1)) 2]
    [(15) (print-string (if (== (@ w 2) 0) "pointer-unlock " "pointer-lock ")) (node (@ w 1)) 3]
    [(12)
     (remember-listener! (@ w 4))
     (print-string "listen-window ") (node (@ w 1)) (print-string " ") (written (+ w 2)) 5]
    [(13)
     (print-string "draw ") (node (@ w 1))
     (let ([i u32 0])
       (while (< i (@ w 2))
         (print:newline)
         (+= i (trace-command (+ w (+ 3 i))))))
     (+ 3 (@ w 2))]
    [(14) (print-string "image ") (number (@ w 1)) (print-string " ") (written (+ w 2)) 4]
    ;; A size large enough to end trace-patches!'s loop.
    [else (print-string "?") 1000000]))

(define (trace-patches!)
  (let* ([b (ui-patches)] [w (cast (ptr u32) (-> b bytes))] [n (/ (-> b length) 4)] [i u32 0])
    (set! listened 0)
    (while (< i n)
      (+= i (trace-patch (+ w i)))
      (print:newline))
    (print-string "--\n")
    (ui-patches-done!)))

(define (numbers [w (ptr u32)] [n u32])
  (for ([i u32 0]) (< i n) (+= i 1)
    (print-string " ")
    (number (@ w i))))

(define (trace-gpu-command [w (ptr u32)]) -> u32
  (case (@ w 0)
    [(1) (print-string "surface") (numbers (+ w 1) 1) (print-string " node") (numbers (+ w 2) 1) 3]
    [(2) (print-string "shader") (numbers (+ w 1) 1) (print-string " ") (number (@ w 3)) (print-string " bytes") 4]
    [(3)
     (print-string "render-pipeline") (numbers (+ w 1) 2)
     (print-string " vertex ") (quoted (+ w 3)) (print-string " fragment ") (quoted (+ w 5))
     (print-string " topology") (numbers (+ w 7) 1) (print-string " cull") (numbers (+ w 8) 1)
     (print-string " front") (numbers (+ w 9) 1) (print-string " blend") (numbers (+ w 10) 1)
     (print-string " depth") (numbers (+ w 11) 3)
     (let ([i u32 14])
       (let ([layouts (@ w i)])
         (+= i 1)
         (print-string "\n  layouts") (numbers (+ w i) layouts)
         (+= i layouts))
       (let ([targets (@ w i)])
         (+= i 1)
         (print-string "\n  targets") (numbers (+ w i) targets)
         (+= i targets))
       (let ([buffers (@ w i)])
         (+= i 1)
         (for ([b u32 0]) (< b buffers) (+= b 1)
           (print-string "\n  buffer stride") (numbers (+ w i) 1)
           (print-string (if (== (@ w (+ i 1)) 0) " per vertex" " per instance"))
           (let ([attributes (@ w (+ i 2))])
             (+= i 3)
             (for ([a u32 0]) (< a attributes) (+= a 1)
               (print-string " [") (number (@ w i)) (print-string " at") (numbers (+ w (+ i 1)) 1)
               (print-string " format") (numbers (+ w (+ i 2)) 1) (print-string "]")
               (+= i 3)))))
       i)]
    [(4)
     (print-string "compute-pipeline") (numbers (+ w 1) 2) (print-string " entry ") (quoted (+ w 3))
     (let ([layouts (@ w 5)])
       (print-string "\n  layouts") (numbers (+ w 6) layouts)
       (+ 6 layouts))]
    [(5) (print-string "buffer") (numbers (+ w 1) 1) (print-string " size") (numbers (+ w 2) 1) (print-string " usage") (numbers (+ w 3) 1) 4]
    [(6)
     (print-string "texture") (numbers (+ w 1) 1) (print-string " size") (numbers (+ w 2) 2)
     (print-string " layers") (numbers (+ w 4) 1) (print-string " mips") (numbers (+ w 5) 1)
     (print-string " format") (numbers (+ w 6) 1) (print-string " usage") (numbers (+ w 7) 1) 8]
    [(7) (print-string "texture-file") (numbers (+ w 1) 1) (print-string " ") (quoted (+ w 2)) 4]
    [(8) (print-string "sampler") (numbers (+ w 1) 1) (print-string " filter") (numbers (+ w 2) 1) (print-string " address") (numbers (+ w 3) 1) (print-string " compare") (numbers (+ w 4) 1) 5]
    [(9)
     (print-string "layout") (numbers (+ w 1) 1)
     (let ([n (@ w 2)] [i u32 3])
       (for ([k u32 0]) (< k n) (+= k 1)
         (print-string "\n  binding") (numbers (+ w i) 1) (print-string " visibility") (numbers (+ w (+ i 1)) 1)
         (print-string " kind") (numbers (+ w (+ i 2)) 1)
         (+= i 3))
       i)]
    [(10)
     (print-string "bind-group") (numbers (+ w 1) 1) (print-string " layout") (numbers (+ w 2) 1)
     (print-string " pipeline") (numbers (+ w 3) 1) (print-string " group") (numbers (+ w 4) 1)
     (let ([n (@ w 5)] [i u32 6])
       (for ([k u32 0]) (< k n) (+= k 1)
         (print-string "\n  binding") (numbers (+ w i) 1)
         (print-string (case (@ w (+ i 1)) [(1) " buffer"] [(2) " sampler"] [(3) " texture"] [else " ?"]))
         (numbers (+ w (+ i 2)) 1)
         (when (== (@ w (+ i 1)) 1) (print-string " offset") (numbers (+ w (+ i 3)) 1) (print-string " size") (numbers (+ w (+ i 4)) 1))
         (+= i 5))
       i)]
    [(11) (print-string "destroy kind") (numbers (+ w 1) 2) 3]
    [(12) (print-string "write-buffer") (numbers (+ w 1) 1) (print-string " offset") (numbers (+ w 2) 1) (print-string " bytes") (numbers (+ w 4) 1) 5]
    [(13)
     (print-string "write-texture") (numbers (+ w 1) 1) (print-string " mip") (numbers (+ w 2) 1) (print-string " layer") (numbers (+ w 3) 1)
     (print-string " at") (numbers (+ w 4) 2) (print-string " size") (numbers (+ w 6) 2) (print-string " bytes") (numbers (+ w 9) 1) 10]
    [(14) (print-string "read-texture") (numbers (+ w 1) 1) (print-string " mip") (numbers (+ w 2) 1) (print-string " layer") (numbers (+ w 3) 1) (print-string " at") (numbers (+ w 4) 2) (print-string " size") (numbers (+ w 6) 2) 8]
    [(15) (print-string "read-buffer") (numbers (+ w 1) 1) (print-string " offset") (numbers (+ w 2) 1) (print-string " bytes") (numbers (+ w 3) 1) 4]
    [(16)
     (print-string "render-pass")
     (let ([n (@ w 1)] [i u32 2])
       (for ([k u32 0]) (< k n) (+= k 1)
         (print-string (if (== (@ w i) 1) "\n  surface" "\n  texture")) (numbers (+ w (+ i 1)) 1)
         (print-string " mip") (numbers (+ w (+ i 2)) 1) (print-string " layer") (numbers (+ w (+ i 3)) 1)
         (print-string (if (== (@ w (+ i 4)) 0) " kept" " cleared to")) (when (!= (@ w (+ i 4)) 0) (floats (+ w (+ i 5)) 4))
         (+= i 9))
       (when (!= (@ w i) 0)
         (print-string "\n  depth texture") (numbers (+ w i) 1) (print-string " mip") (numbers (+ w (+ i 1)) 1)
         (print-string " layer") (numbers (+ w (+ i 2)) 1)
         (print-string (if (== (@ w (+ i 3)) 0) " kept" " cleared to")) (when (!= (@ w (+ i 3)) 0) (floats (+ w (+ i 4)) 1)))
       (+ i 5))]
    [(17) (print-string "compute-pass") 1]
    [(18) (print-string "end-pass") 1]
    [(19) (print-string "pipeline") (numbers (+ w 1) 1) 2]
    [(20)
     (print-string "bind-group group") (numbers (+ w 1) 2)
     (let ([n (@ w 3)])
       (when (> n 0) (print-string " offsets") (numbers (+ w 4) n))
       (+ 4 n))]
    [(21) (print-string "vertex-buffer slot") (numbers (+ w 1) 1) (print-string " buffer") (numbers (+ w 2) 1) (print-string " offset") (numbers (+ w 3) 1) 4]
    [(22) (print-string "index-buffer") (numbers (+ w 1) 1) (print-string " format") (numbers (+ w 2) 1) (print-string " offset") (numbers (+ w 3) 1) 4]
    [(23) (print-string "draw") (numbers (+ w 1) 4) 5]
    [(24) (print-string "draw-indexed") (numbers (+ w 1) 5) 6]
    [(25) (print-string "dispatch") (numbers (+ w 1) 3) 4]
    [(26) (print-string "viewport") (floats (+ w 1) 4) 5]
    [(27) (print-string "scissor") (numbers (+ w 1) 4) 5]
    [else (print-string "unknown command ") (number (@ w 0)) 1]))

(define (trace-gpu!)
  (let* ([b (gpu-commands)] [w (cast (ptr u32) (-> b bytes))] [n (/ (-> b length) 4)] [i u32 0])
    (while (< i n)
      (+= i (trace-gpu-command (+ w i)))
      (print:newline))
    (print-string "--\n")
    (gpu-commands-done!)))
