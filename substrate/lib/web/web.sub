;; Lifecycle: experimental.
;;
;; The structure of a web page's program: model, messages, update, view.
;;
;; A page's program is written in four parts (the same design as Elm):
;;
;;   model     a struct that holds all of the program's state
;;   message   a variant type with one case for each thing that can happen
;;             (a click, a key press, a reply from a worker, ...)
;;   update    a function that changes the model in response to a message
;;   view      a template (see ui.sub) that describes the page for a given
;;             model
;;
;; The page then runs in a loop. An event happens; the listener that
;; caught it supplies a message; `update` changes the model; the view is
;; re-evaluated and the page is changed where the result differs.
;;
;; This file connects those parts to the browser. It uses the host module
;; "dom" (host/web/dom.mjs), which a page's host gives to a program
;; (host/web/subhost-web.mjs).
;;
;;   (app M E init update v)
;;   (app M E init update v trapped)
;;       Defines the program's entry points. Write it once, at the end of
;;       the program.
;;         M        the model's type (a struct)
;;         E        the message type (a variant); the module must also
;;                  declare it with (messages E)
;;         init     (define (init [m (ptr M)]) ...): sets up the first
;;                  model. The model starts out as all zero bytes.
;;         update   (define (update [m (ptr M)] [e (ptr E)]) ...)
;;         v        the page's view: (view (v [m (ptr M)]) ...)
;;         trapped  optional: (define (trapped [m (ptr M)]) ...). Without
;;                  it, a trap (a crash such as a division by zero) in
;;                  `update` is only reported on the browser's console,
;;                  and the program is left in an undefined state. With
;;                  it, the program recovers: `trapped` is called to
;;                  repair the model, and the page is redrawn.
;;       `app` defines these functions, which the host calls by name:
;;         main      called once when the page loads
;;         on-event  called for each event that a listener is waiting for
;;         on-trap   called after a trap (only if `trapped` is given)
;;
;;   (send! e)
;;       Delivers the message `e` (a pointer to an E) to the program
;;       exactly as if a listener had produced it: `update` runs, then
;;       the page is redrawn. Use it for things that are not page events.
;;       For example, a program that uses guests (guest.sub) defines
;;       `on-guest`, which the host calls, and calls send! from it.
;;
;;   (prevent-default!)
;;       Call it inside `update` to cancel the browser's default handling
;;       of the event being processed. For example, in a keydown handler
;;       it stops the key from typing a character.
;;
;;   (flush!)
;;       Sends the pending page changes to the browser now. `app` already
;;       does this after every update, so programs rarely need it.
;;
;; Event text has a short lifetime. When a message carries text taken
;; from an event, written (event value) or (event key) in a template, the
;; text is only valid during the `update` call. Copy it to keep it.
(require-unqualified base "../../compiler/base/base.sub")
(require-unqualified ui "ui.sub")

(provide app send! flush! prevent-default!)

(memory from base)
(table from base)

;; The functions of the host module "dom". host/web/dom.mjs documents
;; them.
(import dom-apply "dom" "apply" (i32 i32 ->))
(import dom-event-value "dom" "event_value" (i32 i32 -> i32))
(import dom-event-key "dom" "event_key" (i32 i32 -> i32))
(import dom-event-flags "dom" "event_flags" (-> i32))
(import dom-event-number "dom" "event_number" (i32 -> f64))
(import dom-prevent-default "dom" "prevent_default" (->))

;; Sends the patch buffer (the list of page changes that ui.sub has
;; collected) to the browser, then empties it.
;;
;; The buffer's length is set to 0 *before* the host is called, not after.
;; Applying patches can itself fire an event: moving the focus to a field
;; fires a focus event immediately. If the program is listening, it is
;; called again right then, inside dom-apply, and writes and flushes new
;; patches into the same buffer. Emptying the buffer first keeps those new
;; patches separate from the ones being applied. (The host has finished
;; reading the old patches by the time it calls the program back.)
(define (flush!)
  (let* ([b (ui-patches)] [n (-> b length)])
    (when (> n 0)
      (set! (-> b length) 0)
      (dom-apply (cast i32 (-> b bytes)) n))
    (ui-patches-done!)))

;; Returns a text property of the event being handled, as a C string.
;; `which` is 0 for the value of the element the event came from (for
;; example, the content of a text field), or 1 for the name of the key
;; that was pressed. ui.sub calls this to fill in (event value) and
;; (event key).
;;
;; The string is allocated with ui-frame-alloc, so it is freed
;; automatically when the next batch of patches has been applied.
(define (event-text [which u32]) -> (ptr u8)
  ;; Called with a capacity of 0, the host functions only return the
  ;; length.
  (let* ([n (if (== which 0) (dom-event-value 0 0) (dom-event-key 0 0))] [p (cast (ptr u8) (ui-frame-alloc (+ n 1)))])
    (if (== which 0) (dom-event-value (cast i32 p) n) (dom-event-key (cast i32 p) n))
    (set! (@ p n) 0)
    p))

;; Returns the yes/no properties of the event being handled, as bits:
;; 1 = Shift held, 2 = Control held, 4 = Alt held, 8 = Meta held,
;; 16 = the element is a checked checkbox. ui.sub calls this to fill in
;; (event shift), (event checked), and so on.
(define (event-truths) -> u32 (cast u32 (dom-event-flags)))

;; Returns a numeric property of the event being handled. `which` is 0
;; for the time of the event in milliseconds, 1 for the mouse's x position
;; and 2 for its y position, both relative to the element. ui.sub calls
;; this to fill in (event time), (event x) and (event y).
(define (event-number [which u32]) -> f64 (dom-event-number (cast i32 which)))

(define (prevent-default!) (dom-prevent-default))

;; A pointer to the running program's "deliver a message" function. The
;; `main` that `app` generates sets it. It is how send!, which is defined
;; in this file, reaches the update function and view of a program that
;; is defined in another file.
(define deliver (fn ((ptr void))) 0)

(define (app-deliver! [f (fn ((ptr void)))]) (set! deliver f))

;; Delivers the message at address e to the running program. Does nothing
;; if no program has started.
(define (app-send [e (ptr void)])
  (let ([f deliver])
    (when (!= f 0) (f e))))

;; The code below runs at compile time. It implements the `app` and
;; `send!` forms as macros: functions from the form's syntax to the code
;; that replaces it.
(begin-for-syntax
  (require-unqualified base "../../compiler/base/base.sub")
  (require-unqualified kd "../../compiler/kernel.sub")
  (require sm "../../compiler/base/syntax-match.sub" syntax-match _ ... ?)

  ;; Expands (app M E init update v [trapped]) into:
  ;;   app-model, app-view   global variables: the model, and the state of
  ;;                         the view's one instance
  ;;   main                  initialises the model, draws the page
  ;;   app-deliver           handles one message: update, then redraw
  ;;   on-event              the host calls it with a number that
  ;;                         identifies the listener that caught an event
  ;;                         (in fact the listener's address; see the
  ;;                         "listeners" section of ui.sub). ui-heard
  ;;                         turns that into the listener's message.
  ;;   on-trap, after-trap   only if `trapped` is given
  ;;
  ;; A view's name is bound, at compile time, to the names of the
  ;; functions ui.sub generated for it. `names` below is that list:
  ;; (state-type mount-function update-function unmount-function).
  (define (app-form [s datum]) -> datum
    (syntax-match s
      [(_ model message init update (? identifier? v) trapped ...)
       (let* ([value (if (== (identifier-binding-kind v) 'compile-time-value) (syntax-local-value v) 0)]
              [names (if (and (pair? value) (== (car value) 'ui-view)) (syntax->list (cadr value)) 0)])
         (when (== names 0) (raise-syntax-error 'app '"the fifth argument must be the name of a view" v))
         (unless (== (length (syntax->list (caddr value))) 1)
           (raise-syntax-error 'app '"the page's view must take exactly one parameter, a pointer to the model: (view (v [m (ptr M)]) ...)" v))
         (when (and (pair? trapped) (pair? (cdr trapped))) (raise-syntax-error 'app '"expected (app M E init update v [trapped])" s))
         #`(begin
             (define app-model #,model)
             (define app-view #,(car names))
             (define (main)
               (ui-event-source! event-text event-truths event-number)
               (app-deliver! app-deliver)
               (#,init (& app-model))
               (#,(cadr names) (& app-view) 0 0 (& app-model))
               (flush!))
             (define (app-deliver [e (ptr void)])
               (#,update (& app-model) (cast (ptr #,message) e))
               (#,(caddr names) (& app-view) (& app-model))
               (flush!))
             (define (on-event [at u32]) (app-deliver (ui-heard (cast (ptr void) at))))
             #,@(if (null? trapped)
                    nil
                    ;; After a trap, the functions that were running did
                    ;; not get to restore the C stack pointer, so on-trap
                    ;; resets it (reset-stack!) before any C code runs.
                    ;; on-trap is a kernel-level `func` for that reason.
                    ;; Patches written before the trap are thrown away
                    ;; (ui-patches-done!), not applied.
                    `(,#`(func (on-trap) (reset-stack!) (after-trap))
                      ,#`(define (after-trap)
                           (ui-patches-done!)
                           (#,(car trapped) (& app-model))
                           (#,(caddr names) (& app-view) (& app-model))
                           (flush!))))))]))

  ;; Expands (send! e) into a call of app-send.
  ;;
  ;; The message type is looked up from the module's (messages E)
  ;; declaration, and `e` is first stored in a variable of type (ptr E).
  ;; That way, passing a value of the wrong type is a compile error that
  ;; points at `e` in the user's code.
  (define (send-form [s datum]) -> datum
    (syntax-match s
      [(_ e)
       (let ([declared (datum->syntax s 'ui-message-type s)])
         (unless (== (identifier-binding-kind declared) 'compile-time-value)
           (raise-syntax-error 'send! '"this module declares no message type: add (messages TYPE) before using send!" s))
         #`(app-send (cast (ptr void) (let ([message (ptr #,(syntax-local-value declared)) #,e]) message))))])))

(define-syntax app app-form)
(define-syntax send! send-form)
