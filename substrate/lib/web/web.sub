;; The language of a web page's program: Substrate, ui.sub's views, and app: model, messages, update, view.
(require-unqualified substrate "../../compiler/substrate/substrate.sub")
(require-unqualified ui "ui.sub")

(provide (all-from-out substrate) (all-from-out ui) app send! flush! prevent-default!)

(import dom-apply "dom" "apply" (i32 i32 ->))
(import dom-event-value "dom" "event_value" (i32 i32 -> i32))
(import dom-event-key "dom" "event_key" (i32 i32 -> i32))
(import dom-event-flags "dom" "event_flags" (-> i32))
(import dom-event-number "dom" "event_number" (i32 -> f64))
(import dom-prevent-default "dom" "prevent_default" (->))

;; The length is reset before dom-apply: applying patches can fire an event whose
;; handler writes and flushes new patches into the same buffer.
(define (flush!)
  (let* ([b (ui-patches)] [n (-> b length)])
    (when (> n 0)
      (set! (-> b length) 0)
      (dom-apply (cast i32 (-> b bytes)) n))
    (ui-patches-done!)))

(define (event-text [which u32]) -> (ptr u8)
  (let* ([n (if (== which 0) (dom-event-value 0 0) (dom-event-key 0 0))] [p (cast (ptr u8) (ui-frame-alloc (+ n 1)))])
    (if (== which 0) (dom-event-value (cast i32 p) n) (dom-event-key (cast i32 p) n))
    (set! (@ p n) 0)
    p))

(define (event-truths) -> u32 (cast u32 (dom-event-flags)))

(define (event-number [which u32]) -> f64 (dom-event-number (cast i32 which)))

(define (prevent-default!) (dom-prevent-default))

;; Set by the main that app generates, so that send! reaches the program's update.
(define deliver (fn ((ptr void))) 0)

(define (app-deliver! [f (fn ((ptr void)))]) (set! deliver f))

(define (app-send [e (ptr void)])
  (let ([f deliver])
    (when (!= f 0) (f e))))

(begin-for-syntax
  (require-unqualified substrate "../../compiler/substrate/substrate.sub")
  (require-unqualified kd "../../compiler/kernel.sub")
  (require sm "../../compiler/substrate/syntax-match.sub" syntax-match _ ... ?)

  ;; A view's name is bound to (ui-view (state mount update unmount) parameters).
  (define (app-form [s datum]) -> datum
    (syntax-match s
      [(_ model message init update (? identifier? v) trapped ...)
       (let* ([value (if (== (identifier-binding-kind v) 'compile-time-value) (syntax-local-value v) 0)]
              [names (if (and (pair? value) (== (car value) 'ui-view)) (syntax->list (cadr value)) 0)])
         (when (== names 0) (raise-syntax-error 'app '"the fifth argument must be the name of a view" v))
         (unless (== (length (syntax->list (caddr value))) 1)
           (raise-syntax-error 'app '"the page's view must take exactly one parameter, a pointer to the model: (view (v [m (ptr M)]) ...)" v))
         (when (and (pair? trapped) (pair? (cdr trapped))) (raise-syntax-error 'app '"expected (app M E init update v [trapped])" s))
         #`(begin
             (define app-model #,model)
             (define app-view #,(car names))
             (define (main)
               (ui-event-source! event-text event-truths event-number)
               (app-deliver! app-deliver)
               (#,init (& app-model))
               (#,(cadr names) (& app-view) 0 0 (& app-model))
               (flush!))
             (define (app-deliver [e (ptr void)])
               (#,update (& app-model) (cast (ptr #,message) e))
               (#,(caddr names) (& app-view) (& app-model))
               (flush!))
             (define (on-event [at u32]) (app-deliver (ui-heard (cast (ptr void) at))))
             #,@(if (null? trapped)
                    nil
                    ;; A trap skipped the code that restores the stack pointer, so on-trap is a kernel
                    ;; func that resets it before any Substrate code runs; the trap's patches are dropped.
                    `(,#`(func (on-trap) (reset-stack!) (after-trap))
                      ,#`(define (after-trap)
                           (ui-patches-done!)
                           (#,(car trapped) (& app-model))
                           (#,(caddr names) (& app-view) (& app-model))
                           (flush!))))))]))

  ;; e is bound to a (ptr E) first, so that a value of the wrong type is an error at e.
  (define (send-form [s datum]) -> datum
    (syntax-match s
      [(_ e)
       (let ([declared (datum->syntax s 'ui-message-type s)])
         (unless (== (identifier-binding-kind declared) 'compile-time-value)
           (raise-syntax-error 'send! '"this module declares no message type: add (messages TYPE) before using send!" s))
         #`(app-send (cast (ptr void) (let ([message (ptr #,(syntax-local-value declared)) #,e]) message))))])))

(define-syntax app app-form)
(define-syntax send! send-form)
