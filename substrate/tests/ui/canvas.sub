;; Canvas drawing and window listeners: the patches a view writes, printed.
(require-unqualified ui "../../lib/web/ui.sub")
(require-unqualified canvas "../../lib/web/canvas.sub")
(require-unqualified trace "../../lib/web/trace.sub")
(require print "../../compiler/substrate.sub")

(struct model [show i32] [frame u32] [x i32] [y i32] [label (ptr u8)])
(variant msg [tick [time f64]] [pointed [x i32] [y i32]] [pressed [key (ptr u8)]])
(messages msg)

(define sheet u32 0)

(define (paint [m (ptr model)])
  (fill-style "black")
  (fill-rect 0 0 320 240)
  (fill-style "#4caf50")
  (fill-circle (-> m x) (-> m y) 10)
  (stroke-style "white")
  (line-width 2)
  (draw-line 0 0 (-> m x) (-> m y))
  (stroke-rect 0.5 0.5 319 239)
  (begin-path)
  (move-to 10 10)
  (line-to 20 10)
  (line-to 15 20)
  (close-path)
  (fill-path)
  (save-state)
  (translate 160 120)
  (rotate 0.25)
  (scale 2 2)
  (global-alpha 0.5)
  (set-font "16px sans-serif")
  (text-align "center")
  (text-baseline "middle")
  (fill-text (-> m label) 0 0)
  (restore-state)
  (clear-rect 0 0 4 4)
  (draw-sprite sheet 16 16 5 40 50 0)
  (draw-sprite sheet 16 16 9 60 50 1)
  (load-image "ignored.png"))

(view (board [m (ptr model)])
  (when (-> m show)
    (canvas ([width 320] [height 240]
             [draw (-> m frame) (paint m)]
             [on click (pointed (event x) (event y))]
             [on-window keydown (pressed (event key))]
             [on-window frame (tick (event time))]))))

(define the-model model)
(define a-board board.state)

(define (event-text [which u32]) -> (ptr u8) (if (== which 1) "ArrowUp" ""))
(define (event-truths) -> u32 0)
(define (event-number [which u32]) -> f64
  (case which
    [(0) 1234.5]
    [(1) 12.0]
    [else 34.0]))

(define (hear [n u32])
  (match (cast (ptr msg) (ui-heard (trace-listener n)))
    [(tick time) (print-string "tick at ") (print:write-u64 (cast u64 time)) (print-string " ms")]
    [(pointed x y)
     (print-string "pointed at ") (print:write-int x) (print-string ", ") (print:write-int y)]
    [(pressed key) (print-string "pressed ") (print-string key)])
  (print-string "\n"))

(define (step [what (ptr u8)])
  (print-string what)
  (print-string "\n")
  (board.update (& a-board) (& the-model))
  (trace-patches!))

(define (main)
  (set! (-> the-model show) 1)
  (set! (-> the-model x) 100)
  (set! (-> the-model y) 50)
  (set! (-> the-model label) "hello")
  (ui-event-source! event-text event-truths event-number)
  (print-string "load an image\n")
  (set! sheet (load-image "assets/sprites.png"))
  (trace-patches!)
  (print-string "mount\n")
  (board.mount (& a-board) 0 0 (& the-model))
  (trace-patches!)

  (print-string "events\n")
  (hear 0)
  (hear 1)
  (hear 2)

  (step "nothing changed")
  (set! (-> the-model x) 120)
  (step "the dot moved, but the draw key did not change")
  (set! (-> the-model frame) 1)
  (step "the draw key changed")

  (print-string "drawing outside a [draw ...]\n")
  (fill-rect 1 2 3 4)
  (fill-text "lost" 0 0)
  (trace-patches!)

  (set! (-> the-model show) 0)
  (step "the canvas is removed"))
