;; Error test: [on-window ...] with an event name that does not exist (a
;; misspelt `keydown`). The error must point at the event name.
(require-unqualified base "../../compiler/base/base.sub")
(require-unqualified ui "../../lib/web/ui.sub")
(memory from base)
(table from base)

(struct model [count i32])
(variant msg [tick [time f64]] [pressed])
(messages msg)
(define (paint [m (ptr model)]) 0)

(view (page [m (ptr model)])
  (canvas ([on-window keydwn pressed])))
(define (main) 0)
