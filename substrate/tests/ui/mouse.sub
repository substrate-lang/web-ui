;; A test of the view language's mouse features (lib/web/ui.sub): the
;; event data movement-x, movement-y, button and locked, and the
;; attribute [pointer-lock e], which writes a patch each time its
;; integer changes: a lock for anything but 0, a release for 0. It
;; needs no browser: the patches are printed (lib/web/trace.sub), and
;; the events come from made-up data.
(require-unqualified base "../../compiler/base/base.sub")
(require-unqualified ui "../../lib/web/ui.sub")
(require-unqualified trace "../../lib/web/trace.sub")
(require-unqualified format "../../lib/web/game/format.sub")
(memory from base)
(table from base)

(struct model [lock u32])
(variant msg [clicked [button i32] [x i32]] [moved [dx i32] [dy i32]] [lock-changed [locked i32]])
(messages msg)

(view (screen [m (ptr model)])
  (canvas ([width 64] [height 36]
           [pointer-lock (-> m lock)]
           [on mousedown (clicked (event button) (event x))]
           [on-window mousemove (moved (event movement-x) (event movement-y))]
           [on-window pointerlockchange (lock-changed (event locked))])))

(define the-model model)
(define a-screen screen.state)

;; The made-up event: the right button, at x 40, having moved 12 right
;; and 5 up, with the pointer locked.
(define (event-text [which u32]) -> (ptr u8) "")
(define (event-truths) -> u32 32)
(define (event-number [which u32]) -> f64
  (case which [(1) 40.0] [(3) 12.0] [(4) -5.0] [(5) 2.0] [else 0.0]))

(define (hear [n u32])
  (match (cast (ptr msg) (ui-heard (trace-listener n)))
    [(clicked button x) (print-format "  clicked: button ~d at x ~d\n" button x)]
    [(moved dx dy) (print-format "  moved: ~d ~d\n" dx dy)]
    [(lock-changed locked) (print-format "  the lock changed: locked ~d\n" locked)]))

(define (main)
  (ui-event-source! event-text event-truths event-number)
  (print-string "mount\n")
  (screen.mount (& a-screen) 0 0 (& the-model))
  (trace-patches!)
  (print-string "events\n")
  (hear 0)
  (hear 1)
  (hear 2)
  (print-string "asking for the lock\n")
  (set! (-> the-model lock) 1)
  (screen.update (& a-screen) (& the-model))
  (trace-patches!)
  (print-string "asking again, by changing the number\n")
  (set! (-> the-model lock) 2)
  (screen.update (& a-screen) (& the-model))
  (trace-patches!)
  (print-string "nothing changed\n")
  (screen.update (& a-screen) (& the-model))
  (trace-patches!)
  (print-string "releasing\n")
  (set! (-> the-model lock) 0)
  (screen.update (& a-screen) (& the-model))
  (trace-patches!))
