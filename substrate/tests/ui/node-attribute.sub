;; [node place] stores an element's node number where the program says.
(require-unqualified substrate "../../compiler/substrate/substrate.sub")
(require-unqualified ui "../../lib/web/ui.sub")
(require-unqualified trace "../../lib/web/trace.sub")
(require print "../../compiler/print.sub")

(struct model [screen u32] [overlay u32] [show i32])

(define screen-node u32 0)

(view (page [m (ptr model)])
  (canvas ([width 64] [height 36] [node (-> m screen)]))
  (when (-> m show)
    (canvas ([width 64] [height 36] [node screen-node]))))

(define the-model model)
(define a-page page.state)

(define (show)
  (print-string "  the field holds #") (print:write-u64 (cast u64 (-> the-model screen)))
  (print-string ", the variable #") (print:write-u64 (cast u64 screen-node))
  (print-string "\n"))

(define (main)
  (print-string "mount: the first canvas is numbered\n")
  (page.mount (& a-page) 0 0 (& the-model))
  (trace-patches!)
  (show)
  (print-string "update: the second canvas appears, and is numbered too\n")
  (set! (-> the-model show) 1)
  (page.update (& a-page) (& the-model))
  (trace-patches!)
  (show))
