;; A view used with more arguments than it has parameters, reported at the use.
(require-unqualified base "../../compiler/base/base.sub")
(require-unqualified ui "../../lib/web/ui.sub")
(memory from base)
(table from base)

(struct item [id u32] [name (ptr u8)])
(struct model [count i32] [title (ptr u8)] [items (array item 4)] [n u32])
(variant msg [increment] [typed [text (ptr u8)]])
(messages msg)

(view (row [x (ptr item)]) (li (text (-> x name))))

(view (page [m (ptr model)])
  (ul (each [x (-> m items) (-> m n)] #:key (-> x id)
        (row x m))))
(define (main) 0)
