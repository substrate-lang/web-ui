;; A test of views (lib/web/ui.sub) that needs no browser.
;;
;; Views do not change a page directly. They write "patches", instructions
;; for the page, into a buffer. This test mounts and updates some views
;; and prints the patches as text (lib/web/trace.sub); views.out is the
;; expected output. It checks that:
;;   - mounting writes the view's HTML template, one copy of it, and the
;;     initial value of each changing part;
;;   - an update writes a patch only for a part whose value changed, and
;;     nothing at all if nothing changed;
;;   - if, each and nested views insert and remove their own copies;
;;   - an each keeps the rows whose keys are still present, and moves
;;     them instead of rebuilding them.
(require-unqualified base "../../compiler/base/base.sub")
(require-unqualified ui "../../lib/web/ui.sub")
(require-unqualified trace "../../lib/web/trace.sub")
(memory from base)
(table from base)

(struct item [id u32] [name (ptr u8)] [done i32])
(struct model [count i32] [title (ptr u8)] [items (array item 8)] [n u32])
(variant msg [increment] [decrement] [toggle [id u32]])
(messages msg)

;; A view with each kind of changing part: text, an integer, a text
;; attribute, a boolean attribute (disabled), a focus request, and
;; listeners.
(view (counter [m (ptr model)])
  (div ([class "counter"])
    (h1 (text (-> m title)))
    (button ([on click decrement] [disabled (== (-> m count) 0)]) "-")
    (span ([class (if (< (-> m count) 0) "neg" "pos")]) "count: " (int (-> m count)) "!")
    (button ([on click increment]) "+")
    (br)
    (input ([type "text"] [value (-> m title)] [focus (-> m count)]))))

;; A view that is used inside another view, with an `if` that has both
;; alternatives.
(view (row [x (ptr item)])
  (li ([class (if (-> x done) "done" 0)] [on click (toggle (-> x id))])
    (text (-> x name))
    (if (-> x done) (b "done") (i "to do"))))

;; An each whose rows are the view above, a `when`, a nested view, and
;; text that must be escaped in HTML.
(view (todo [m (ptr model)])
  (when (> (-> m n) 0) (p "a < b & \"c\"" (int (-> m n))))
  (ul ([title "a \"list\" & <more>"]) (each [x (-> m items) (-> m n)] #:key (-> x id) (row x)))
  (counter m))

(define the-model model)
(define a-counter counter.state)
(define a-todo todo.state)

(define (set-item! [i u32] [id u32] [name (ptr u8)] [done i32])
  (let ([x (+ (-> the-model items) i)])
    (set! (-> x id) id)
    (set! (-> x name) name)
    (set! (-> x done) done)))

(define (step [what (ptr u8)])
  (print-string what)
  (print-string "\n")
  (todo.update (& a-todo) (& the-model))
  (trace-patches!))

(define (main)
  (set! (-> the-model count) 0)
  (set! (-> the-model title) "Counter")
  (set! (-> the-model n) 0)
  (print-string "mount a counter\n")
  (counter.mount (& a-counter) 0 0 (& the-model))
  (trace-patches!)
  (print-string "count 5\n")
  (set! (-> the-model count) 5)
  (counter.update (& a-counter) (& the-model))
  (trace-patches!)
  (print-string "count -1, another title\n")
  (set! (-> the-model count) -1)
  (set! (-> the-model title) "Counting")
  (counter.update (& a-counter) (& the-model))
  (trace-patches!)
  (print-string "nothing changed\n")
  (counter.update (& a-counter) (& the-model))
  (trace-patches!)
  (print-string "unmount it\n")
  (counter.unmount (& a-counter) 1)
  (trace-patches!)

  (print-string "mount a todo, empty\n")
  (todo.mount (& a-todo) 0 0 (& the-model))
  (trace-patches!)
  (set-item! 0 10 "ten" 0)
  (set-item! 1 20 "twenty" 0)
  (set! (-> the-model n) 2)
  (step "two items")
  (set-item! 2 30 "thirty" 1)
  (set! (-> the-model n) 3)
  (step "a third, done")
  (set-item! 0 10 "ten" 1)
  (step "the first done")
  (set-item! 0 20 "twenty" 0)
  (set-item! 1 30 "thirty" 1)
  (set! (-> the-model n) 2)
  (step "the first gone")
  (set-item! 0 30 "thirty" 1)
  (set-item! 1 40 "forty" 0)
  (set-item! 2 20 "twenty" 0)
  (set! (-> the-model n) 3)
  (step "the order changed, and one new between")
  (set! (-> the-model n) 0)
  (step "none")
  (print-string "unmount it\n")
  (todo.unmount (& a-todo) 1)
  (trace-patches!))
