;; A test of views (lib/web/ui.sub) that needs no browser: typed
;; attributes, and listeners whose messages carry event data. It prints
;; the patches the view writes (lib/web/trace.sub); events.out is the
;; expected output.
;;
;; Attributes: a boolean attribute such as `disabled` takes a condition,
;; and a numeric attribute such as `colspan` takes an integer. Constant
;; attributes are written into the HTML template, not sent as patches.
;;
;; Event data: an argument written (event value), (event key), ... in a
;; listener's message is filled in when the event fires. There is no
;; browser here, so the test supplies the "event" itself, with
;; ui-event-source!, and delivers it to a listener with ui-heard.
(require-unqualified base "../../compiler/base/base.sub")
(require-unqualified ui "../../lib/web/ui.sub")
(require-unqualified trace "../../lib/web/trace.sub")
(require print "../../compiler/print.sub")
(memory from base)
(table from base)

(struct model [id u32] [busy i32] [wide u32] [note (ptr u8)])
(variant msg [typed [text (ptr u8)]] [key [id u32] [name (ptr u8)] [shift i32] [meta i32]] [checked [on i32]] [plain])
(messages msg)

(view (form [m (ptr model)])
  (input ([type "text"] [required] [maxlength 40] [size "8"] [disabled (-> m busy)] [tabindex (-> m wide)]
          [on input (typed (event value))]
          [on keydown (key (-> m id) (event key) (event shift) (event meta))]))
  (input ([type "checkbox"] [checked (not (-> m busy))] [on change (checked (event checked))]))
  (table (tr (td ([colspan (+ (-> m wide) 1)] [data-note (-> m note)] ["x-own" "kept"]) "cell")))
  (my-element ([anything "at all"] [on "my-event" plain]) "own"))

(define the-model model)
(define a-form form.state)

;; The fake event: the value and key text, and the modifier bits (see
;; event-truths in ui.sub). event-text and event-truths hand them to
;; ui.sub.
(define the-value (ptr u8) "")
(define the-key (ptr u8) "")
(define the-truths u32 0)
(define (event-text [which u32]) -> (ptr u8) (if (== which 0) the-value the-key))
(define (event-truths) -> u32 the-truths)
(define (event-number [which u32]) -> f64 0.0)

;; Simulates the fake event arriving at the n-th listener of the last
;; batch, and prints the message that the listener produces.
(define (hear [n u32])
  (match (cast (ptr msg) (ui-heard (trace-listener n)))
    [(typed text) (print-string "typed ") (print-string text)]
    [(key id name shift meta)
     (print-string "key ") (print:write-u64 (cast u64 id)) (print-string " ") (print-string name)
     (print-string (if shift " shift" "")) (print-string (if meta " meta" ""))]
    [(checked on) (print-string (if on "checked" "not checked"))]
    [plain (print-string "plain")])
  (print-string "\n"))

(define (main)
  (set! (-> the-model id) 7)
  (set! (-> the-model busy) 0)
  (set! (-> the-model wide) 2)
  (set! (-> the-model note) "first")
  (print-string "mount\n")
  (form.mount (& a-form) 0 0 (& the-model))
  (trace-patches!)

  (print-string "events with no source\n")
  (hear 0)
  (hear 1)
  (ui-event-source! event-text event-truths event-number)
  (print-string "events\n")
  (set! the-value "hello")
  (set! the-key "Enter")
  (set! the-truths 1)
  (hear 0)
  (hear 1)
  (hear 2)
  (set! the-key "a")
  (set! the-truths 24)
  (hear 1)
  (hear 2)
  (hear 3)

  (print-string "busy, wider, another id\n")
  (set! (-> the-model busy) 1)
  (set! (-> the-model wide) 3)
  (set! (-> the-model id) 8)
  (form.update (& a-form) (& the-model))
  (trace-patches!)
  (set! the-truths 0)
  (hear 1)
  (print-string "nothing changed\n")
  (form.update (& a-form) (& the-model))
  (trace-patches!)
  (print-string "not busy\n")
  (set! (-> the-model busy) 0)
  (form.update (& a-form) (& the-model))
  (trace-patches!))
