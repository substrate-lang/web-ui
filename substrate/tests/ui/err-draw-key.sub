;; The key of [draw key code] must be an integer; this one is a string.
(require-unqualified base "../../compiler/base/base.sub")
(require-unqualified ui "../../lib/web/ui.sub")

(struct model [count i32])
(variant msg [tick [time f64]] [pressed])
(messages msg)
(define (paint [m (ptr model)]) 0)

(view (page [m (ptr model)])
  (canvas ([draw "always" (paint m)])))
(define (main) 0)
