;; A table whose rows are created, updated, swapped and removed, to measure the views.
(require-unqualified "../web-ui.sub")
(require-unqualified std/vector)

(struct row [id u32] [label string])
(struct model [rows (vector row)] [made u32] [selected u32])
(variant message [create] [create-many] [append] [update-some] [swap] [clear] [select [id u32]] [remove [id u32]])
(messages message)

(define adjectives (array string 8))
(define nouns (array string 8))
(define seed u32 1)

(define (random [n u32]) -> u32
  (set! seed (+ (* seed 1103515245) 12345))
  (% (>> seed 16) n))

(define (label) -> string
  (let* ([a (@ adjectives (random 8))] [b (@ nouns (random 8))] [n (-> a length)] [m (-> b length)]
         [p (-> (new 0 u8 (+ n m 1)) items)])
    (memcpy p (-> a bytes) n)
    (set! (@ p n) 32)
    (memcpy (+ p n 1) (-> b bytes) m)
    (cast string (slice p (+ n m 1)))))

(define (add-rows! [m (ptr model)] [n u32])
  (vector-reserve! (& (-> m rows)) (+ (vector-count (& (-> m rows))) n))
  (for ([i u32 0]) (< i n) (+= i 1)
    (let ([r (vector-add! (& (-> m rows)))])
      (+= (-> m made) 1)
      (set! (-> r id) (-> m made))
      (set! (-> r label) (label)))))

(define (clear! [m (ptr model)])
  (vector-each ([r (& (-> m rows))]) (free (-> r label bytes)))
  (vector-clear! (& (-> m rows))))

(define (init [m (ptr model)])
  (set! (@ adjectives 0) "pretty") (set! (@ adjectives 1) "large") (set! (@ adjectives 2) "small")
  (set! (@ adjectives 3) "helpful") (set! (@ adjectives 4) "plain") (set! (@ adjectives 5) "quaint")
  (set! (@ adjectives 6) "clean") (set! (@ adjectives 7) "odd")
  (set! (@ nouns 0) "table") (set! (@ nouns 1) "chair") (set! (@ nouns 2) "house") (set! (@ nouns 3) "desk")
  (set! (@ nouns 4) "car") (set! (@ nouns 5) "pony") (set! (@ nouns 6) "cookie") (set! (@ nouns 7) "keyboard"))

(define (update [m (ptr model)] [e (ptr message)])
  (match e
    [.create (clear! m) (add-rows! m 1000)]
    [.create-many (clear! m) (add-rows! m 10000)]
    [.append (add-rows! m 1000)]
    [.update-some
     (for ([i u32 0]) (< i (vector-count (& (-> m rows)))) (+= i 10)
       (let* ([r (vector-at-unchecked (& (-> m rows)) i)] [n (-> r label length)] [p (-> (new 0 u8 (+ n 4)) items)])
         (memcpy p (-> r label bytes) n)
         (memcpy (+ p n) " !!!" 4)
         (free (-> r label bytes))
         (set! (-> r label) (cast string (slice p (+ n 4))))))]
    [.swap
     (when (> (vector-count (& (-> m rows))) 3)
       (let ([a (vector-at (& (-> m rows)) 1)] [b (vector-at (& (-> m rows)) (- (vector-count (& (-> m rows))) 2))] [t row])
         (set! t (@ a))
         (set! (@ a) (@ b))
         (set! (@ b) t)))]
    [.clear (clear! m)]
    [(.select id) (set! (-> m selected) id)]
    [(.remove id)
     (vector-each ([r i (& (-> m rows))])
       (when (== (-> r id) id)
         (free (-> r label bytes))
         (vector-remove! (& (-> m rows)) i)
         (break)))]))

(view (row-view [r (ptr row)] [m (ptr model)])
  (tr ([class (if (== (-> r id) (-> m selected)) "selected" "")])
    (td ([class "id"]) (int (-> r id)))
    (td (a ([on click (.select (-> r id))]) (text (-> r label))))
    (td (a ([class "remove"] [on click (.remove (-> r id))]) "remove"))))

(component (rows)
  #:state [m model]
  #:messages message
  #:update update
  #:init init
  (nav
    (button ([id "create"] [on click .create]) "create 1,000 rows")
    (button ([id "create-many"] [on click .create-many]) "create 10,000 rows")
    (button ([id "append"] [on click .append]) "append 1,000 rows")
    (button ([id "update"] [on click .update-some]) "update every 10th row")
    (button ([id "swap"] [on click .swap]) "swap rows")
    (button ([id "clear"] [on click .clear]) "clear"))
  (table (tbody (each [r (-> m rows items) (-> m rows count)] #:key (-> r id) (row-view r m)))))

(attach ["root" (rows)])
