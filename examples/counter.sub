;; A counter, the smallest complete web page.
(require-unqualified "../web-ui.sub")

(struct state [count i32])

(variant message [increment] [decrement] [reset])

(define (update [s (ptr state)] [e (ptr message)])
  (match e
    [increment (+= (-> s count) 1)]
    [decrement (-= (-> s count) 1)]
    [reset (set! (-> s count) 0)]))

(component (counter)
  #:state [s state]
  #:messages message
  #:update update
  (div ([class "counter"])
    (button ([on click decrement]) "-")
    (span ([class (if (< (-> s count) 0) "negative" "count")]) (int (-> s count)))
    (button ([on click increment]) "+")
    (when (!= (-> s count) 0) (button ([on click reset]) "reset"))))

(attach ["root" (counter)])
