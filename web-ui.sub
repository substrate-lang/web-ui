;; The language of web user interfaces: ui.sub's views and components, attach, which puts them in elements of the
;; document, render-page, which writes them into a page's HTML, and router.sub's routes.
(require-unqualified ui "ui.sub")
(require-unqualified router "router.sub")
(require-unqualified events host/events)
(require-unqualified dom std/web/dom)
(require-unqualified host/web/location)
(require-unqualified std/http/url)
(require-unqualified std/http/routable)
(require-unqualified std/string)

(provide (all-from-out ui) (all-from-out router) (all-from-out events) (all-from-out dom) attach render-page
         prevent-default! stop-propagation!)

(define (prevent-default!) (dom-call-now! dom-event "preventDefault" (dom-values)))

(define (stop-propagation!) (dom-call-now! dom-event "stopPropagation" (dom-values)))

;; attach-node gives the element with the id. When render-page wrote the element's contents, attach-node takes them out,
;; with the stylesheets that render-page added, for the element's component or view to draw them again.
(define (attach-node [id string]) -> u32
  (let ([n (dom-element id)])
    (when (== n 0)
      (let ([b (make-buffer)])
        (buffer-add-string! (& b) "attach: no element has the id ")
        (buffer-add-string! (& b) id)
        (host-trap (buffer-string (& b)))))
    (when (== (dom-read-text n "firstChild.data") "[")
      (let ([s (dom-call-node dom-document "querySelector" (dom-values (dom-text "style[data-ui]")))])
        (unless (== (dom-read-number s "nodeType") 0.0) (dom-call-now! s "remove" (dom-values)))
        (dom-forget-node! s))
      (dom-call-now! n "replaceChildren" (dom-values)))
    n))

;; The page's own title, which render-page keeps in the title's data-ui attribute when a view gave another.
(define (page-title) -> string
  (let* ([t (dom-call-node dom-document "querySelector" (dom-values (dom-text "title[data-ui]")))]
         [given (if (== (dom-read-number t "nodeType") 0.0) (dom-read-text dom-document "title") (dom-read-text t "dataset.ui"))])
    (dom-forget-node! t)
    given))

(define (attach-start!)
  (ui-read-with! dom-read-text dom-read-number dom-is)
  (ui-flush-with! dom-flush!)
  (ui-title-first! (page-title)))

(define (attach-scroll!)
  (let* ([url (location-href)] [i (string-index url #\#)] [a (make-arena)])
    (when (< (+ i 1) (-> url length))
      (let* ([raw (slice url (+ i 1) (-> url length))] [decoded (url-unescape (& a) raw #f)] [n (dom-element raw)])
        (when (and (== n 0) (!= decoded raw)) (set! n (dom-element decoded)))
        (unless (== n 0)
          (dom-call! n "scrollIntoView")
          (dom-flush!))))
    (arena-free (& a))
    (free (-> url bytes))))

(begin-for-syntax
  (require-unqualified compiler/macros)
  (require-unqualified std/meta/type-info)

  (define (routes-named [t datum] [what datum]) -> datum
    (datum->syntax t (string->symbol (format-message "~a.~a" `(,(syntax-e t) ,what))) t))

  ;; The name of a type, as the run-time checks of #:route compare it.
  (define (type-text [t datum]) -> datum
    (datum->syntax #'here (string->datum (symbol->string (syntax-e (cadr (type-info t))))) 0))

  ;; (attach option ... ["id" (c ([parameter value] ...))] ...) defines main, which puts each component in the element
  ;; with its id. A view, (v e ...), can take a component's place. Once they are drawn, main scrolls to the element that
  ;; the URL's fragment names. The option #:routes T, a routable type, starts the router with the URL read as a T.
  (define (attach-form [s datum]) -> datum
    (syntax-match s
      [(_ given ...)
       (let ([roots nil] [mounts nil] [k u32 0] [items given] [routes datum 0]
             [reader (datum->syntax #'here 'attach-route-read 0)])
         (while (and (pair? items) (keyword? (syntax-e (car items))))
           (let ([word (syntax-e (car items))])
             (unless (pair? (cdr items)) (raise-syntax-error 'attach "expected a value after the option" (car items)))
             (unless (== word '#:routes) (raise-syntax-error 'attach "the option is #:routes TYPE" (car items)))
             (set! routes (cadr items))
             (set! items (cddr items))))
         (for-each (lambda ([p datum])
                     (let ([l (syntax->list p)])
                       (unless (and (!= l 0) (== (length l) 2) (string? (syntax-e (car l))))
                         (raise-syntax-error 'attach "expected [\"id\" (component ([parameter value] ...))] or [\"id\" (view e ...)]" p))
                       (let ([mount (datum->syntax #'here (string->symbol (format-message "mount~a" `(,(make-integer k)))) 0)])
                         (set! roots (cons #`(ui-root #,mount (attach-node #,(car l)) #,(cadr l)) roots))
                         (set! mounts (cons #`(#,mount) mounts))
                         (+= k 1))))
                   items)
         (when (null? roots) (raise-syntax-error 'attach "expected at least one [\"id\" (component ...)] or [\"id\" (view ...)]" s))
         (let ([read (if (== routes 0) 0 (routes-named routes '"url-read"))])
           (unless (or (== routes 0) (== (identifier-binding-kind read) 'function))
             (raise-syntax-error 'attach (format-message "#:routes takes a routable type, and ~a is not one"
                                                         `(,(syntax-e routes)))
                                 routes))
           #`(begin
               #,@(reverse roots)
               #,@(if (== routes 0)
                      nil
                      `(,#`(define (#,reader [a (ptr arena)] [url string] [base string] [r (ptr void)] [to (ptr buffer)])
                             -> u32
                             (#,read a url base (cast (ptr #,routes) r) to))))
               (define (main)
                 (attach-start!)
                 #,@(if (== routes 0)
                        nil
                        `(,#`(router-start! #,reader (sizeof #,routes) #,(type-text routes))))
                 #,@(reverse mounts)
                 (ui-titles!)
                 (dom-flush!)
                 (ui-started!)
                 #,(if (== routes 0) #'(attach-scroll!) #'(router-mounted!))))))]))

  ;; (render-page b page option ... ["id" (c ([parameter value] ...))] ...) writes page, a document's HTML, into the
  ;; buffer b, with the component or view of each id rendered into the element with that id, which must be empty. A view,
  ;; (v e ...), can take a component's place. The views' stylesheets go before </head>, or before the first of those
  ;; elements, and the title a view gives goes in <title>. The options #:routes T, a routable type, and #:url url read
  ;; url as a T for the components that take routes, from the directory of the page's <base> as the router does.
  ;; render-page returns what reading the URL returned, or url-found without #:routes.
  (define (render-page-form [s datum]) -> datum
    (syntax-match s
      [(_ out page given ...)
       (let ([items given] [routes datum 0] [url datum 0] [ids nil] [renders nil] [k u32 0])
         (while (and (pair? items) (keyword? (syntax-e (car items))))
           (let ([word (syntax-e (car items))])
             (unless (pair? (cdr items)) (raise-syntax-error 'render-page "expected a value after the option" (car items)))
             (cond [(== word '#:routes) (set! routes (cadr items))]
                   [(== word '#:url) (set! url (cadr items))]
                   [else (raise-syntax-error 'render-page "the options are #:routes TYPE and #:url URL" (car items))])
             (set! items (cddr items))))
         (unless (== (== routes 0) (== url 0)) (raise-syntax-error 'render-page "#:routes and #:url go together" s))
         (for-each (lambda ([p datum])
                     (let ([l (syntax->list p)])
                       (unless (and (!= l 0) (== (length l) 2) (string? (syntax-e (car l))))
                         (raise-syntax-error 'render-page "expected [\"id\" (component ([parameter value] ...))] or [\"id\" (view e ...)]" p))
                       (set! ids (cons (car l) ids))
                       (set! renders (cons #`(ui-render-root (+ parts #,(datum->syntax #'here (make-integer k) 0)) #,(cadr l))
                                           renders))
                       (+= k 1)))
                   items)
         (when (null? ids) (raise-syntax-error 'render-page "expected at least one [\"id\" (component ...)] or [\"id\" (view ...)]" s))
         (let ([read (if (== routes 0) 0 (routes-named routes '"url-read"))] [n (datum->syntax #'here (make-integer k) 0)])
           (unless (or (== routes 0) (== (identifier-binding-kind read) 'function))
             (raise-syntax-error 'render-page (format-message "#:routes takes a routable type, and ~a is not one"
                                                              `(,(syntax-e routes)))
                                 routes))
           #`(let ([page-html string #,page] [parts (cast (ptr buffer) (calloc #,n (sizeof buffer)))] [read u32 url-found]
                   [route-arena (make-arena)])
               (ui-render-begin!)
               #,@(if (== routes 0)
                      nil
                      `(,#`(let* ([at string #,url] [r (cast (ptr #,routes) (arena-alloc (& route-arena) (sizeof #,routes)))]
                                  [base (page-base (& route-arena) page-html at)])
                             (set! read (#,read (& route-arena) at base r 0))
                             (router-render! at base)
                             (ui-route-set! (cast (ptr void) r) #,(type-text routes)))))
               #,@(reverse renders)
               (page-write! #,out page-html (slice (array-of string #,@(reverse ids))) (slice parts #,n))
               (ui-render-end!)
               (ui-route-set! 0 "")
               (for ([i u32 0]) (< i #,n) (+= i 1) (buffer-free! (+ parts i)))
               (free parts)
               (arena-free (& route-arena))
               read)))])))

(define-syntax attach attach-form)
(define-syntax render-page render-page-form)

;; ---- writing a page ----

(struct page-edit [at u32] [end u32] [text string])

;; The first place in s at or after from where part is, or s's length.
(define (found-from [s string] [part string] [from u32]) -> u32
  (let ([i from])
    (while (<= (+ i (-> part length)) (-> s length))
      (when (== (slice s i (+ i (-> part length))) part) (return i))
      (+= i 1))
    (-> s length)))

;; The place after the > that ends the tag at i, past any quoted values.
(define (tag-end [s string] [i u32]) -> u32
  (let ([q u8 0])
    (while (and (< i (-> s length)) (or (!= q 0) (!= (@ s i) #\>)))
      (cond [(!= q 0) (when (== (@ s i) q) (set! q 0))]
            [(or (== (@ s i) #\") (== (@ s i) #\')) (set! q (@ s i))])
      (+= i 1))
    (if (< i (-> s length)) (+ i 1) i)))

(define (tag-start [s string] [i u32]) -> u32
  (while (and (> i 0) (!= (@ s i) #\<)) (-= i 1))
  i)

(define (page-trap! [what string] [id string])
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) "render-page: ")
    (buffer-add-string! (& b) what)
    (buffer-add-string! (& b) id)
    (host-trap (buffer-string (& b)))))

;; The place of the id attribute of the element with the id.
(define (id-at [page string] [id string]) -> u32
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) " id=\"")
    (buffer-add-string! (& b) id)
    (buffer-add-byte! (& b) #\")
    (let ([at (found-from page (buffer-string (& b)) 0)])
      (buffer-free! (& b))
      (when (== at (-> page length)) (page-trap! "the page has no element with the id " id))
      at)))

(define (edit! [edits (ptr buffer)] [at u32] [end u32] [text string])
  (let ([e (page-edit #:at at #:end end #:text text)])
    (buffer-add! edits (slice (cast (ptr u8) (& e)) (sizeof page-edit)))))

(define (title-edit! [edits (ptr buffer)] [page string] [kept (ptr buffer)])
  (let* ([open (found-from page "<title" 0)] [from (tag-end page open)] [to (found-from page "</title>" from)])
    (when (< to (-> page length))
      (buffer-add-string! kept "<title data-ui=\"")
      (for ([i u32 from]) (< i to) (+= i 1)
        (if (== (@ page i) #\") (buffer-add-string! kept "&quot;") (buffer-add-byte! kept (cast i32 (@ page i)))))
      (buffer-add-string! kept "\">")
      (ui-render-content! kept (ui-render-title))
      (buffer-add-string! kept "</title>")
      (edit! edits open (+ to 8) (buffer-string kept)))))

;; page-write! writes page into out with the parts, in the elements with the ids, and the styles and title rendered.
(define (page-write! [out (ptr buffer)] [page string] [ids (slice string)] [parts (slice buffer)])
  (let ([edits (make-buffer)] [style (make-buffer)] [title (make-buffer)] [first (-> page length)] [pos u32 0])
    (for ([k u32 0]) (< k (-> ids length)) (+= k 1)
      (let* ([at (id-at page (@ ids k))] [end (tag-end page at)])
        (unless (== (found-from page "</" end) end) (page-trap! "this element is not empty: the one with the id " (@ ids k)))
        (when (< (tag-start page at) first) (set! first (tag-start page at)))
        (edit! (& edits) end end (buffer-string (& (@ parts k))))))
    (let ([css (ui-render-styles)] [head (found-from page "</head>" 0)])
      (when (> (-> css length) 0)
        (buffer-add-string! (& style) "<style data-ui>")
        (buffer-add-string! (& style) css)
        (buffer-add-string! (& style) "</style>")
        (let ([at (if (< head (-> page length)) head first)]) (edit! (& edits) at at (buffer-string (& style))))))
    (when (ui-render-titled?) (title-edit! (& edits) page (& title)))
    (let ([es (cast (ptr page-edit) (-> edits bytes))] [n (/ (-> edits length) (sizeof page-edit))])
      (for ([i u32 1]) (< i n) (+= i 1)
        (let ([e (@ es i)] [j i])
          (while (and (> j 0) (< (-> e at) (-> (+ es (- j 1)) at)))
            (set! (@ es j) (@ es (- j 1)))
            (-= j 1))
          (set! (@ es j) e)))
      (for ([i u32 0]) (< i n) (+= i 1)
        (let ([e (+ es i)])
          (buffer-add-string! out (slice page pos (-> e at)))
          (buffer-add-string! out (-> e text))
          (set! pos (-> e end)))))
    (buffer-add-string! out (slice page pos (-> page length)))
    (buffer-free! (& edits))
    (buffer-free! (& style))
    (buffer-free! (& title))))

;; The base of the page at url, as the router reads it: the directory of the page's <base href>, or of url, without its
;; final slash.
(define (page-base [a (ptr arena)] [page string] [url string]) -> string
  (let* ([at (found-from page "<base href=\"" 0)]
         [document (if (< at (-> page length))
                       (let ([from (+ at 12)]) (url-resolve a url (slice page from (found-from page "\"" from))))
                       url)]
         [dir (url-path (url-target (url-resolve a document ".")))])
    (slice dir 0 (if (> (-> dir length) 0) (- (-> dir length) 1) 0))))
