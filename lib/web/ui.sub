;; Views: a small language for describing web pages, compiled to patches.
(require-unqualified events "../../host/events.sub")

(provide view messages
         ui-patches ui-patches-done! ui-frame-alloc
         ui-template ui-clone ui-remove ui-move ui-text ui-attr ui-remove-attr ui-listen
         ui-text-set! ui-text-slot! ui-attr-set! ui-attr-slot! ui-int-set! ui-int-slot! ui-truth-set! ui-truth-slot!
         ui-number-set! ui-number-slot! ui-effect-slot! ui-pointer-lock-slot! ui-listener ui-event-source! ui-event-text
         ui-event-truth ui-event-number ui-heard ui-deliver! ui-send
         ui-canvas-begin ui-canvas-end ui-canvas-drawing? ui-image
         ui-row ui-rows ui-each! ui-each-clear!)

;; ---- run-time support: writing patches ----

(define patches buffer)
(define frame arena)
(define next-id u32 1)
(define next-template u32 1)
(define drawing u32 0)

(define (ui-patches) -> (ptr buffer) (& patches))

(define (ui-patches-done!)
  (set! (-> patches length) 0)
  (set! drawing 0)
  (arena-free (& frame)))

(define (ui-frame-alloc [n u32]) -> (ptr void) (arena-alloc (& frame) n))

(define (words! [w (slice u32)]) (buffer-add! (& patches) (slice (cast (ptr u8) (-> w items)) (* 4 (-> w length)))))

(define (ui-template [html string]) -> u32
  (let ([t next-template])
    (+= next-template 1)
    (words! (slice (array-of u32 1 t (cast u32 (-> html bytes)) (-> html length))))
    t))

(define (ui-clone [t u32] [n u32] [parent u32] [before u32]) -> u32
  (let ([first next-id])
    (+= next-id (+ n 1))
    (words! (slice (array-of u32 2 t first n parent before)))
    first))

(define (ui-remove [first u32] [n u32] [detach bool]) (words! (slice (array-of u32 (if detach 3 4) first n))))
(define (ui-move [first u32] [parent u32] [before u32]) (words! (slice (array-of u32 5 first parent before))))
(define (ui-text [node u32] [s string]) (words! (slice (array-of u32 6 node (cast u32 (-> s bytes)) (-> s length)))))

(define (ui-attr [node u32] [name string] [value string])
  (words! (slice (array-of u32 7 node (cast u32 (-> name bytes)) (-> name length) (cast u32 (-> value bytes))
                           (-> value length)))))

(define (ui-remove-attr [node u32] [name string])
  (words! (slice (array-of u32 8 node (cast u32 (-> name bytes)) (-> name length)))))

(define (ui-listen [node u32] [event string] [message (ptr void)] [window bool])
  (set! (-> (cast (ptr listener-head) message) handle) ui-listener-heard)
  (words! (slice (array-of u32 (if window 12 9) node (cast u32 (-> event bytes)) (-> event length) (cast u32 message)))))

;; ---- run-time support: drawing on a canvas ----

(define (ui-image [id u32] [path string]) (words! (slice (array-of u32 14 id (cast u32 (-> path bytes)) (-> path length)))))

(define (ui-canvas-begin [node u32])
  (words! (slice (array-of u32 13 node 0)))
  (set! drawing (-> patches length)))

(define (ui-canvas-end)
  (when (!= drawing 0)
    (let ([count (cast (ptr u32) (+ (-> patches bytes) (- drawing 4)))])
      (set! (@ count) (/ (- (-> patches length) drawing) 4)))
    (set! drawing 0)))

(define (ui-canvas-drawing?) -> bool (!= drawing 0))

;; ---- run-time support: slots ----

(define (keep-text! [cache (ptr string)] [s string]) -> bool
  (when (== (@ cache) s) (return #f))
  (free (-> (@ cache) bytes))
  (set! (@ cache) (string-copy s))
  #t)

(define (ui-text-set! [cache (ptr string)] [node u32] [s string])
  (set! (@ cache) (string-copy s))
  (ui-text node (@ cache)))

(define (ui-text-slot! [cache (ptr string)] [node u32] [s string])
  (when (keep-text! cache s) (ui-text node (@ cache))))

(define (ui-attr-set! [cache (ptr string)] [node u32] [name string] [s string])
  (set! (@ cache) (string-copy s))
  (ui-attr node name (@ cache)))

(define (ui-attr-slot! [cache (ptr string)] [node u32] [name string] [s string])
  (when (keep-text! cache s) (ui-attr node name (@ cache))))

(define (int-text [n i64]) -> string
  (let* ([p (cast (ptr u8) (ui-frame-alloc 24))] [i u32 24] [u u64 (if (< n 0) (- 0 n) n)])
    (while #t
      (-= i 1)
      (set! (@ p i) (+ 48 (cast i32 (% u 10))))
      (set! u (/ u 10))
      (when (== u 0) (break)))
    (when (< n 0)
      (-= i 1)
      (set! (@ p i) 45))
    (cast string (slice (+ p i) (- 24 i)))))

(define (ui-int-set! [cache (ptr i64)] [node u32] [n i64])
  (set! (@ cache) n)
  (ui-text node (int-text n)))

(define (ui-int-slot! [cache (ptr i64)] [node u32] [n i64])
  (when (!= (@ cache) n) (ui-int-set! cache node n)))

(define (ui-truth-set! [cache (ptr bool)] [node u32] [name string] [on bool])
  (set! (@ cache) on)
  (when on (ui-attr node name "")))

(define (ui-truth-slot! [cache (ptr bool)] [node u32] [name string] [on bool])
  (when (!= (@ cache) on)
    (set! (@ cache) on)
    (if on (ui-attr node name "") (ui-remove-attr node name))))

(define (ui-number-set! [cache (ptr i64)] [node u32] [name string] [n i64])
  (set! (@ cache) n)
  (ui-attr node name (int-text n)))

(define (ui-number-slot! [cache (ptr i64)] [node u32] [name string] [n i64])
  (when (!= (@ cache) n) (ui-number-set! cache node name n)))

(define (ui-effect-slot! [cache (ptr i64)] [node u32] [n i64] [op u32])
  (when (!= (@ cache) n)
    (set! (@ cache) n)
    (words! (slice (array-of u32 op node)))))

(define (ui-pointer-lock-slot! [cache (ptr i64)] [node u32] [n i64])
  (when (!= (@ cache) n)
    (set! (@ cache) n)
    (words! (slice (array-of u32 15 node (if (!= n 0) 1 0))))))

;; ---- run-time support: event listeners ----

(struct #:forall (M) ui-listener [handle handler] [fill (fn ((ptr void)))] [message M])
(struct listener-head [handle handler] [fill (fn ((ptr void)))])

(define delivery (fn ((ptr void))) 0)

(define (ui-deliver! [f (fn ((ptr void)))]) (set! delivery f))

(define (ui-send [e (ptr void)])
  (let ([f delivery])
    (when (!= f 0) (f e))))

(define (ui-listener-heard [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32]) (ui-send (ui-heard tag)))

(define event-text (fn (u32) -> string) 0)
(define event-truths (fn () -> u32) 0)
(define event-numbers (fn (u32) -> f64) 0)

(define (ui-event-source! [text (fn (u32) -> string)] [truths (fn () -> u32)] [numbers (fn (u32) -> f64)])
  (set! event-text text)
  (set! event-truths truths)
  (set! event-numbers numbers))

(define (ui-event-text [which u32]) -> string
  (let ([f event-text])
    (if (== f 0) "" (f which))))

(define (ui-event-truth [bit u32]) -> bool
  (let ([f event-truths])
    (and (!= f 0) (!= (bit-and (f) bit) 0))))

(define (ui-event-number [which u32]) -> f64
  (let ([f event-numbers])
    (if (== f 0) 0.0 (f which))))

(define (ui-heard [at (ptr void)]) -> (ptr void)
  (let ([fill (-> (cast (ptr listener-head) at) fill)] [message (cast (ptr void) (+ (cast (ptr u8) at) 8))])
    (when (!= fill 0) (fill message))
    message))

;; ---- run-time support: each ----

(struct ui-row [key u64] [state (ptr void)])
(struct ui-rows [items (ptr ui-row)] [count u32])

;; Every instance state begins with the number of its copy.
(define (first-of [state (ptr void)]) -> u32 (@ (cast (ptr u32) state)))

(define (table-key [key u64]) -> u64 (bit-or (<< key 1) 1))

(define (ui-each! [b (ptr ui-rows)] [parent u32] [anchor u32] [n u32] [size u32]
                  [key-of (closure (u32) -> u64)]
                  [mount (closure (u32 (ptr void) u32 u32))]
                  [update (closure (u32 (ptr void)))]
                  [unmount (closure ((ptr void) bool))])
  (let ([old (-> b items)] [m (-> b count)] [p u32 0] [s u32 0])
    (while (and (< p m) (< p n) (== (-> (+ old p) key) (key-of p)))
      (update p (-> (+ old p) state))
      (+= p 1))
    (when (and (== p m) (== p n)) (return))
    (while (and (< s (- m p)) (< s (- n p)) (== (-> (+ old (- m 1 s)) key) (key-of (- n 1 s)))) (+= s 1))
    (let* ([rows (cast (ptr ui-row) (malloc (* (+ n 1) (sizeof ui-row))))]
           [middle (- m p s)] [between (- n p s)]
           [used (cast (ptr u8) (calloc (+ middle 1) 1))]
           [from (cast (ptr i32) (malloc (* 4 (+ between 1))))]
           [stays (cast (ptr u8) (calloc (+ between 1) 1))]
           [index hash-table])
      (memset (& index) 0 (sizeof hash-table))
      (memcpy rows old (* p (sizeof ui-row)))
      (for ([i u32 0]) (< i middle) (+= i 1)
        (hash-set! (& index) (table-key (-> (+ old (+ p i)) key)) (+ i 1)))
      (for ([j u32 0]) (< j between) (+= j 1)
        (let* ([k (key-of (+ p j))] [i (hash-ref (& index) (table-key k))] [r (+ rows (+ p j))])
          (set! (-> r key) k)
          (if (and (!= i 0) (== (-> (+ old (+ p (- i 1))) key) k) (not (@ used (- i 1))))
              (begin
                (set! (@ used (- i 1)) 1)
                (set! (@ from j) (cast i32 (- i 1)))
                (set! (-> r state) (-> (+ old (+ p (- i 1))) state)))
              (begin
                (set! (@ from j) -1)
                (set! (-> r state) 0)))))
      (for ([i u32 0]) (< i middle) (+= i 1)
        (unless (@ used i)
          (let ([state (-> (+ old (+ p i)) state)])
            (unmount state #t)
            (free state))))
      (for ([i u32 0]) (< i s) (+= i 1)
        (set! (@ rows (+ (- n s) i)) (@ old (+ (- m s) i)))
        (update (+ (- n s) i) (-> (+ rows (+ (- n s) i)) state)))
      (longest-rising (slice from between) (slice stays between))
      (let ([j between])
        (while (> j 0)
          (-= j 1)
          (let* ([at (+ p j)] [r (+ rows at)]
                 [before (if (< (+ at 1) n) (first-of (-> (+ rows (+ at 1)) state)) anchor)])
            (cond [(== (-> r state) 0)
                   (set! (-> r state) (malloc size))
                   (mount at (-> r state) parent before)]
                  [else
                   (update at (-> r state))
                   (unless (@ stays j) (ui-move (first-of (-> r state)) parent before))]))))
      (hash-free! (& index))
      (free used)
      (free from)
      (free stays)
      (free old)
      (set! (-> b items) rows)
      (set! (-> b count) n))))

(define (longest-rising [xs (slice i32)] [stays (slice u8)])
  (let* ([n (-> xs length)] [ends (cast (ptr u32) (malloc (* 4 (+ n 1))))] [before (cast (ptr i32) (malloc (* 4 (+ n 1))))]
         [length u32 0])
    (for ([i u32 0]) (< i n) (+= i 1)
      (when (>= (@ xs i) 0)
        (let ([lo u32 0] [hi length])
          (while (< lo hi)
            (let ([mid (/ (+ lo hi) 2)])
              (if (< (@ xs (@ ends mid)) (@ xs i)) (set! lo (+ mid 1)) (set! hi mid))))
          (set! (@ before i) (if (> lo 0) (cast i32 (@ ends (- lo 1))) -1))
          (set! (@ ends lo) i)
          (when (== lo length) (+= length 1)))))
    (let ([i i32 (if (> length 0) (cast i32 (@ ends (- length 1))) -1)])
      (while (>= i 0)
        (set! (@ stays i) 1)
        (set! i (@ before i))))
    (free ends)
    (free before)))

(define (ui-each-clear! [b (ptr ui-rows)] [detach bool] [unmount (closure ((ptr void) bool))])
  (for ([i u32 0]) (< i (-> b count)) (+= i 1)
    (let ([state (-> (+ (-> b items) i) state)])
      (unmount state detach)
      (free state)))
  (free (-> b items))
  (set! (-> b items) 0)
  (set! (-> b count) 0))

;; ---- the `view` macro ----

(begin-for-syntax
  (require-unqualified macros "../../compiler/macros.sub")

  (struct block [html buffer] [nodes u32] [fields datum] [mount datum] [update datum] [unmount datum]
          [state datum] [template datum] [unmounter datum])

  (define view-name datum 0)
  (define message-type datum 0)
  (define blocks u32 0)
  (define fields u32 0)
  (define fills datum 0)
  (define definitions datum 0)
  (define in-rows bool #f)

  (define (fail [where datum] [message datum]) -> datum (raise-syntax-error 'view (datum->string message) where))

  (define (literal [d datum]) -> datum (datum->syntax #'here d 0))
  (define (number [n u32]) -> datum (literal (make-integer n)))

  (define (named [what datum]) -> datum
    (datum->syntax view-name (string->symbol (format-message "~a.~a" `(,(syntax-e view-name) ,what))) view-name))

  (define (new-block [top bool]) -> (ptr block)
    (let ([b (cast (ptr block) (arena-alloc (current-arena) (sizeof block)))] [n blocks])
      (+= blocks 1)
      (set! (-> b html) (make-buffer))
      (set! (-> b nodes) 0)
      (set! (-> b fields) nil)
      (set! (-> b mount) nil)
      (set! (-> b update) nil)
      (set! (-> b unmount) nil)
      (set! (-> b state) (named (if top '"state" (format "block~a" `(,(make-integer n))))))
      (set! (-> b template) (named (format "template~a" `(,(make-integer n)))))
      (set! (-> b unmounter) (named (if top '"unmount" (format "unmount~a" `(,(make-integer n))))))
      b))

  ;; ---- helpers for building a block ----

  (define (html! [b (ptr block)] [s string]) (buffer-add-string! (& (-> b html)) s))

  (define (html-escaped! [b (ptr block)] [s string] [value bool])
    (for ([i u32 0]) (< i (-> s length)) (+= i 1)
      (let ([c (@ s i)])
        (cond [(== c #\&) (html! b "&amp;")]
              [(== c #\<) (html! b "&lt;")]
              [(== c #\>) (html! b "&gt;")]
              [(and value (== c 34)) (html! b "&quot;")]
              [else (buffer-add-byte! (& (-> b html)) c)]))))

  (define (node! [b (ptr block)]) -> datum
    (+= (-> b nodes) 1)
    #`(+ (-> bs first) #,(number (-> b nodes))))

  (define (field! [b (ptr block)] [type datum]) -> datum
    (let ([f (literal (string->symbol (format-message "f~a" `(,(make-integer fields)))))])
      (+= fields 1)
      (set! (-> b fields) (cons #`[#,f #,type] (-> b fields)))
      f))

  (define (mount! [b (ptr block)] [code datum]) (set! (-> b mount) (cons code (-> b mount))))
  (define (update! [b (ptr block)] [code datum]) (set! (-> b update) (cons code (-> b update))))
  (define (unmount! [b (ptr block)] [code datum]) (set! (-> b unmount) (cons code (-> b unmount))))
  (define (both! [b (ptr block)] [code datum]) (mount! b code) (update! b code))

  (define (statements [code datum]) -> datum (if (null? code) `(,#'(begin)) (reverse code)))

  (define (mount-code [b (ptr block)]) -> datum
    (let ([html (literal (string->datum (buffer-string (& (-> b html)))))])
      `(,#`(when (== #,(-> b template) 0) (set! #,(-> b template) (ui-template #,html)))
        ,#`(set! (-> bs first) (ui-clone #,(-> b template) #,(number (-> b nodes)) parent before))
        ,@(reverse (-> b mount)))))

  (define (finish! [b (ptr block)])
    (set! definitions
          (append `(,#`(define (#,(-> b unmounter) [bs (ptr #,(-> b state))] [detach bool])
                         #,@(reverse (-> b unmount))
                         (ui-remove (-> bs first) #,(number (-> b nodes)) detach))
                    ,#`(define #,(-> b template) u32 0)
                    ,#`(struct #,(-> b state) [first u32] #,@(reverse (-> b fields))))
                  definitions)))

  ;; ---- the HTML vocabulary ----

  (define elements datum
    '(a abbr address area article aside audio b base bdi bdo blockquote body br button canvas caption cite code col colgroup
      data datalist dd del details dfn dialog div dl dt em embed fieldset figcaption figure footer form h1 h2 h3 h4 h5 h6
      head header hgroup hr html i iframe img input ins kbd label legend li link main map mark menu meta meter nav noscript
      object ol optgroup option output p picture pre progress q rp rt ruby s samp script search section select slot small
      source span strong style sub summary sup table tbody td template textarea tfoot th thead time title tr track u ul var
      video wbr))

  (define void-elements datum '(area base br col embed hr img input link meta source track wbr))

  (define global-attributes datum
    '(accesskey autocapitalize autocorrect autofocus class contenteditable dir draggable enterkeyhint exportparts hidden id
      inert inputmode is itemid itemprop itemref itemscope itemtype lang nonce part popover role slot spellcheck style
      tabindex title translate writingsuggestions))

  (define element-attributes datum
    '((a download href hreflang ping referrerpolicy rel target type)
      (area alt coords download href ping referrerpolicy rel shape target)
      (audio autoplay controls crossorigin loop muted preload src)
      (base href target)
      (blockquote cite)
      (button command commandfor disabled form formaction formenctype formmethod formnovalidate formtarget name popovertarget
              popovertargetaction type value)
      (canvas height width)
      (col span)
      (colgroup span)
      (data value)
      (del cite datetime)
      (details name open)
      (dialog closedby open)
      (embed height src type width)
      (fieldset disabled form name)
      (form accept-charset action autocomplete enctype method name novalidate rel target)
      (iframe allow allowfullscreen height loading name referrerpolicy sandbox src srcdoc width)
      (img alt crossorigin decoding fetchpriority height ismap loading referrerpolicy sizes src srcset usemap width)
      (input accept alpha alt autocomplete checked colorspace dirname disabled form formaction formenctype formmethod
             formnovalidate formtarget height list max maxlength min minlength multiple name pattern placeholder popovertarget
             popovertargetaction readonly required size src step type value width)
      (ins cite datetime)
      (label for)
      (li value)
      (link as blocking color crossorigin disabled fetchpriority href hreflang imagesizes imagesrcset integrity media
            referrerpolicy rel sizes type)
      (map name)
      (meta charset content http-equiv media name)
      (meter high low max min optimum value)
      (object data form height name type width)
      (ol reversed start type)
      (optgroup disabled label)
      (option disabled label selected value)
      (output for form name)
      (progress max value)
      (q cite)
      (script async blocking crossorigin defer fetchpriority integrity nomodule referrerpolicy src type)
      (select autocomplete disabled form multiple name required size value)
      (slot name)
      (source height media sizes src srcset type width)
      (style blocking media)
      (td colspan headers rowspan)
      (template shadowrootclonable shadowrootdelegatesfocus shadowrootmode shadowrootserializable)
      (textarea autocomplete cols dirname disabled form maxlength minlength name placeholder readonly required rows value wrap)
      (th abbr colspan headers rowspan scope)
      (time datetime)
      (track default kind label src srclang)
      (video autoplay controls crossorigin height loop muted playsinline poster preload src width)))

  (define truth-attributes datum
    '(allowfullscreen async autofocus autoplay checked controls default defer disabled formnovalidate hidden inert ismap
      itemscope loop multiple muted nomodule novalidate open playsinline readonly required reversed selected
      shadowrootclonable shadowrootdelegatesfocus shadowrootserializable))
  (define number-attributes datum '(cols colspan height maxlength minlength rows rowspan size span start tabindex width))

  (define events datum
    '(abort animationcancel animationend animationiteration animationstart auxclick beforeinput beforetoggle blur cancel
      canplay canplaythrough change click close compositionend compositionstart compositionupdate contextmenu copy cut
      dblclick drag dragend dragenter dragleave dragover dragstart drop durationchange ended error focus focusin focusout
      input invalid keydown keypress keyup load loadeddata loadedmetadata mousedown mouseenter mouseleave mousemove
      mouseout mouseover mouseup paste pause play playing pointercancel pointerdown pointerenter pointerleave pointermove
      pointerout pointerover pointerup progress reset scroll scrollend seeked seeking select submit timeupdate toggle
      touchcancel touchend touchmove touchstart transitioncancel transitionend transitionrun transitionstart volumechange
      wheel))

  (define window-events datum '(frame resize hashchange popstate online offline visibilitychange pointerlockchange pointerlockerror))

  (define (starts? [s datum] [prefix string]) -> bool
    (let ([name (symbol->string s)])
      (and (>= (-> name length) (-> prefix length)) (== (slice name 0 (-> prefix length)) prefix))))

  (define (own-element? [tag datum]) -> bool
    (let ([p (symbol->string tag)] [hyphens 0])
      (for ([i u32 0]) (< i (-> p length)) (+= i 1)
        (let ([c (@ p i)])
          (cond [(== c #\-) (+= hyphens 1)]
                [(and (>= c #\a) (<= c #\z)) (begin)]
                [(and (> i 0) (or (and (>= c #\0) (<= c #\9)) (== c #\.) (== c #\_))) (begin)]
                [else (return #f)])))
      (and (> hyphens 0) (!= (@ p 0) #\-))))

  (define (attribute-name? [s string]) -> bool
    (for ([i u32 0]) (< i (-> s length)) (+= i 1)
      (let ([c (@ s i)])
        (when (or (<= c 32) (== c 34) (== c 39) (== c #\>) (== c #\/) (== c #\=) (== c 127)) (return #f))))
    (> (-> s length) 0))

  (define (attribute-of? [tag datum] [name datum]) -> bool
    (or (own-element? tag) (starts? name "data-") (starts? name "aria-")
        (!= (memq name global-attributes) 0)
        (let ([own (assq tag element-attributes)]) (and (!= own 0) (!= (memq name (cdr own)) 0)))))

  ;; ---- compiling a block's children ----

  (define (view-of [head datum]) -> datum
    (if (== (identifier-binding-kind head) 'compile-time-value)
        (let ([v (syntax-local-value head)])
          (if (and (pair? v) (== (car v) 'ui-view)) v 0))
        0))

  (define (view-names [v datum]) -> datum (syntax->list (cadr v)))

  (define (check-arguments! [f datum] [v datum] [arguments datum])
    (let ([n (length (syntax->list (caddr v)))])
      (unless (== (length arguments) n)
        (fail f (format "the view ~a takes ~a argument~a, but this passes ~a"
                        `(,(syntax-e (car (syntax->list f))) ,(make-integer n) ,(if (== n 1) '"" '"s")
                          ,(make-integer (length arguments))))))))

  (define (attributes? [x datum]) -> bool
    (let ([l (syntax->list x)])
      (and (!= l 0) (or (null? l) (not (identifier? (car l)))))))

  (define (compile-children! [b (ptr block)] [children datum])
    (while (pair? children)
      (compile-child! b (car children))
      (set! children (cdr children))))

  (define (compile-child! [b (ptr block)] [f datum])
    (let ([e (syntax-e f)] [l (syntax->list f)])
      (cond [(string? e) (html-escaped! b (datum->string e) #f)]
            [(or (== l 0) (null? l) (not (identifier? (car l))))
             (fail f '"expected a child: text in quotes, an element (tag ...), (text e), (int e), (if c child child), (when c child ...), (each [x items n] #:key k child ...) or a view (v e ...)")]
            [else
             (let ([word (syntax-e (car l))])
               (cond [(== word 'text) (text! b f l)]
                     [(== word 'int) (int! b f l)]
                     [(== word 'if) (if! b f l)]
                     [(== word 'when) (when! b f l)]
                     [(== word 'each) (each! b f l)]
                     [(!= (view-of (car l)) 0) (call! b f l (view-of (car l)))]
                     [else (element! b f l)]))])))

  (define (text! [b (ptr block)] [f datum] [l datum])
    (unless (== (length l) 2) (fail f '"expected (text e)"))
    (html! b "<!--t-->")
    (let ([node (node! b)] [slot (field! b #'string)])
      (mount! b #`(ui-text-set! (& (-> bs #,slot)) #,node #,(cadr l)))
      (update! b #`(ui-text-slot! (& (-> bs #,slot)) #,node #,(cadr l)))
      (unmount! b #`(free (-> bs #,slot bytes)))))

  (define (int! [b (ptr block)] [f datum] [l datum])
    (unless (== (length l) 2) (fail f '"expected (int e)"))
    (html! b "<!--t-->")
    (let ([node (node! b)] [slot (field! b #'i64)])
      (mount! b #`(ui-int-set! (& (-> bs #,slot)) #,node #,(cadr l)))
      (update! b #`(ui-int-slot! (& (-> bs #,slot)) #,node #,(cadr l)))))

  (define (element! [b (ptr block)] [f datum] [l datum])
    (let* ([tag (syntax-e (car l))]
           [given (and (pair? (cdr l)) (attributes? (cadr l)))]
           [attributes (if given (syntax->list (cadr l)) nil)]
           [children (if given (cddr l) (cdr l))]
           [node datum 0])
      (when (or (== tag 'svg) (== tag 'math))
        (fail (car l) (format "~a is not supported: a view can contain HTML elements only, not SVG or MathML" `(,tag))))
      (unless (or (!= (memq tag elements) 0) (own-element? tag))
        (fail (car l) (format "unknown element ~a: it is not an HTML element or a view (a custom element's name must be lower-case and contain a hyphen)" `(,tag))))
      (html! b "<")
      (html! b (symbol->string tag))
      (while (pair? attributes)
        (let* ([a (car attributes)] [al (syntax->list a)])
          (unless (and (!= al 0) (pair? al) (or (identifier? (car al)) (string? (syntax-e (car al)))))
            (fail a '"expected [name value], [name], [on event message], [draw key code], [node place], [focus e], [scroll-end e] or [pointer-lock e]"))
          (attribute! b tag a al (& node)))
        (set! attributes (cdr attributes)))
      (html! b ">")
      (if (!= (memq tag void-elements) 0)
          (unless (null? children) (fail f (format "the element ~a cannot have children" `(,tag))))
          (begin
            (compile-children! b children)
            (html! b "</")
            (html! b (symbol->string tag))
            (html! b ">")))))

  (define (marked! [b (ptr block)] [node (ptr datum)]) -> datum
    (when (== (@ node) 0)
      (set! (@ node) (node! b))
      (html! b " data-n"))
    (@ node))

  (define (html-attribute! [b (ptr block)] [name datum] [value datum])
    (html! b " ")
    (html! b (symbol->string name))
    (when (!= value 0)
      (html! b "=\"")
      (html-escaped! b (datum->string value) #t)
      (html! b "\"")))

  (define (attribute! [b (ptr block)] [tag datum] [a datum] [al datum] [node (ptr datum)])
    (let* ([word (syntax-e (car al))] [checked (symbol? word)] [name (if checked word (string->symbol (datum->string word)))])
      (unless (attribute-name? (symbol->string name))
        (fail (car al) '"invalid attribute name: it must not be empty or contain spaces, quotes, >, / or ="))
      (cond [(and checked (== name 'on)) (listener! b a al node #f)]
            [(and checked (== name 'on-window)) (listener! b a al node #t)]
            [(and checked (== name 'draw)) (draw! b tag a al node)]
            [(and checked (== name 'node))
             (unless (== (length al) 2) (fail a '"expected [node place]"))
             (mount! b #`(set! #,(cadr al) #,(marked! b node)))]
            [(and checked (or (== name 'focus) (== name 'scroll-end)))
             (unless (== (length al) 2) (fail a '"expected [focus e] or [scroll-end e]"))
             (let ([slot (field! b #'i64)] [at (marked! b node)])
               (mount! b #`(set! (-> bs #,slot) #,(cadr al)))
               (update! b #`(ui-effect-slot! (& (-> bs #,slot)) #,at #,(cadr al) #,(number (if (== name 'focus) 10 11)))))]
            [(and checked (== name 'pointer-lock))
             (unless (== (length al) 2) (fail a '"expected [pointer-lock e]"))
             (let ([slot (field! b #'i64)] [at (marked! b node)])
               (mount! b #`(set! (-> bs #,slot) #,(cadr al)))
               (update! b #`(ui-pointer-lock-slot! (& (-> bs #,slot)) #,at #,(cadr al))))]
            [(== name 'data-n) (fail (car al) '"the attribute data-n is reserved: ui.sub uses it to mark elements")]
            [(and checked (not (attribute-of? tag name)))
             (fail (car al) (format "unknown attribute ~a for the element ~a (to use an attribute that HTML does not define, write its name as a string: [\"~a\" value])" `(,name ,tag ,name)))]
            [(and checked (!= (memq name truth-attributes) 0)) (truth-attribute! b a al name node)]
            [(and checked (!= (memq name number-attributes) 0)) (number-attribute! b a al name node)]
            [else (text-attribute! b tag a al name node)])))

  (define (text-attribute! [b (ptr block)] [tag datum] [a datum] [al datum] [name datum] [node (ptr datum)])
    (unless (== (length al) 2) (fail a (format "expected [~a e], where e is a string" `(,name))))
    (let ([v (cadr al)])
      (if (and (string? (syntax-e v)) (not (and (== name 'value) (or (== tag 'textarea) (== tag 'select)))))
          (html-attribute! b name (syntax-e v))
          (let ([slot (field! b #'string)] [at (marked! b node)])
            (mount! b #`(ui-attr-set! (& (-> bs #,slot)) #,at #,(literal (string->datum (symbol->string name))) #,v))
            (update! b #`(ui-attr-slot! (& (-> bs #,slot)) #,at #,(literal (string->datum (symbol->string name))) #,v))
            (unmount! b #`(free (-> bs #,slot bytes)))))))

  (define (truth-attribute! [b (ptr block)] [a datum] [al datum] [name datum] [node (ptr datum)])
    (cond [(== (length al) 1) (html-attribute! b name 0)]
          [(or (!= (length al) 2) (string? (syntax-e (cadr al))))
           (fail a (format "~a is a boolean attribute: write [~a], or [~a e] where e is a condition" `(,name ,name ,name)))]
          [else
           (let ([slot (field! b #'bool)] [at (marked! b node)] [text (literal (string->datum (symbol->string name)))])
             (mount! b #`(ui-truth-set! (& (-> bs #,slot)) #,at #,text #,(cadr al)))
             (update! b #`(ui-truth-slot! (& (-> bs #,slot)) #,at #,text #,(cadr al))))]))

  (define (number-attribute! [b (ptr block)] [a datum] [al datum] [name datum] [node (ptr datum)])
    (unless (== (length al) 2) (fail a (format "expected [~a n], where n is an integer" `(,name))))
    (let* ([v (cadr al)] [d (syntax-e v)])
      (cond [(string? d) (html-attribute! b name d)]
            [(integer? d) (html-attribute! b name (format "~a" `(,d)))]
            [else
             (let ([slot (field! b #'i64)] [at (marked! b node)] [text (literal (string->datum (symbol->string name)))])
               (mount! b #`(ui-number-set! (& (-> bs #,slot)) #,at #,text #,v))
               (update! b #`(ui-number-slot! (& (-> bs #,slot)) #,at #,text #,v)))])))

  (define (draw! [b (ptr block)] [tag datum] [a datum] [al datum] [node (ptr datum)])
    (unless (== tag 'canvas) (fail (car al) '"draw can only be used on a canvas element"))
    (unless (== (length al) 3) (fail a '"expected [draw key code]"))
    (let ([slot (field! b #'i64)] [at (marked! b node)] [key (cadr al)] [code (caddr al)])
      (mount! b #`(let ([key i64 #,key])
                    (set! (-> bs #,slot) key)
                    (ui-canvas-begin #,at)
                    #,code
                    (ui-canvas-end)))
      (update! b #`(let ([key i64 #,key])
                     (when (!= (-> bs #,slot) key)
                       (set! (-> bs #,slot) key)
                       (ui-canvas-begin #,at)
                       #,code
                       (ui-canvas-end))))))

  (define (listener! [b (ptr block)] [a datum] [al datum] [node (ptr datum)] [window bool])
    (unless (== (length al) 3) (fail a (if window '"expected [on-window event message]" '"expected [on event message]")))
    (when (== message-type 0) (fail a '"a listener needs a message type: add (messages TYPE) to this module, before the view"))
    (let* ([event (syntax-e (cadr al))] [m (caddr al)] [filled (event-fill m)]
           [slot (field! b #`(ui-listener #,message-type))] [at (marked! b node)])
      (when (and (not window) (symbol? event) (!= (memq event window-events) 0))
        (fail (cadr al) (format "~a is an event of the window, not of an element: write [on-window ~a message]" `(,event ,event))))
      (unless (or (string? event)
                  (and (symbol? event)
                       (or (!= (memq event events) 0) (and window (!= (memq event window-events) 0)))))
        (fail (cadr al) (format "unknown event ~s (to listen for an event that the DOM does not define, write its name as a string: [~a \"~a\" message])"
                                `(,event ,(if window 'on-window 'on) ,event))))
      (mount! b #`(set! (-> bs #,slot fill) #,(if (== filled 0) #'0 (cdr filled))))
      (both! b #`(set! (-> bs #,slot message) #,(if (== filled 0) m (car filled))))
      (mount! b #`(ui-listen #,at #,(literal (if (string? event) event (string->datum (symbol->string event)))) (& (-> bs #,slot))
                             #,(literal (boolean window))))))

  (define (event-data [x datum]) -> datum
    (let ([l (syntax->list x)])
      (if (and (!= l 0) (== (length l) 2) (identifier? (car l)) (== (syntax-e (car l)) 'event))
          (let ([d (syntax-e (cadr l))])
            (cond [(== d 'value) (cons #'string #'(ui-event-text 0))]
                  [(== d 'key) (cons #'string #'(ui-event-text 1))]
                  [(== d 'shift) (cons #'bool #'(ui-event-truth 1))]
                  [(== d 'control) (cons #'bool #'(ui-event-truth 2))]
                  [(== d 'alt) (cons #'bool #'(ui-event-truth 4))]
                  [(== d 'meta) (cons #'bool #'(ui-event-truth 8))]
                  [(== d 'checked) (cons #'bool #'(ui-event-truth 16))]
                  [(== d 'locked) (cons #'bool #'(ui-event-truth 32))]
                  [(== d 'time) (cons #'f64 #'(ui-event-number 0))]
                  [(== d 'x) (cons #'i32 #'(cast i32 (ui-event-number 1)))]
                  [(== d 'y) (cons #'i32 #'(cast i32 (ui-event-number 2)))]
                  [(== d 'movement-x) (cons #'i32 #'(cast i32 (ui-event-number 3)))]
                  [(== d 'movement-y) (cons #'i32 #'(cast i32 (ui-event-number 4)))]
                  [(== d 'button) (cons #'i32 #'(cast i32 (ui-event-number 5)))]
                  [else (fail x '"unknown event data: expected (event value), (event key), (event shift), (event control), (event alt), (event meta), (event checked), (event locked), (event time), (event x), (event y), (event movement-x), (event movement-y) or (event button)")]))
          0)))

  (define (event-fill [m datum]) -> datum
    (let ([parts (syntax->list m)] [arguments nil] [variables nil] [sets nil] [i u32 0])
      (when (or (== parts 0) (null? parts) (not (identifier? (car parts)))) (return 0))
      (for-each (lambda ([x datum])
                  (let ([data (event-data x)])
                    (if (== data 0)
                        (begin
                          (set! arguments (cons x arguments))
                          (set! variables (cons #'_ variables)))
                        (let ([field (literal (string->symbol (format-message "d~a" `(,(make-integer i)))))]
                              [d (cadr (syntax->list x))])
                          (set! arguments (cons (syntax-rewrap d (syntax-e #`(let ([z #,(car data)]) z))) arguments))
                          (set! variables (cons field variables))
                          (set! sets (cons #`(let ([#,d #,(car data) #,(cdr data)]) (set! #,field #,d)) sets))))
                    (+= i 1)))
                (cdr parts))
      (when (null? sets) (return 0))
      (let ([fill (named (format "fill~a" `(,(make-integer (length fills)))))]
            [others (if (one-case-message-type?) nil `(,#'[_ (begin)]))])
        (set! fills
              (cons #`(define (#,fill [at (ptr void)])
                        (match (cast (ptr #,message-type) at)
                          [(#,(car parts) #,@(reverse variables)) #,@(reverse sets)]
                          #,@others))
                    fills))
        (cons (syntax-rewrap m (cons (car parts) (reverse arguments))) fill))))

  ;; A variant's name is bound to the syntax (substrate-struct name (case ...) variant (parameter ...)).
  (define (one-case-message-type?) -> bool
    (if (== (identifier-binding-kind message-type) 'compile-time-value)
        (syntax-match (syntax-local-value message-type)
          [('substrate-struct _ (c) 'variant _) #t]
          [_ #f])
        #f))

  (define (if! [b (ptr block)] [f datum] [l datum])
    (unless (or (== (length l) 3) (== (length l) 4)) (fail f '"expected (if c child) or (if c child child)"))
    (branches! b (cadr l) (cons (caddr l) nil) (if (== (length l) 4) (cons (cadddr l) nil) 0)))

  (define (when! [b (ptr block)] [f datum] [l datum])
    (unless (>= (length l) 3) (fail f '"expected (when c child ...)"))
    (branches! b (cadr l) (cddr l) 0))

  (define (branches! [b (ptr block)] [c datum] [then datum] [other datum])
    (html! b "<!--a-->")
    (let* ([anchor (node! b)] [which (field! b #'i32)] [state (field! b #'(ptr void))]
           [one (new-block #f)] [two (ptr block) (if (== other 0) 0 (new-block #f))])
      (compile-children! one then)
      (finish! one)
      (when (!= two 0)
        (compile-children! two other)
        (finish! two))
      (mount! b #`(set! (-> bs #,which) 0))
      (mount! b #`(set! (-> bs #,state) 0))
      (both! b #`(let ([now (if #,c 1 #,(number (if (== two 0) 0 2)))])
                   (if (== now (-> bs #,which))
                       (case now
                         [(1) (let ([bs (cast (ptr #,(-> one state)) (-> bs #,state))]) #,@(statements (-> one update)))]
                         #,@(if (== two 0)
                                nil
                                `(,#`[(2) (let ([bs (cast (ptr #,(-> two state)) (-> bs #,state))]) #,@(statements (-> two update)))])))
                       (begin
                         #,(branches-unmount one two which state #'#t)
                         (set! (-> bs #,which) now)
                         (case now
                           [(1)
                            (set! (-> bs #,state) (malloc (sizeof #,(-> one state))))
                            (let ([bs (cast (ptr #,(-> one state)) (-> bs #,state))] [parent 0] [before #,anchor])
                              #,@(mount-code one))]
                           #,@(if (== two 0)
                                  nil
                                  `(,#`[(2)
                                        (set! (-> bs #,state) (malloc (sizeof #,(-> two state))))
                                        (let ([bs (cast (ptr #,(-> two state)) (-> bs #,state))] [parent 0] [before #,anchor])
                                          #,@(mount-code two))]))
                           [else (set! (-> bs #,state) 0)])))))
      (unmount! b (branches-unmount one two which state #'#f))))

  (define (branches-unmount [one (ptr block)] [two (ptr block)] [which datum] [state datum] [detach datum]) -> datum
    #`(begin
        (case (-> bs #,which)
          [(1) (#,(-> one unmounter) (cast (ptr #,(-> one state)) (-> bs #,state)) #,detach)]
          #,@(if (== two 0) nil `(,#`[(2) (#,(-> two unmounter) (cast (ptr #,(-> two state)) (-> bs #,state)) #,detach)])))
        (free (-> bs #,state))))

  (define (each! [b (ptr block)] [f datum] [l datum])
    (let ([binding (if (>= (length l) 5) (syntax->list (cadr l)) 0)])
      (unless (and (!= binding 0) (== (length binding) 3) (identifier? (car binding)) (== (syntax-e (caddr l)) '#:key))
        (fail f '"expected (each [x items n] #:key k child ...)"))
      (when in-rows
        (fail f '"an each cannot be written directly inside another each: move the inner each into a view of its own, and use that view here"))
      (html! b "<!--a-->")
      (let* ([anchor (node! b)] [rows (field! b #'ui-rows)] [x (car binding)] [key (cadddr l)]
             [children (cddddr l)] [only (if (null? (cdr children)) (syntax->list (car children)) 0)]
             [v (if (and (!= only 0) (pair? only) (identifier? (car only))) (view-of (car only)) 0)]
             [state datum 0] [mount datum 0] [update datum 0] [unmount datum 0])
        (if (!= v 0)
            (let ([names (view-names v)])
              (check-arguments! (car children) v (cdr only))
              (set! state (car names))
              (set! mount #`(#,(cadr names) bs parent before #,@(cdr only)))
              (set! update #`(#,(caddr names) bs #,@(cdr only)))
              (set! unmount (cadddr names)))
            (let ([row (new-block #f)])
              (set! in-rows #t)
              (compile-children! row children)
              (set! in-rows #f)
              (finish! row)
              (set! state (-> row state))
              (set! mount #`(begin #,@(mount-code row)))
              (set! update #`(begin #,@(statements (-> row update))))
              (set! unmount (-> row unmounter))))
        (mount! b #`(set! (-> bs #,rows items) 0))
        (mount! b #`(set! (-> bs #,rows count) 0))
        (both! b #`(let ([items #,(cadr binding)] [anchor #,anchor] [rows (& (-> bs #,rows))])
                     (ui-each! rows 0 anchor #,(caddr binding) (sizeof #,state)
                               (lambda ([i u32]) -> u64 (let ([#,x (+ items i)]) (let ([key u64 #,key]) key)))
                               (lambda ([i u32] [row (ptr void)] [parent u32] [before u32])
                                 (let ([#,x (+ items i)] [bs (cast (ptr #,state) row)]) #,mount))
                               (lambda ([i u32] [row (ptr void)])
                                 (let ([#,x (+ items i)] [bs (cast (ptr #,state) row)]) #,update))
                               (lambda ([row (ptr void)] [detach bool]) (#,unmount (cast (ptr #,state) row) detach)))))
        (unmount! b #`(ui-each-clear! (& (-> bs #,rows)) #f
                                      (lambda ([row (ptr void)] [detach bool]) (#,unmount (cast (ptr #,state) row) detach)))))))

  (define (call! [b (ptr block)] [f datum] [l datum] [v datum])
    (check-arguments! f v (cdr l))
    (html! b "<!--a-->")
    (let ([anchor (node! b)] [names (view-names v)])
      (let ([state (field! b (car names))])
        (mount! b #`(#,(cadr names) (& (-> bs #,state)) 0 #,anchor #,@(cdr l)))
        (update! b #`(#,(caddr names) (& (-> bs #,state)) #,@(cdr l)))
        (unmount! b #`(#,(cadddr names) (& (-> bs #,state)) #f)))))

  (define (cddddr [l datum]) -> datum (cdr (cdddr l)))

  ;; ---- the macros themselves ----

  (define (message-type-name [s datum]) -> datum (datum->syntax s 'ui-message-type s))

  (define (messages-form [s datum]) -> datum
    (syntax-match s
      [(_ (? identifier? m)) #`(define-syntax #,(message-type-name s) (quote-syntax #,m))]))

  (define (view-form [s datum]) -> datum
    (syntax-match s
      [(_ ((? identifier? v) parameter ...) child ...)
       (let ([declared (message-type-name s)])
         (set! view-name v)
         (set! message-type (if (== (identifier-binding-kind declared) 'compile-time-value) (syntax-local-value declared) 0))
         (set! blocks 0)
         (set! fields 0)
         (set! fills nil)
         (set! definitions nil)
         (set! in-rows #f)
         (let ([b (new-block #t)])
           (compile-children! b child)
           (finish! b)
           #`(begin
               #,@(reverse definitions)
               (define (#,(named '"mount") [bs (ptr #,(-> b state))] [parent u32] [before u32] #,@parameter)
                 #,@(mount-code b))
               (define (#,(named '"update") [bs (ptr #,(-> b state))] #,@parameter)
                 #,@(statements (-> b update)))
               #,@(reverse fills)
               (define-syntax #,v
                 (view-value (quote-syntax ((#,(-> b state) #,(named '"mount") #,(named '"update") #,(-> b unmounter))
                                            (#,@parameter))))))))]))

  (define (view-value [parts datum]) -> datum
    (let ([l (syntax->list parts)]) `(ui-view ,(car l) ,(cadr l)))))

(define-syntax messages messages-form)
(define-syntax view view-form)
