;; A test helper: prints the page changes (patches) that views produce, as text.
(require-unqualified ui "ui.sub")
(require-unqualified gpu "gpu.sub")

(provide trace-patches! trace-listener trace-gpu!)

(define listeners (array u32 64))
(define listened u32 0)

(define (trace-listener [n u32]) -> (ptr void) (cast (ptr void) (@ listeners n)))

(define (number [n u32]) (printf "~a" n))

(define (node [n u32]) (printf "#") (number n))

(define (written [w (ptr u32)]) (host-write 1 (slice (cast (ptr u8) (@ w 0)) (@ w 1))))

(define (quoted [w (ptr u32)]) (printf "\"") (written w) (printf "\""))

(define (remember-listener! [m u32])
  (when (< listened 64)
    (set! (@ listeners listened) m)
    (+= listened 1)))

(define (print-float [x f64])
  (when (< x 0.0)
    (printf "-")
    (set! x (- 0.0 x)))
  (let* ([thousandths (cast u64 (+ (* x 1000.0) 0.5))] [fraction (% thousandths 1000)])
    (printf "~a" (/ thousandths 1000))
    (when (!= fraction 0)
      (let ([digits (array u8 3)] [n u32 3])
        (set! (@ digits 0) (cast u8 (+ 48 (/ fraction 100))))
        (set! (@ digits 1) (cast u8 (+ 48 (% (/ fraction 10) 10))))
        (set! (@ digits 2) (cast u8 (+ 48 (% fraction 10))))
        (while (== (@ digits (- n 1)) 48) (-= n 1))
        (printf ".")
        (host-write 1 (slice digits n))))))

(define (floats [w (ptr u32)] [n u32])
  (for ([i u32 0]) (< i n) (+= i 1)
    (printf " ")
    (print-float (@ (cast (ptr f32) w) i))))

(define (trace-command [w (ptr u32)]) -> u32
  (printf "  ")
  (case (@ w 0)
    [(1) (printf "clear-rect") (floats (+ w 1) 4) 5]
    [(2) (printf "fill-style ") (quoted (+ w 1)) 3]
    [(3) (printf "stroke-style ") (quoted (+ w 1)) 3]
    [(4) (printf "line-width") (floats (+ w 1) 1) 2]
    [(5) (printf "fill-rect") (floats (+ w 1) 4) 5]
    [(6) (printf "stroke-rect") (floats (+ w 1) 4) 5]
    [(7) (printf "begin-path") 1]
    [(8) (printf "move-to") (floats (+ w 1) 2) 3]
    [(9) (printf "line-to") (floats (+ w 1) 2) 3]
    [(10) (printf "arc") (floats (+ w 1) 5) 6]
    [(11) (printf "close-path") 1]
    [(12) (printf "fill-path") 1]
    [(13) (printf "stroke-path") 1]
    [(14) (printf "set-font ") (quoted (+ w 1)) 3]
    [(15) (printf "fill-text ") (quoted (+ w 1)) (floats (+ w 3) 2) 5]
    [(16) (printf "text-align ") (quoted (+ w 1)) 3]
    [(17) (printf "text-baseline ") (quoted (+ w 1)) 3]
    [(18) (printf "save-state") 1]
    [(19) (printf "restore-state") 1]
    [(20) (printf "translate") (floats (+ w 1) 2) 3]
    [(21) (printf "rotate") (floats (+ w 1) 1) 2]
    [(22) (printf "scale") (floats (+ w 1) 2) 3]
    [(23) (printf "global-alpha") (floats (+ w 1) 1) 2]
    [(24)
     (printf "draw-sprite image ") (number (@ w 1))
     (printf " frame ") (number (@ w 2))
     (when (!= (@ w 3) 0) (printf " flipped"))
     (printf " cell") (floats (+ w 4) 2)
     (printf " at") (floats (+ w 6) 2)
     8]
    [else (printf "?") 1000000]))

(define (trace-patch [w (ptr u32)]) -> u32
  (case (@ w 0)
    [(1) (printf "template ") (number (@ w 1)) (printf " ") (written (+ w 2)) 4]
    [(2) (printf "clone ") (number (@ w 1)) (printf " as ") (node (@ w 2))
         (printf " with ") (number (@ w 3)) (printf " in ") (node (@ w 4))
         (printf " before ") (node (@ w 5)) 6]
    [(3) (printf "remove ") (node (@ w 1)) (printf " with ") (number (@ w 2)) 3]
    [(4) (printf "free ") (node (@ w 1)) (printf " with ") (number (@ w 2)) 3]
    [(5) (printf "move ") (node (@ w 1)) (printf " in ") (node (@ w 2))
         (printf " before ") (node (@ w 3)) 4]
    [(6) (printf "text ") (node (@ w 1)) (printf " ") (quoted (+ w 2)) 4]
    [(7) (printf "attr ") (node (@ w 1)) (printf " ") (written (+ w 2)) (printf "=") (quoted (+ w 4)) 6]
    [(8) (printf "unattr ") (node (@ w 1)) (printf " ") (written (+ w 2)) 4]
    [(9)
     (remember-listener! (@ w 4))
     (printf "listen ") (node (@ w 1)) (printf " ") (written (+ w 2)) 5]
    [(10) (printf "focus ") (node (@ w 1)) 2]
    [(11) (printf "scroll-end ") (node (@ w 1)) 2]
    [(15) (printf "~a" (if (== (@ w 2) 0) "pointer-unlock " "pointer-lock ")) (node (@ w 1)) 3]
    [(12)
     (remember-listener! (@ w 4))
     (printf "listen-window ") (node (@ w 1)) (printf " ") (written (+ w 2)) 5]
    [(13)
     (printf "draw ") (node (@ w 1))
     (let ([i u32 0])
       (while (< i (@ w 2))
         (printf "\n")
         (+= i (trace-command (+ w (+ 3 i))))))
     (+ 3 (@ w 2))]
    [(14) (printf "image ") (number (@ w 1)) (printf " ") (written (+ w 2)) 4]
    [else (printf "?") 1000000]))

(define (trace-patches!)
  (let* ([b (ui-patches)] [w (cast (ptr u32) (-> b bytes))] [n (/ (-> b length) 4)] [i u32 0])
    (set! listened 0)
    (while (< i n)
      (+= i (trace-patch (+ w i)))
      (printf "\n"))
    (printf "--\n")
    (ui-patches-done!)))

(define (numbers [w (ptr u32)] [n u32])
  (for ([i u32 0]) (< i n) (+= i 1)
    (printf " ")
    (number (@ w i))))

(define (trace-gpu-command [w (ptr u32)]) -> u32
  (case (@ w 0)
    [(1) (printf "surface") (numbers (+ w 1) 1) (printf " node") (numbers (+ w 2) 1) 3]
    [(2) (printf "shader") (numbers (+ w 1) 1) (printf " ") (number (@ w 3)) (printf " bytes") 4]
    [(3)
     (printf "render-pipeline") (numbers (+ w 1) 2)
     (printf " vertex ") (quoted (+ w 3)) (printf " fragment ") (quoted (+ w 5))
     (printf " topology") (numbers (+ w 7) 1) (printf " cull") (numbers (+ w 8) 1)
     (printf " front") (numbers (+ w 9) 1) (printf " blend") (numbers (+ w 10) 1)
     (printf " depth") (numbers (+ w 11) 3)
     (let ([i u32 14])
       (let ([layouts (@ w i)])
         (+= i 1)
         (printf "\n  layouts") (numbers (+ w i) layouts)
         (+= i layouts))
       (let ([targets (@ w i)])
         (+= i 1)
         (printf "\n  targets") (numbers (+ w i) targets)
         (+= i targets))
       (let ([buffers (@ w i)])
         (+= i 1)
         (for ([b u32 0]) (< b buffers) (+= b 1)
           (printf "\n  buffer stride") (numbers (+ w i) 1)
           (printf "~a" (if (== (@ w (+ i 1)) 0) " per vertex" " per instance"))
           (let ([attributes (@ w (+ i 2))])
             (+= i 3)
             (for ([a u32 0]) (< a attributes) (+= a 1)
               (printf " [") (number (@ w i)) (printf " at") (numbers (+ w (+ i 1)) 1)
               (printf " format") (numbers (+ w (+ i 2)) 1) (printf "]")
               (+= i 3)))))
       i)]
    [(4)
     (printf "compute-pipeline") (numbers (+ w 1) 2) (printf " entry ") (quoted (+ w 3))
     (let ([layouts (@ w 5)])
       (printf "\n  layouts") (numbers (+ w 6) layouts)
       (+ 6 layouts))]
    [(5) (printf "buffer") (numbers (+ w 1) 1) (printf " size") (numbers (+ w 2) 1) (printf " usage") (numbers (+ w 3) 1) 4]
    [(6)
     (printf "texture") (numbers (+ w 1) 1) (printf " size") (numbers (+ w 2) 2)
     (printf " layers") (numbers (+ w 4) 1) (printf " mips") (numbers (+ w 5) 1)
     (printf " format") (numbers (+ w 6) 1) (printf " usage") (numbers (+ w 7) 1) 8]
    [(7) (printf "texture-file") (numbers (+ w 1) 1) (printf " ") (quoted (+ w 2)) 4]
    [(8) (printf "sampler") (numbers (+ w 1) 1) (printf " filter") (numbers (+ w 2) 1) (printf " address") (numbers (+ w 3) 1) (printf " compare") (numbers (+ w 4) 1) 5]
    [(9)
     (printf "layout") (numbers (+ w 1) 1)
     (let ([n (@ w 2)] [i u32 3])
       (for ([k u32 0]) (< k n) (+= k 1)
         (printf "\n  binding") (numbers (+ w i) 1) (printf " visibility") (numbers (+ w (+ i 1)) 1)
         (printf " kind") (numbers (+ w (+ i 2)) 1)
         (+= i 3))
       i)]
    [(10)
     (printf "bind-group") (numbers (+ w 1) 1) (printf " layout") (numbers (+ w 2) 1)
     (printf " pipeline") (numbers (+ w 3) 1) (printf " group") (numbers (+ w 4) 1)
     (let ([n (@ w 5)] [i u32 6])
       (for ([k u32 0]) (< k n) (+= k 1)
         (printf "\n  binding") (numbers (+ w i) 1)
         (printf "~a" (case (@ w (+ i 1)) [(1) " buffer"] [(2) " sampler"] [(3) " texture"] [else " ?"]))
         (numbers (+ w (+ i 2)) 1)
         (when (== (@ w (+ i 1)) 1) (printf " offset") (numbers (+ w (+ i 3)) 1) (printf " size") (numbers (+ w (+ i 4)) 1))
         (+= i 5))
       i)]
    [(11) (printf "destroy kind") (numbers (+ w 1) 2) 3]
    [(12) (printf "write-buffer") (numbers (+ w 1) 1) (printf " offset") (numbers (+ w 2) 1) (printf " bytes") (numbers (+ w 4) 1) 5]
    [(13)
     (printf "write-texture") (numbers (+ w 1) 1) (printf " mip") (numbers (+ w 2) 1) (printf " layer") (numbers (+ w 3) 1)
     (printf " at") (numbers (+ w 4) 2) (printf " size") (numbers (+ w 6) 2) (printf " bytes") (numbers (+ w 9) 1) 10]
    [(14) (printf "read-texture") (numbers (+ w 1) 1) (printf " mip") (numbers (+ w 2) 1) (printf " layer") (numbers (+ w 3) 1) (printf " at") (numbers (+ w 4) 2) (printf " size") (numbers (+ w 6) 2) 8]
    [(15) (printf "read-buffer") (numbers (+ w 1) 1) (printf " offset") (numbers (+ w 2) 1) (printf " bytes") (numbers (+ w 3) 1) 4]
    [(16)
     (printf "render-pass")
     (let ([n (@ w 1)] [i u32 2])
       (for ([k u32 0]) (< k n) (+= k 1)
         (printf "~a" (if (== (@ w i) 1) "\n  surface" "\n  texture")) (numbers (+ w (+ i 1)) 1)
         (printf " mip") (numbers (+ w (+ i 2)) 1) (printf " layer") (numbers (+ w (+ i 3)) 1)
         (printf "~a" (if (== (@ w (+ i 4)) 0) " kept" " cleared to")) (when (!= (@ w (+ i 4)) 0) (floats (+ w (+ i 5)) 4))
         (+= i 9))
       (when (!= (@ w i) 0)
         (printf "\n  depth texture") (numbers (+ w i) 1) (printf " mip") (numbers (+ w (+ i 1)) 1)
         (printf " layer") (numbers (+ w (+ i 2)) 1)
         (printf "~a" (if (== (@ w (+ i 3)) 0) " kept" " cleared to")) (when (!= (@ w (+ i 3)) 0) (floats (+ w (+ i 4)) 1)))
       (+ i 5))]
    [(17) (printf "compute-pass") 1]
    [(18) (printf "end-pass") 1]
    [(19) (printf "pipeline") (numbers (+ w 1) 1) 2]
    [(20)
     (printf "bind-group group") (numbers (+ w 1) 2)
     (let ([n (@ w 3)])
       (when (> n 0) (printf " offsets") (numbers (+ w 4) n))
       (+ 4 n))]
    [(21) (printf "vertex-buffer slot") (numbers (+ w 1) 1) (printf " buffer") (numbers (+ w 2) 1) (printf " offset") (numbers (+ w 3) 1) 4]
    [(22) (printf "index-buffer") (numbers (+ w 1) 1) (printf " format") (numbers (+ w 2) 1) (printf " offset") (numbers (+ w 3) 1) 4]
    [(23) (printf "draw") (numbers (+ w 1) 4) 5]
    [(24) (printf "draw-indexed") (numbers (+ w 1) 5) 6]
    [(25) (printf "dispatch") (numbers (+ w 1) 3) 4]
    [(26) (printf "viewport") (floats (+ w 1) 4) 5]
    [(27) (printf "scissor") (numbers (+ w 1) 4) 5]
    [else (printf "unknown command ") (number (@ w 0)) 1]))

(define (trace-gpu!)
  (let* ([b (gpu-commands)] [w (cast (ptr u32) (-> b bytes))] [n (/ (-> b length) 4)] [i u32 0])
    (while (< i n)
      (+= i (trace-gpu-command (+ w i)))
      (printf "\n"))
    (printf "--\n")
    (gpu-commands-done!)))
