;; The key of an each must be an integer; this one is a string.
(require-unqualified ui "../../lib/web/ui.sub")

(struct item [id u32] [name string])
(struct model [count i32] [title string] [items (array item 4)] [n u32])
(variant msg [increment] [typed [text string]])
(messages msg)

(view (row [x (ptr item)]) (li (text (-> x name))))

(view (page [m (ptr model)])
  (ul (each [x (-> m items) (-> m n)] #:key (-> x name)
        (row x))))
(define (main) 0)
