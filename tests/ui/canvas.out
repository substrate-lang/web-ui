load an image
image 1 assets/sprites.png
--
mount
template 1 <!--a-->
clone 1 as #1 with 1 in #0 before #0
template 2 <canvas width="320" height="240" data-n></canvas>
clone 2 as #3 with 1 in #0 before #2
draw #4
  fill-style "black"
  fill-rect 0 0 320 240
  fill-style "#4caf50"
  begin-path
  arc 100 50 10 0 6.283
  fill-path
  stroke-style "white"
  line-width 2
  begin-path
  move-to 0 0
  line-to 100 50
  stroke-path
  stroke-rect 0.5 0.5 319 239
  begin-path
  move-to 10 10
  line-to 20 10
  line-to 15 20
  close-path
  fill-path
  save-state
  translate 160 120
  rotate 0.25
  scale 2 2
  global-alpha 0.5
  set-font "16px sans-serif"
  text-align "center"
  text-baseline "middle"
  fill-text "hello" 0 0
  restore-state
  clear-rect 0 0 4 4
  draw-sprite image 1 frame 5 cell 16 16 at 40 50
  draw-sprite image 1 frame 9 flipped cell 16 16 at 60 50
listen #4 click
listen-window #4 keydown
listen-window #4 frame
--
events
pointed at 12, 34
pressed ArrowUp
tick at 1234 ms
nothing changed
--
the dot moved, but the draw key did not change
--
the draw key changed
draw #4
  fill-style "black"
  fill-rect 0 0 320 240
  fill-style "#4caf50"
  begin-path
  arc 120 50 10 0 6.283
  fill-path
  stroke-style "white"
  line-width 2
  begin-path
  move-to 0 0
  line-to 120 50
  stroke-path
  stroke-rect 0.5 0.5 319 239
  begin-path
  move-to 10 10
  line-to 20 10
  line-to 15 20
  close-path
  fill-path
  save-state
  translate 160 120
  rotate 0.25
  scale 2 2
  global-alpha 0.5
  set-font "16px sans-serif"
  text-align "center"
  text-baseline "middle"
  fill-text "hello" 0 0
  restore-state
  clear-rect 0 0 4 4
  draw-sprite image 1 frame 5 cell 16 16 at 40 50
  draw-sprite image 1 frame 9 flipped cell 16 16 at 60 50
--
drawing outside a [draw ...]
--
the canvas is removed
remove #3 with 1
--
