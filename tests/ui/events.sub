;; Views: typed attributes, and listeners whose messages carry event data.
(require-unqualified ui std/web/ui)
(require-unqualified trace std/web/trace)

(struct model [id u32] [busy bool] [wide u32] [note string])
(variant msg [typed [text string]] [key [id u32] [name string] [shift bool] [meta bool]] [checked [on bool]] [plain])
(messages msg)

(view (form [m (ptr model)])
  (input ([type "text"] [required] [maxlength 40] [size "8"] [disabled (-> m busy)] [tabindex (-> m wide)]
          [on input (typed (event value))]
          [on keydown (key (-> m id) (event key) (event shift) (event meta))]))
  (input ([type "checkbox"] [checked (not (-> m busy))] [on change (checked (event checked))]))
  (table (tr (td ([colspan (+ (-> m wide) 1)] [data-note (-> m note)] ["x-own" "kept"]) "cell")))
  (my-element ([anything "at all"] [on "my-event" plain]) "own"))

(define the-model model)
(define a-form form.state)

(define the-value string "")
(define the-key string "")
(define the-truths u32 0)
(define (event-text [which u32]) -> string (if (== which 0) the-value the-key))
(define (event-truths) -> u32 the-truths)
(define (event-number [which u32]) -> f64 0.0)

(define (hear [n u32])
  (match (cast (ptr msg) (ui-heard (trace-listener n)))
    [(typed text) (printf "typed ~a" text)]
    [(key id name shift meta)
     (printf "key ~a ~a~a~a" id name (if shift " shift" "") (if meta " meta" ""))]
    [(checked on) (printf "~a" (if on "checked" "not checked"))]
    [plain (printf "plain")])
  (printf "\n"))

(define (main)
  (set! (-> the-model id) 7)
  (set! (-> the-model busy) #f)
  (set! (-> the-model wide) 2)
  (set! (-> the-model note) "first")
  (printf "mount\n")
  (form.mount (& a-form) 0 0 (& the-model))
  (trace-patches!)

  (printf "events with no source\n")
  (hear 0)
  (hear 1)
  (ui-event-source! event-text event-truths event-number)
  (printf "events\n")
  (set! the-value "hello")
  (set! the-key "Enter")
  (set! the-truths 1)
  (hear 0)
  (hear 1)
  (hear 2)
  (set! the-key "a")
  (set! the-truths 24)
  (hear 1)
  (hear 2)
  (hear 3)

  (printf "busy, wider, another id\n")
  (set! (-> the-model busy) #t)
  (set! (-> the-model wide) 3)
  (set! (-> the-model id) 8)
  (form.update (& a-form) (& the-model))
  (trace-patches!)
  (set! the-truths 0)
  (hear 1)
  (printf "nothing changed\n")
  (form.update (& a-form) (& the-model))
  (trace-patches!)
  (printf "not busy\n")
  (set! (-> the-model busy) #f)
  (form.update (& a-form) (& the-model))
  (trace-patches!))
