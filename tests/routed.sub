;; An app with routes (places.sub): links between its pages, one with a parameter, a long page with a fragment and
;; links between its start and end, a draft that holds the document while it is unsaved, a navigation from an update, a
;; title for each page, links the router leaves alone, two SVG links, and a form that searches in place. It counts
;; hashchange events.
;; Its links work at any base: they come from route-href or are relative.
(require-unqualified web-ui)
(require-unqualified std/http/routable)
(require-unqualified "places.sub")

(provide app)

(struct app-state [at place] [unsaved bool] [stopped string] [marked bool] [hashes u32])

(variant app-message [went [to place]] [edited] [saved] [stopped [url string]] [marked] [three] [hashed])

(define (app-update [s (ptr app-state)] [m (ptr app-message)])
  (match m
    [(went to) (set! (-> s at) to)]
    [edited (set! (-> s unsaved) #t)]
    [saved (set! (-> s unsaved) #f)]
    [(stopped url) (set! (-> s stopped) (string-copy url))]
    [marked (set! (-> s marked) #t)]
    [three (navigate! (route-href (user 3)))]
    [hashed (+= (-> s hashes) 1)]))

(define (unsaved? [s (ptr app-state)]) -> bool (-> s unsaved))

(define (app-init [s (ptr app-state)] [at place]) (set! (-> s at) at))

(component (app)
  #:state [s app-state]
  #:messages app-message
  #:update app-update
  #:init app-init
  #:route went
  #:leaving [unsaved? stopped]
  (div ([on-window hashchange hashed])
    (nav ([style "position: fixed; top: 0; background: white"])
      (a ([href (route-href home)] [id "home"]) "Home")
      (a ([href (route-href (user 7))] [id "user"] ["aria-current" (if (route-current? (user 7)) "page" "false")])
         "User 7")
      (a ([href (route-href draft)] [id "draft"]) "Draft")
      (a ([href "long/#end"] [id "long"]) "Long")
      (a ([href "nope/"] [id "nope"]) "Nope")
      (a ([href (route-href (user 5))] [target "_blank"] [id "blank"]) "Blank")
      (a ([href "index.html?full=1"] [rel "nofollow external"] [id "external"]) "External")
      (a ([href (route-href (user 5))] [download "page.html"] [id "download"]) "Download"))
    (form ([action "search/"])
      (input ([name "q"] [id "q"]))
      (button ([name "go"] [value "1"]) "Search")
      (button ([formmethod "post"] [formaction "index.html"] [id "post"]) "Post"))
    (button ([on click marked]) "Mark")
    (button ([on click three]) "Three")
    (svg ([width 50] [height 20])
      (a ([href (route-href (user 4))] [id "svg-user"]) (rect ([width 20] [height 20])))
      (a ([href (route-href (user 5))] [target "_blank"] [id "svg-blank"]) (rect ([x 30] [width 20] [height 20]))))
    (p ([id "mark"]) (text (if (-> s marked) "marked" "")))
    (p ([id "hashes"]) (int (cast i64 (-> s hashes))))
    (main
      (match (-> s at)
        [home (title "Home") (p ([id "page"]) "home")]
        [(user id) (title "User") (p ([id "page"]) "user " (int (cast i64 id)))]
        [draft
         (title "Draft")
         (p ([id "page"]) "draft")
         (button ([on click edited]) "Edit")
         (button ([on click saved]) "Save")
         (p ([id "stopped"]) (text (-> s stopped)))]
        [long
         (title "Long")
         (div ([id "start"] [style "height: 3000px"]) "long " (a ([href "long/#end"] [id "to-end"]) "To the end"))
         (p ([id "end"]) "the end " (a ([href "long/#start"] [id "to-start"]) "To the start"))
         (div ([style "height: 3000px"]))]
        [(search query) (title "Search") (p ([id "page"]) "search " (text (-> query q)))]
        [lost (title "Lost") (p ([id "page"]) "lost")]))))

(attach #:routes place ["root" (app)])
