;; Canvas drawing and window listeners: the patches a view writes, printed.
(require-unqualified std/test/test)
(require-unqualified web-ui/ui)
(require-unqualified std/web/canvas)
(require-unqualified web-ui/trace)

(struct model [show bool] [frame u32] [x i32] [y i32] [label string])
(variant msg [tick [time f64]] [pointed [x i32] [y i32]] [pressed [key string]])
(messages msg)

(define sheet u32 0)

(define (paint [m (ptr model)])
  (canvas-fill-style! "black")
  (canvas-fill-rect! 0 0 320 240)
  (canvas-fill-style! "#4caf50")
  (canvas-fill-circle! (-> m x) (-> m y) 10)
  (canvas-stroke-style! "white")
  (canvas-line-width! 2)
  (canvas-draw-line! 0 0 (-> m x) (-> m y))
  (canvas-stroke-rect! 0.5 0.5 319 239)
  (canvas-begin-path!)
  (canvas-move-to! 10 10)
  (canvas-line-to! 20 10)
  (canvas-line-to! 15 20)
  (canvas-close-path!)
  (canvas-fill-path!)
  (canvas-save-state!)
  (canvas-translate! 160 120)
  (canvas-rotate! 0.25)
  (canvas-scale! 2 2)
  (canvas-global-alpha! 0.5)
  (canvas-set-font! "16px sans-serif")
  (canvas-text-align! "center")
  (canvas-text-baseline! "middle")
  (canvas-fill-text! (-> m label) 0 0)
  (canvas-restore-state!)
  (canvas-clear-rect! 0 0 4 4)
  (canvas-draw-sprite! sheet 16 16 5 40 50 #f)
  (canvas-draw-sprite! sheet 16 16 9 60 50 #t)
  (canvas-load-image! "ignored.png" 0))

(view (board [m (ptr model)])
  (when (-> m show)
    (canvas ([width 320] [height 240]
             [draw (-> m frame) (paint m)]
             [on click (pointed (event x) (event y))]
             [on-window keydown (pressed (event key))]
             [on-window frame (tick (event time))]))))

(define the-model model)
(define a-board board.state)

(define (event-text [which u32]) -> string (if (== which 1) "ArrowUp" ""))
(define (event-truths) -> u32 0)
(define (event-number [which u32]) -> f64
  (case which
    [(0) 1234.5]
    [(1) 12.0]
    [else 34.0]))

(define (hear [n u32])
  (match (cast (ptr msg) (ui-heard (trace-listener n)))
    [(tick time) (printf "tick at ~a ms" (cast u64 time))]
    [(pointed x y)
     (printf "pointed at ~a, ~a" x y)]
    [(pressed key) (printf "pressed ~a" key)])
  (printf "\n"))

(define (step [what string])
  (printf "~a\n" what)
  (board.update (& a-board) (& the-model))
  (trace-patches!))

(define (main)
  (set! (-> the-model show) #t)
  (set! (-> the-model x) 100)
  (set! (-> the-model y) 50)
  (set! (-> the-model label) "hello")
  (ui-event-source! event-text event-truths event-number)
  (printf "load an image\n")
  (set! sheet (canvas-load-image! "assets/sprites.png" 0))
  (trace-patches!)
  (printf "mount\n")
  (board.mount (& a-board) 0 0 (& the-model))
  (trace-patches!)

  (printf "events\n")
  (hear 0)
  (hear 1)
  (hear 2)

  (step "nothing changed")
  (set! (-> the-model x) 120)
  (step "the dot moved, but the draw key did not change")
  (set! (-> the-model frame) 1)
  (step "the draw key changed")

  (printf "drawing outside a [draw ...]\n")
  (canvas-fill-rect! 1 2 3 4)
  (canvas-fill-text! "lost" 0 0)
  (trace-patches!)

  (set! (-> the-model show) #f)
  (step "the canvas is removed"))

(test canvas (expect-output-file "canvas.out" (main)))
