;; The routes of the test app (routed.sub), which its server (support/server.sub) answers too.
(require-unqualified std/http/form)
(require-unqualified std/http/routable)

(provide place home user draft long search lost place.url-read place.url-write! place.url-check)

(struct search-query [q string])

(form search-query)

(routable place #:missing lost
  [home ()]
  [user ("users" [id u64] "")]
  [draft ("draft" "")]
  [long ("long" "")]
  [search ("search" "") (query search-query)]
  [#:moved ("index.html") home])
