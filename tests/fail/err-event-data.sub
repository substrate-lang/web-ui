;; Event data of the wrong type: (event shift) is a bool, the field a string.
(require-unqualified web/ui)

(struct item [id u32] [name string])
(struct model [count i32] [title string] [items (array item 4)] [n u32])
(variant msg [increment] [typed [text string]])
(messages msg)

(view (page [m (ptr model)])
  (input ([on input (typed (event shift))])))
(define (main) 0)
