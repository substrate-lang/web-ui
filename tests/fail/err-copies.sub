;; A component that a second copy of web-ui makes (support/twin.sub), drawn inside a view of this copy.
(require twin twin/web-ui)
(require-unqualified web-ui)

(struct tally-state [count i32])

(twin:component (tally)
  #:state [s tally-state]
  (span (int (-> s count))))

(view (page) (div (tally)))

(attach ["root" (page)])
