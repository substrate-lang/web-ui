;; A numeric attribute, colspan, given a string, reported at the expression.
(require-unqualified web-ui/ui)

(struct item [id u32] [name string])
(struct model [count i32] [title string] [items (array item 4)] [n u32])
(variant msg [increment] [typed [text string]])
(messages msg)

(view (page [m (ptr model)])
  (table (tr (td ([colspan (-> m title)]) "x"))))
(define (main) 0)
