the banner is mounted, with its stylesheet
stylesheet .banner { color: green }
template 1 <h1 class="banner"><!--t--></h1>
clone 1 as #3 with 1 in #0 before #0
text #4 "Hello"
--
the holder is mounted
template 2 <!--a--><!--a--><button data-n>next user</button><button data-n>rename</button><button data-n>tick</button><!--t-->
clone 2 as #5 with 6 in #0 before #0
template 3 <p><!--t--> <!--t--><button data-n>+</button></p>
clone 3 as #12 with 3 in #0 before #6
text #13 "user"
text #14 "0"
listen #15 click
template 4 <p><!--t--> has <!--t--> letters, worked out <!--t--> times</p>
clone 4 as #16 with 3 in #0 before #7
text #17 "Ada"
text #18 "3"
text #19 "1"
listen #8 click
listen #9 click
listen #10 click
text #11 "0"
--
the tally counts 1
text #14 "1"
--
the same key and name change nothing but the ticks
text #11 "1"
--
the next user mounts the tally again, from 0
remove #12 with 3
clone 3 as #20 with 3 in #0 before #6
text #21 "user"
text #22 "0"
listen #23 click
--
the new name is worked out again
text #17 "Grace"
text #18 "5"
text #19 "2"
--
