;; Views: the patches mounting and updating write, for each kind of changing part.
(require-unqualified ui web/ui)
(require-unqualified trace web/trace)
(provide main)

(struct item [id u32] [name string] [done bool])
(struct model [count i32] [title string] [items (array item 8)] [n u32])
(variant msg [increment] [decrement] [toggle [id u32]])
(messages msg)

(view (counter [m (ptr model)])
  (div ([class "counter"])
    (h1 (text (-> m title)))
    (button ([on click decrement] [disabled (== (-> m count) 0)]) "-")
    (span ([class (if (< (-> m count) 0) "neg" "pos")]) "count: " (int (-> m count)) "!")
    (button ([on click increment]) "+")
    (br)
    (input ([type "text"] [value (-> m title)] [focus (-> m count)]))))

(view (row [x (ptr item)])
  (li ([class (if (-> x done) "done" "")] [on click (toggle (-> x id))])
    (text (-> x name))
    (if (-> x done) (b "done") (i "to do"))))

(view (todo [m (ptr model)])
  (when (> (-> m n) 0) (p "a < b & \"c\"" (int (-> m n))))
  (ul ([title "a \"list\" & <more>"]) (each [x (-> m items) (-> m n)] #:key (-> x id) (row x)))
  (counter m))

(define the-model model)
(define a-counter counter.state)
(define a-todo todo.state)

(define (set-item! [i u32] [id u32] [name string] [done bool])
  (let ([x (+ (-> the-model items) i)])
    (set! (-> x id) id)
    (set! (-> x name) name)
    (set! (-> x done) done)))

(define (step [what string])
  (printf "~a\n" what)
  (todo.update (& a-todo) (& the-model))
  (trace-patches!))

(define (main)
  (set! (-> the-model count) 0)
  (set! (-> the-model title) "Counter")
  (set! (-> the-model n) 0)
  (printf "mount a counter\n")
  (counter.mount (& a-counter) 0 0 (& the-model))
  (trace-patches!)
  (printf "count 5\n")
  (set! (-> the-model count) 5)
  (counter.update (& a-counter) (& the-model))
  (trace-patches!)
  (printf "count -1, another title\n")
  (set! (-> the-model count) -1)
  (set! (-> the-model title) "Counting")
  (counter.update (& a-counter) (& the-model))
  (trace-patches!)
  (printf "nothing changed\n")
  (counter.update (& a-counter) (& the-model))
  (trace-patches!)
  (printf "unmount it\n")
  (counter.unmount (& a-counter) #t)
  (trace-patches!)

  (printf "mount a todo, empty\n")
  (todo.mount (& a-todo) 0 0 (& the-model))
  (trace-patches!)
  (set-item! 0 10 "ten" #f)
  (set-item! 1 20 "twenty" #f)
  (set! (-> the-model n) 2)
  (step "two items")
  (set-item! 2 30 "thirty" #t)
  (set! (-> the-model n) 3)
  (step "a third, done")
  (set-item! 0 10 "ten" #t)
  (step "the first done")
  (set-item! 0 20 "twenty" #f)
  (set-item! 1 30 "thirty" #t)
  (set! (-> the-model n) 2)
  (step "the first gone")
  (set-item! 0 30 "thirty" #t)
  (set-item! 1 40 "forty" #f)
  (set-item! 2 20 "twenty" #f)
  (set! (-> the-model n) 3)
  (step "the order changed, and one new between")
  (set! (-> the-model n) 0)
  (step "none")
  (printf "unmount it\n")
  (todo.unmount (& a-todo) #t)
  (trace-patches!))

