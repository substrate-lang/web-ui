;; Views: a message type of one case, whose message carries event data, compiles.
(require-unqualified web-ui/ui)
(require-unqualified web-ui/trace)
(provide main)

(struct model [id u32])
(variant msg [typed [text string]])
(messages msg)

(view (field [m (ptr model)])
  (input ([type "text"] [on input (typed (event value))])))

(define the-model model)
(define a-field field.state)

(define (event-text [node u32] [path string]) -> string "hello")
(define (event-number [node u32] [path string]) -> f64 0.0)
(define (node-is [node u32] [name string]) -> bool #f)

(define (main)
  (field.mount (& a-field) 0 0 (& the-model))
  (trace-patches!)
  (ui-read-with! event-text event-number node-is)
  (match (cast (ptr msg) (ui-heard (trace-listener 0)))
    [(typed text) (printf "typed ~a\n" text)]))

