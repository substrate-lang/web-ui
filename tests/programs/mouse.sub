;; Views' mouse features: movement, button and lock in event data, and [pointer-lock e].
(require-unqualified web-ui/ui)
(require-unqualified web-ui/trace)
(require-unqualified std/web/patches)
(provide main)

(struct model [lock u32])
(variant msg [clicked [button i32] [x i32]] [moved [dx i32] [dy i32]] [lock-changed [locked bool]])
(messages msg)

(view (screen [m (ptr model)])
  (canvas ([width 64] [height 36]
           [pointer-lock (-> m lock)]
           [on mousedown (clicked (event button) (event x))]
           [on-window mousemove (moved (event movement-x) (event movement-y))]
           [on-window pointerlockchange (lock-changed (event locked))])))

(define the-model model)
(define a-screen screen.state)

(define (event-text [path string]) -> string "")
(define (event-number [path string]) -> f64
  (cond [(== path "offsetX") 40.0] [(== path "movementX") 12.0]
        [(== path "movementY") -5.0] [(== path "button") 2.0] [else 0.0]))
(define (node-is [node u32] [from u32] [path string]) -> bool
  (and (== node 4) (== from dom-document) (== path "pointerLockElement")))

(define (hear [n u32])
  (match (cast (ptr msg) (ui-heard (trace-listener n)))
    [(clicked button x) (printf "  clicked: button ~a at x ~a\n" button x)]
    [(moved dx dy) (printf "  moved: ~a ~a\n" dx dy)]
    [(lock-changed locked) (printf "  the lock changed: locked ~a\n" (if locked 1 0))]))

(define (main)
  (ui-read-with! event-text event-number node-is)
  (printf "mount\n")
  (screen.mount (& a-screen) 0 0 (& the-model))
  (trace-patches!)
  (printf "events\n")
  (hear 0)
  (hear 1)
  (hear 2)
  (printf "asking for the lock\n")
  (set! (-> the-model lock) 1)
  (screen.update (& a-screen) (& the-model))
  (trace-patches!)
  (printf "asking again, by changing the number\n")
  (set! (-> the-model lock) 2)
  (screen.update (& a-screen) (& the-model))
  (trace-patches!)
  (printf "nothing changed\n")
  (screen.update (& a-screen) (& the-model))
  (trace-patches!)
  (printf "releasing\n")
  (set! (-> the-model lock) 0)
  (screen.update (& a-screen) (& the-model))
  (trace-patches!))

