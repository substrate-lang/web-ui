mount a counter
template 1 <div class="counter"><h1><!--t--></h1><button data-n>-</button><span data-n>count: <!--t-->!</span><button data-n>+</button><br><input type="text" data-n></div>
clone 1 as #2 with 6 in #0 before #0
text #3 "Counter"
listen #4 click
attr #4 disabled=""
attr #5 class="pos"
text #6 "0"
listen #7 click
attr #8 value="Counter"
--
count 5
unattr #4 disabled
text #6 "5"
call #8 focus
--
count -1, another title
text #3 "Counting"
attr #5 class="neg"
text #6 "-1"
attr #8 value="Counting"
call #8 focus
--
nothing changed
--
unmount it
remove #2 with 6
--
mount a todo, empty
template 2 <!--a--><ul title="a &quot;list&quot; &amp; &lt;more&gt;"><!--a--></ul><!--a-->
clone 2 as #9 with 3 in #0 before #0
clone 1 as #13 with 6 in #0 before #12
text #14 "Counting"
listen #15 click
attr #16 class="neg"
text #17 "-1"
listen #18 click
attr #19 value="Counting"
--
two items
template 3 <p>a &lt; b &amp; "c"<!--t--></p>
clone 3 as #20 with 1 in #0 before #10
text #21 "2"
template 4 <li data-n><!--t--><!--a--></li>
clone 4 as #22 with 3 in #0 before #11
attr #23 class=""
listen #23 click
text #24 "twenty"
template 5 <i>to do</i>
clone 5 as #26 with 0 in #0 before #25
clone 4 as #27 with 3 in #0 before #22
attr #28 class=""
listen #28 click
text #29 "ten"
clone 5 as #31 with 0 in #0 before #30
--
a third, done
text #21 "3"
clone 4 as #32 with 3 in #0 before #11
attr #33 class="done"
listen #33 click
text #34 "thirty"
template 6 <b>done</b>
clone 6 as #36 with 0 in #0 before #35
--
the first done
attr #28 class="done"
remove #31 with 0
clone 6 as #37 with 0 in #0 before #30
--
the first gone
text #21 "2"
free #37 with 0
remove #27 with 3
--
the order changed, and one new between
text #21 "3"
clone 4 as #38 with 3 in #0 before #22
attr #39 class=""
listen #39 click
text #40 "forty"
clone 5 as #42 with 0 in #0 before #41
move #32 in #0 before #38
--
none
remove #20 with 1
free #36 with 0
remove #32 with 3
free #42 with 0
remove #38 with 3
free #26 with 0
remove #22 with 3
--
unmount it
free #13 with 6
remove #9 with 3
--
