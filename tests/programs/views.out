mount a counter
template 1 <div class="counter"><h1><!--t--></h1><button data-n>-</button><span data-n>count: <!--t-->!</span><button data-n>+</button><br><input type="text" data-n></div>
clone 1 as #3 with 6 in #0 before #0
text #4 "Counter"
listen #5 click
attr #5 disabled=""
attr #6 class="pos"
text #7 "0"
listen #8 click
attr #9 value="Counter"
--
count 5
unattr #5 disabled
text #7 "5"
call #9 focus
--
count -1, another title
text #4 "Counting"
attr #6 class="neg"
text #7 "-1"
attr #9 value="Counting"
call #9 focus
--
nothing changed
--
unmount it
remove #3 with 6
--
mount a todo, empty
template 2 <!--a--><ul title="a &quot;list&quot; &amp; &lt;more&gt;"><!--a--></ul><!--a-->
clone 2 as #10 with 3 in #0 before #0
clone 1 as #14 with 6 in #0 before #13
text #15 "Counting"
listen #16 click
attr #17 class="neg"
text #18 "-1"
listen #19 click
attr #20 value="Counting"
--
two items
template 3 <p>a &lt; b &amp; "c"<!--t--></p>
clone 3 as #21 with 1 in #0 before #11
text #22 "2"
template 4 <li data-n><!--t--><!--a--></li>
clone 4 as #23 with 3 in #0 before #12
attr #24 class=""
listen #24 click
text #25 "twenty"
template 5 <i>to do</i>
clone 5 as #27 with 0 in #0 before #26
clone 4 as #28 with 3 in #0 before #23
attr #29 class=""
listen #29 click
text #30 "ten"
clone 5 as #32 with 0 in #0 before #31
--
a third, done
text #22 "3"
clone 4 as #33 with 3 in #0 before #12
attr #34 class="done"
listen #34 click
text #35 "thirty"
template 6 <b>done</b>
clone 6 as #37 with 0 in #0 before #36
--
the first done
attr #29 class="done"
remove #32 with 0
clone 6 as #38 with 0 in #0 before #31
--
the first gone
text #22 "2"
free #38 with 0
remove #28 with 3
--
the order changed, and one new between
text #22 "3"
clone 4 as #39 with 3 in #0 before #23
attr #40 class=""
listen #40 click
text #41 "forty"
clone 5 as #43 with 0 in #0 before #42
move #33 in #0 before #39
--
none
remove #21 with 1
free #37 with 0
remove #33 with 3
free #43 with 0
remove #39 with 3
free #27 with 0
remove #23 with 3
--
unmount it
free #14 with 6
remove #10 with 3
--
