mount a counter
template 1 <div class="counter"><h1><!--t--></h1><button data-n>-</button><span data-n>count: <!--t-->!</span><button data-n>+</button><br><input type="text" data-n></div>
clone 1 as #1 with 6 in #0 before #0
text #2 "Counter"
listen #3 click
attr #3 disabled=""
attr #4 class="pos"
text #5 "0"
listen #6 click
attr #7 value="Counter"
--
count 5
unattr #3 disabled
text #5 "5"
call #7 focus
--
count -1, another title
text #2 "Counting"
attr #4 class="neg"
text #5 "-1"
attr #7 value="Counting"
call #7 focus
--
nothing changed
--
unmount it
remove #1 with 6
--
mount a todo, empty
template 2 <!--a--><ul title="a &quot;list&quot; &amp; &lt;more&gt;"><!--a--></ul><!--a-->
clone 2 as #8 with 3 in #0 before #0
clone 1 as #12 with 6 in #0 before #11
text #13 "Counting"
listen #14 click
attr #15 class="neg"
text #16 "-1"
listen #17 click
attr #18 value="Counting"
--
two items
template 3 <p>a &lt; b &amp; "c"<!--t--></p>
clone 3 as #19 with 1 in #0 before #9
text #20 "2"
template 4 <li data-n><!--t--><!--a--></li>
clone 4 as #21 with 3 in #0 before #10
attr #22 class=""
listen #22 click
text #23 "twenty"
template 5 <i>to do</i>
clone 5 as #25 with 0 in #0 before #24
clone 4 as #26 with 3 in #0 before #21
attr #27 class=""
listen #27 click
text #28 "ten"
clone 5 as #30 with 0 in #0 before #29
--
a third, done
text #20 "3"
clone 4 as #31 with 3 in #0 before #10
attr #32 class="done"
listen #32 click
text #33 "thirty"
template 6 <b>done</b>
clone 6 as #35 with 0 in #0 before #34
--
the first done
attr #27 class="done"
remove #30 with 0
clone 6 as #36 with 0 in #0 before #29
--
the first gone
text #20 "2"
free #36 with 0
remove #26 with 3
--
the order changed, and one new between
text #20 "3"
clone 4 as #37 with 3 in #0 before #21
attr #38 class=""
listen #38 click
text #39 "forty"
clone 5 as #41 with 0 in #0 before #40
move #31 in #0 before #37
--
none
remove #19 with 1
free #35 with 0
remove #31 with 3
free #41 with 0
remove #37 with 3
free #25 with 0
remove #21 with 3
--
unmount it
free #12 with 6
remove #8 with 3
--
