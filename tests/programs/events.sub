;; Views: typed attributes, and listeners whose messages carry event data.
(require-unqualified web-ui/ui)
(require-unqualified web-ui/trace)
(provide main)

(struct model [id u32] [busy bool] [wide u32] [note string])
(variant msg
  [typed [text string]] [key [id u32] [name string] [shift bool] [meta bool]] [checked [on bool]] [plain]
  [turned [dy f64] [mode string]])
(messages msg)

(view (form [m (ptr model)])
  (input ([type "text"] [required] [maxlength 40] [size "8"] [disabled (-> m busy)] [tabindex (-> m wide)]
          [on input (typed (event value))]
          [on keydown (key (-> m id) (event key) (event shift) (event meta))]))
  (input ([type "checkbox"] [checked (not (-> m busy))] [on change (checked (event checked))]))
  (table (tr (td ([colspan (+ (-> m wide) 1)] [data-note (-> m note)] ["x-own" "kept"]) "cell")))
  (my-element ([anything "at all"] [on "my-event" plain]) "own")
  (div ([on wheel (turned (event-number "deltaY") (event-text "type"))])))

(define the-model model)
(define a-form form.state)

(define the-value string "")
(define the-key string "")
(define the-truths u32 0)
(define (event-text [path string]) -> string
  (cond [(== path "target.value") the-value] [(== path "key") the-key] [(== path "type") "wheel"] [else ""]))
(define (truth [bit u32]) -> f64 (if (!= (bit-and the-truths bit) 0) 1.0 0.0))
(define (event-number [path string]) -> f64
  (cond [(== path "shiftKey") (truth 1)] [(== path "metaKey") (truth 8)] [(== path "target.checked") (truth 16)]
        [(== path "deltaY") -120.0] [else 0.0]))
(define (node-is [node u32] [name string]) -> bool #f)

(define (hear [n u32])
  (match (cast (ptr msg) (ui-heard (trace-listener n)))
    [(typed text) (printf "typed ~a" text)]
    [(key id name shift meta)
     (printf "key ~a ~a~a~a" id name (if shift " shift" "") (if meta " meta" ""))]
    [(checked on) (printf "~a" (if on "checked" "not checked"))]
    [plain (printf "plain")]
    [(turned dy mode) (printf "turned ~a by ~a" mode (cast i32 dy))])
  (printf "\n"))

(define (main)
  (set! (-> the-model id) 7)
  (set! (-> the-model busy) #f)
  (set! (-> the-model wide) 2)
  (set! (-> the-model note) "first")
  (printf "mount\n")
  (form.mount (& a-form) 0 0 (& the-model))
  (trace-patches!)

  (printf "events with no source\n")
  (hear 0)
  (hear 1)
  (ui-read-with! event-text event-number node-is)
  (printf "events\n")
  (set! the-value "hello")
  (set! the-key "Enter")
  (set! the-truths 1)
  (hear 0)
  (hear 1)
  (hear 2)
  (set! the-key "a")
  (set! the-truths 24)
  (hear 1)
  (hear 2)
  (hear 3)
  (hear 4)

  (printf "busy, wider, another id\n")
  (set! (-> the-model busy) #t)
  (set! (-> the-model wide) 3)
  (set! (-> the-model id) 8)
  (form.update (& a-form) (& the-model))
  (trace-patches!)
  (set! the-truths 0)
  (hear 1)
  (printf "nothing changed\n")
  (form.update (& a-form) (& the-model))
  (trace-patches!)
  (printf "not busy\n")
  (set! (-> the-model busy) #f)
  (form.update (& a-form) (& the-model))
  (trace-patches!))

