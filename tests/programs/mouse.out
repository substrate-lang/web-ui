mount
template 1 <canvas width="64" height="36" data-n></canvas>
clone 1 as #1 with 1 in #0 before #0
listen #2 mousedown
listen-window #2 mousemove
listen-window #2 pointerlockchange
--
events
  clicked: button 2 at x 40
  moved: 12 -5
  the lock changed: locked 1
asking for the lock
pointer-lock #2
--
asking again, by changing the number
pointer-lock #2
--
nothing changed
--
releasing
pointer-unlock #2
--
