;; HTML without comments and data-n attributes, the marks of templates and of app-render.
(define (unmarked [s string]) -> string
  (let ([b (make-buffer)] [i u32 0])
    (while (< i (-> s length))
      (cond [(string-prefix? (slice s i (-> s length)) "<!--")
             (+= i (+ (string-find (slice s i (-> s length)) "-->") 3))]
            [(string-prefix? (slice s i (-> s length)) " data-n=\"\"") (+= i 10)]
            [else
             (buffer-add-byte! (& b) (cast i32 (@ s i)))
             (+= i 1)]))
    (buffer-string (& b))))

(test rendered-agrees #:grants ((net "127.0.0.1"))
  (let ([rendered string ""] [mounted string ""])
    (with-browser (b "routed" #:server render-server:main #:url "frozen/users/7/")
      (set! rendered (unmarked (browser-html b (by-css "#root > div:last-of-type")))))
    (with-browser (b "routed" #:server server:main #:url "users/7/")
      (set! mounted (unmarked (browser-html b (by-css "#root > div:last-of-type")))))
    (expect (> (-> rendered length) 0))
    (expect-equal rendered mounted)))

(test rendered-kept #:grants ((net "127.0.0.1"))
  (with-browser (b "routed" #:server render-server:marked #:url "users/7/")
    (expect-text b (by-css "#page") "user 7")
    (expect (browser-attribute? b (by-css "#page") "data-rendered"))
    (browser-click! b (by-role "button" "Mark"))
    (expect-text b (by-css "#mark") "marked")
    (expect (browser-attribute? b (by-css "#mark") "data-rendered"))
    (browser-click! b (by-css "#home"))
    (expect-text b (by-css "#page") "home")
    (expect (not (browser-attribute? b (by-css "#page") "data-rendered")))
    (expect (browser-attribute? b (by-css "#mark") "data-rendered"))))

(test rendered-mismatch #:grants ((net "127.0.0.1"))
  (with-browser (b "routed" #:server render-server:mismatched #:url "users/7/")
    (expect-text b (by-css "#page") "user 7")
    (expect-count b (by-css "#page") 1)
    (expect (not (browser-attribute? b (by-css "#page") "data-rendered")))
    (browser-click! b (by-role "button" "Mark"))
    (expect-text b (by-css "#mark") "marked")))
