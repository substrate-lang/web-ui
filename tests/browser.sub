;; Tests that use the examples as a user would, in Chromium.
(require-unqualified std/test/browser)
(require-unqualified std/test/test)
(require-unqualified "support/twin.sub")

(test counter
  (with-browser (b "../examples/counter.sub")
    (expect-text b (by-css ".count") "0")
    (browser-click! b (by-role "button" "+"))
    (browser-click! b (by-role "button" "+"))
    (expect-text b (by-css ".count") "2")
    (expect-html b (by-css ".counter")
                 "<div class=\"counter\"><button>-</button><span class=\"count\">2</span><button>+</button><button>reset</button><!--a--></div>")
    (browser-click! b (by-role "button" "-"))
    (browser-click! b (by-role "button" "-"))
    (browser-click! b (by-role "button" "-"))
    (expect-attribute b (by-text "-1") "class" "negative")
    (browser-click! b (by-role "button" "reset"))
    (expect-text b (by-css ".count") "0")
    (expect-missing b (by-role "button" "reset"))))

(test rows
  (with-browser (b "../examples/rows.sub")
    (browser-click! b (by-role "button" "create 1,000 rows"))
    (expect-count b (by-css "tbody tr") 1000)
    (expect-text b (by-css "tbody tr:last-child td.id") "1000")
    (browser-click! b (by-role "button" "swap rows"))
    (expect-text b (by-css "tbody tr:nth-child(2) td.id") "999")
    (expect-text b (by-css "tbody tr:nth-child(999) td.id") "2")
    (browser-click! b (within (nth (by-css "tbody tr") 500) (by-text "remove")))
    (expect-count b (by-css "tbody tr") 999)
    (browser-click! b (within (nth (by-css "tbody tr") 3) (by-css "td:nth-child(2) a")))
    (expect-text b (by-css "tr.selected td.id") "3")
    (browser-click! b (by-role "button" "update every 10th row"))
    (expect-count b (by-text-containing "!!!") 100)
    (browser-click! b (by-role "button" "append 1,000 rows"))
    (expect-count b (by-css "tbody tr") 1999)
    (expect-text b (by-css "tbody tr:last-child td.id") "2000")
    (browser-click! b (by-role "button" "clear"))
    (expect-missing b (by-css "tbody tr"))))

(test fragment
  (with-browser (b "fragment.sub")
    (expect (>= (-> (browser-box b (by-css "#end")) y) 3000.0)))
  (with-browser (b "fragment.sub" #:url "#end")
    (expect-text b (by-css "#end") "the end")
    (expect (< (-> (browser-box b (by-css "#end")) y) 100.0)))
  (with-browser (b "fragment.sub" #:url "#caf%C3%A9")
    (expect (< (-> (browser-box b (by-css "#café")) y) 100.0))))

(test copies
  (twin-ready!)
  (with-browser (b "twin/copies.sub")
    (expect-text b (by-css "button") "0")
    (browser-click! b (by-css "button"))
    (expect-text b (by-css "button") "1")))

(test routes
  (with-browser (b "routed.sub")
    (expect-text b (by-css "#page") "home")
    (expect-equal (browser-url b) "http://localhost/")
    (expect-text b (by-css "title") "Home")
    (browser-click! b (by-role "button" "Mark"))
    (browser-click! b (by-css "#user"))
    (expect-text b (by-css "#page") "user 7")
    (expect-equal (browser-url b) "http://localhost/users/7/")
    (expect-text b (by-css "title") "User")
    (expect-text b (by-css "[aria-live]") "User")
    (expect-attribute b (by-css "#user") "aria-current" "page")
    (expect-text b (by-css "#mark") "marked")
    (browser-back! b)
    (expect-text b (by-css "#page") "home")
    (expect-attribute b (by-css "#user") "aria-current" "false")
    (browser-forward! b)
    (expect-text b (by-css "#page") "user 7")
    (browser-click! b (by-role "button" "Three"))
    (expect-text b (by-css "#page") "user 3")
    (expect-equal (browser-url b) "http://localhost/users/3/")
    (browser-click! b (by-css "#nope"))
    (expect-text b (by-css "#page") "lost")
    (expect-text b (by-css "title") "Lost")
    (expect-text b (by-css "#mark") "marked")))

(test route-scroll
  (with-browser (b "routed.sub")
    (browser-click! b (by-css "#long"))
    (expect-text b (by-css "title") "Long")
    (expect (< (-> (browser-box b (by-css "#end")) y) 100.0))
    (browser-click! b (by-css "#home"))
    (expect-text b (by-css "#page") "home")
    (expect (> (-> (browser-box b (by-css "#page")) y) 0.0))
    (browser-back! b)
    (expect-text b (by-css "title") "Long")
    (expect (< (-> (browser-box b (by-css "#end")) y) 100.0))))

(test route-held
  (with-browser (b "routed.sub")
    (browser-click! b (by-css "#draft"))
    (browser-click! b (by-role "button" "Edit"))
    (browser-back! b)
    (expect-text b (by-css "#stopped") "http://localhost/")
    (expect-text b (by-css "#page") "draft")
    (browser-click! b (by-css "#user"))
    (expect-text b (by-css "#stopped") "http://localhost/users/7/")
    (expect-text b (by-css "#page") "draft")
    (expect-equal (browser-url b) "http://localhost/draft/")
    (browser-click! b (by-role "button" "Save"))
    (browser-click! b (by-css "#user"))
    (expect-text b (by-css "#page") "user 7")))

(test route-ignored
  (with-browser (b "routed.sub")
    (browser-click! b (by-role "button" "Mark"))
    (browser-click! b (by-css "#download"))
    (browser-click! b (by-css "#blank"))
    (expect-text b (by-css "#page") "home")
    (expect-equal (browser-url b) "http://localhost/")
    (expect-text b (by-css "#mark") "marked")
    (browser-click! b (by-css "#external"))
    (expect-text b (by-css "#page") "home")
    (expect-equal (browser-url b) "http://localhost/?full=1")
    (expect-text b (by-css "#mark") "")))
