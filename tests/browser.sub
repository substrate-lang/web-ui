    (expect (< (-> (browser-box b (by-css "#end")) y) 100.0)))
  (with-browser (b "fragment.sub" #:url "#caf%C3%A9")
    (expect (< (-> (browser-box b (by-css "#café")) y) 100.0))))

(test routes
  (with-browser (b "routed")
    (expect-text b (by-css "#page") "home")
    (expect-equal (browser-url b) "http://localhost/")
    (expect-text b (by-css "title") "Home")
    (browser-click! b (by-role "button" "Mark"))
    (browser-click! b (by-css "#user"))
    (expect-text b (by-css "#page") "user 7")
    (expect-equal (browser-url b) "http://localhost/users/7/")
    (expect-text b (by-css "title") "User")
    (expect-text b (by-css "[aria-live]") "User")
    (expect-attribute b (by-css "#user") "aria-current" "page")
    (expect-text b (by-css "#mark") "marked")
    (browser-back! b)
    (expect-text b (by-css "#page") "home")
    (expect-attribute b (by-css "#user") "aria-current" "false")
    (browser-forward! b)
    (expect-text b (by-css "#page") "user 7")
    (browser-click! b (by-role "button" "Three"))
    (expect-text b (by-css "#page") "user 3")
    (expect-equal (browser-url b) "http://localhost/users/3/")))

(test route-served #:grants ((net "127.0.0.1"))
  (with-browser (b "routed" #:server server:main #:url "users/7")
    (expect-text b (by-css "#page") "user 7")
    (expect (string-suffix? (browser-url b) "/users/7/"))
    (browser-click! b (by-role "button" "Mark"))
    (browser-click! b (by-css "#nope"))
    (expect-text b (by-css "#page") "lost")
    (expect-text b (by-css "title") "Lost")
    (expect-text b (by-css "#mark") "")
    (expect (string-suffix? (browser-url b) "/nope/"))
    (browser-click! b (by-css "#home"))
    (expect-text b (by-css "#page") "home")
    (browser-back! b)
    (expect-text b (by-css "#page") "lost")))

