;; Tests that use the examples as a user would, in Chromium.
(require-unqualified std/test/browser)
(require-unqualified std/test/test)
(require server "support/server.sub")
(require render-server "support/render-server.sub")
(require-unqualified std/string)

(test counter
  (with-browser (b "../examples/counter.sub")
    (expect-text b (by-css ".count") "0")
    (browser-click! b (by-role "button" "+"))
    (browser-click! b (by-role "button" "+"))
    (expect-text b (by-css ".count") "2")
    (expect-html b (by-css ".counter")
                 "<div class=\"counter\"><button>-</button><span class=\"count\">2</span><button>+</button><button>reset</button><!--a--></div>")
    (browser-click! b (by-role "button" "-"))
    (browser-click! b (by-role "button" "-"))
    (browser-click! b (by-role "button" "-"))
    (expect-attribute b (by-text "-1") "class" "negative")
    (browser-click! b (by-role "button" "reset"))
    (expect-text b (by-css ".count") "0")
    (expect-missing b (by-role "button" "reset"))))

(test rows
  (with-browser (b "../examples/rows.sub")
    (browser-click! b (by-role "button" "create 1,000 rows"))
    (expect-count b (by-css "tbody tr") 1000)
    (expect-text b (by-css "tbody tr:last-child td.id") "1000")
    (browser-click! b (by-role "button" "swap rows"))
    (expect-text b (by-css "tbody tr:nth-child(2) td.id") "999")
    (expect-text b (by-css "tbody tr:nth-child(999) td.id") "2")
    (browser-click! b (within (nth (by-css "tbody tr") 500) (by-text "remove")))
    (expect-count b (by-css "tbody tr") 999)
    (browser-click! b (within (nth (by-css "tbody tr") 3) (by-css "td:nth-child(2) a")))
    (expect-text b (by-css "tr.selected td.id") "3")
    (browser-click! b (by-role "button" "update every 10th row"))
    (expect-count b (by-text-containing "!!!") 100)
    (browser-click! b (by-role "button" "append 1,000 rows"))
    (expect-count b (by-css "tbody tr") 1999)
    (expect-text b (by-css "tbody tr:last-child td.id") "2000")
    (browser-click! b (by-role "button" "clear"))
    (expect-missing b (by-css "tbody tr"))))

(test fragment
  (with-browser (b "fragment.sub")
