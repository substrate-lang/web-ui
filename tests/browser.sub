(test route-scroll
  (with-browser (b "routed")
    (browser-click! b (by-css "#long"))
    (expect-text b (by-css "title") "Long")
    (expect (< (-> (browser-box b (by-css "#end")) y) 100.0))
    (browser-click! b (by-css "#home"))
    (expect-text b (by-css "#page") "home")
    (expect (> (-> (browser-box b (by-css "#page")) y) 0.0))
    (browser-back! b)
    (expect-text b (by-css "title") "Long")
    (expect (< (-> (browser-box b (by-css "#end")) y) 100.0))))

(define (box-y [b browser] [f finder]) -> f64 (-> (browser-box b f) y))
(define (near? [a f64] [b f64]) -> bool (and (> (- a b) -2.0) (< (- a b) 2.0)))

(test route-fragment
  (with-browser (b "routed")
    (browser-click! b (by-role "button" "Mark"))
    (browser-click! b (by-css "#long"))
    (expect (< (box-y b (by-css "#end")) 100.0))
    (browser-hover! b (by-css "#to-start"))
    (let ([at-end (box-y b (by-css "#to-start"))])
      (browser-click! b (by-css "#to-start"))
      (expect-equal (browser-url b) "http://localhost/long/#start")
      (expect (< (box-y b (by-css "#start")) 100.0))
      (expect-text b (by-css "#hashes") "1")
      (browser-hover! b (by-css "#to-end"))
      (let ([at-start (box-y b (by-css "#to-end"))])
        (browser-click! b (by-css "#to-end"))
        (expect-equal (browser-url b) "http://localhost/long/#end")
        (expect-text b (by-css "#hashes") "2")
        (browser-click! b (by-css "#to-end"))
        (expect (< (box-y b (by-css "#end")) 100.0))
        (expect-text b (by-css "#hashes") "2")
        (browser-back! b)
        (expect-equal (browser-url b) "http://localhost/long/#start")
        (expect (near? (box-y b (by-css "#to-end")) at-start))
        (expect-text b (by-css "#hashes") "3"))
      (browser-back! b)
      (expect-equal (browser-url b) "http://localhost/long/#end")
      (expect (near? (box-y b (by-css "#to-start")) at-end)))
    (browser-back! b)
    (expect-text b (by-css "#page") "home")
    (expect-text b (by-css "#mark") "marked")))

(test route-held
