(test svg
  (with-browser (b "svg.sub")
    (expect-equal (-> (browser-box b (by-css "#dot")) width) 20.0)
    (expect-equal (-> (browser-box b (by-css "#marker rect")) width) 10.0)
    (expect-equal (-> (browser-box b (by-css "#badge circle")) width) 16.0)
    (expect (> (-> (browser-box b (by-css "#inside")) width) 0.0))
    (expect-text b (by-css "#label") "still")
    (expect-missing b (by-css "#box"))
    (browser-click! b (by-role "button" "Toggle"))
    (expect-equal (-> (browser-box b (by-css "#box")) width) 30.0)
    (browser-click! b (by-role "button" "Add"))
    (expect-equal (-> (browser-box b (by-css "circle.dot")) width) 10.0)
    (browser-click! b (by-role "button" "Add"))
    (expect-count b (by-css "circle.dot") 2)
    (let ([x (-> (browser-box b (by-css "#dot")) x)])
      (browser-click! b (by-role "button" "Move"))
      (expect-text b (by-css "#label") "moved")
      (expect-equal (- (-> (browser-box b (by-css "#dot")) x) x) 50.5))))

