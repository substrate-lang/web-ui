;; The examples, used as a user would use them, in the simulated browser.
(require-unqualified browsing std/test/browser)

(test snake
  (with-browser (b "snake")
    (browser-advance! b 100)
    (expect-text b (by-css "#status") "Press an arrow key to start.")
    (expect-text b (by-css "#score") "0")
    (expect-drawn b (by-css "#board") "fill-style \"#b4f1a7\"\nfill-rect 201 201 18 18")
    (browser-press! b "ArrowRight")
    (expect-text b (by-css "#status") "Arrow keys or W A S D to turn. Space to pause.")
    (browser-advance! b 1000)
    (expect (not (browser-drawn? b (by-css "#board") "fill-style \"#b4f1a7\"\nfill-rect 201 201 18 18")))
    (browser-press! b " ")
    (expect-text b (by-css "#status") "Paused. Press Space to continue.")
    (browser-press! b " ")
    (expect-text b (by-css "#status") "Arrow keys or W A S D to turn. Space to pause.")
    (browser-advance! b 20000)
    (expect-text b (by-css "#status") "Game over. Press Enter to play again.")
    (browser-press! b "ArrowLeft")
    (expect-text b (by-css "#status") "Game over. Press Enter to play again.")
    (browser-press! b "Enter")
    (expect-text b (by-css "#status") "Press an arrow key to start.")
    (browser-click! b (by-role "button" "New game"))
    (expect-text b (by-css "#status") "Press an arrow key to start.")
    (browser-press! b "a")
    (expect-text b (by-css "#status") "Arrow keys or W A S D to turn. Space to pause.")))

(test snake-best-score
  (with-browser (b "snake")
    (browser-storage-set! b "best" "42")
    (browser-reload! b)
    (expect-text b (by-css "#best") "42")))

(test counter
  (with-browser (b "../examples/counter.sub")
    (expect-text b (by-css ".count") "0")
    (browser-click! b (by-role "button" "+"))
    (browser-click! b (by-role "button" "+"))
    (expect-text b (by-css ".count") "2")
    (expect-html b (by-css ".counter")
                 "<div class=\"counter\"><button>-</button><span class=\"count\">2</span><button>+</button><button>reset</button><!--a--></div>")
    (browser-click! b (by-role "button" "-"))
    (browser-click! b (by-role "button" "-"))
    (browser-click! b (by-role "button" "-"))
    (expect-attribute b (by-text "-1") "class" "negative")
    (browser-click! b (by-role "button" "reset"))
    (expect-text b (by-css ".count") "0")
    (expect-missing b (by-role "button" "reset"))))

(test rows
  (with-browser (b "../examples/rows.sub")
    (browser-click! b (by-role "button" "create 1,000 rows"))
    (expect-count b (by-css "tbody tr") 1000)
    (expect-text b (by-css "tbody tr:last-child td.id") "1000")
    (browser-click! b (by-role "button" "swap rows"))
    (expect-text b (by-css "tbody tr:nth-child(2) td.id") "999")
    (expect-text b (by-css "tbody tr:nth-child(999) td.id") "2")
    (browser-click! b (within (nth (by-css "tbody tr") 500) (by-text "remove")))
    (expect-count b (by-css "tbody tr") 999)
    (browser-click! b (within (nth (by-css "tbody tr") 3) (by-css "td:nth-child(2) a")))
    (expect-text b (by-css "tr.selected td.id") "3")
    (browser-click! b (by-role "button" "update every 10th row"))
    (expect-count b (by-text-containing "!!!") 100)
    (browser-click! b (by-role "button" "append 1,000 rows"))
    (expect-count b (by-css "tbody tr") 1999)
    (expect-text b (by-css "tbody tr:last-child td.id") "2000")
    (browser-click! b (by-role "button" "clear"))
    (expect-missing b (by-css "tbody tr"))))

(test platformer
  (with-browser (b "platformer")
    (browser-advance! b 500)
    (expect-drawn b (nth (by-css "canvas") 2) "fill-text \"level 1   coins 0/18\" 6 5")
    (browser-key-down! b "ArrowRight")
    (browser-advance! b 500)
    (browser-key-up! b "ArrowRight")
    (browser-press! b " ")
    (browser-advance! b 300)
    (expect-equal (browser-sounds b) "tone square 320 640 110 ms")
    (expect-missing b (by-css ".game-stopped"))
    (expect-equal (browser-console b) "")))

(test blocks
  (with-browser (b "blocks")
