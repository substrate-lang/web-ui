;; The test app's server: the site's files, and the app for a path that names none, as the app's routes read it.
(require-unqualified host/events)
(require-unqualified std/http)
(require-unqualified std/http/server)
(require-unqualified std/http/static)
(require-unqualified "../places.sub")

(provide main)

(define server http-server)
(define files http-files)
(define apps (array http-app 1))

(define (handle [r (ptr http-request)]) (http-static! r (& files)))

(define (listening [s (ptr http-server)])
  (let ([line (make-buffer)])
    (buffer-add-string! (& line) "http://127.0.0.1:")
    (http-add-decimal! (& line) (cast i64 (-> s port)))
    (buffer-add-string! (& line) "/\n")
    (host-write 1 (buffer-bytes (& line)))))

(define (main)
  (set! (-> files root) (@ (host-args) 0))
  (set! (@ apps 0) (http-app #:path "/" #:page "index.html" #:routes place.url-check))
  (set! (-> files apps) (slice apps))
  (set! (-> server listening) listening)
  (let ([why error])
    (unless (http-serve! (& server) 0 handle (& why)) (host-exit 1 (error-text (& why))))))
