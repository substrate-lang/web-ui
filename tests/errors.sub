(require-unqualified std/test/build)

(test err-arguments (expect-compile-error "fail/err-arguments.sub" "err-arguments.sub:13:9: error: view: the view row takes 1 argument, but this passes 2"))
(test err-component-event (expect-compile-error "fail/err-component-event.sub" "err-component-event.sub:21:17: error: view: chnged is not an event of the component counter, whose events are (changed)"))
(test err-component-message (expect-compile-error "fail/err-component-message.sub" "err-component-message.sub:21:25: error: view: the message named takes (string), but the event changed carries (i32)"))
(test err-component-missing (expect-compile-error "fail/err-component-missing.sub" "err-component-missing.sub:14:3: error: view: the component counter needs the parameter start"))
(test err-component-parameter (expect-compile-error "fail/err-component-parameter.sub" "err-component-parameter.sub:14:23: error: view: the component counter has no parameter stepp"))
(test err-component-state (expect-compile-error "fail/err-component-state.sub" "err-component-state.sub:8:1: error: component: a component needs #:state [name TYPE]"))
(test err-emit (expect-compile-error "fail/err-emit.sub" "err-emit.sub:7:83: error: emit!: expected a case of a variant: (case value ...), or case alone"))
(test err-attribute (expect-compile-error "fail/err-attribute.sub" "err-attribute.sub:10:10: error: view: unknown attribute clas for the element div (to use an attribute that HTML does not define, write its name as a string: [\"clas\" value])"))
(test err-draw (expect-compile-error "fail/err-draw.sub" "err-draw.sub:10:10: error: view: draw can only be used on a canvas element"))
(test err-draw-key (expect-compile-error "fail/err-draw-key.sub" "err-draw-key.sub:10:18: error: expected i64, got string"))
(test err-element (expect-compile-error "fail/err-element.sub" "err-element.sub:11:6: error: view: unknown element dvi: it is not an HTML or SVG element or a view (a custom element's name must be lower-case and contain a hyphen)"))
(test err-event (expect-compile-error "fail/err-event.sub" "err-event.sub:10:16: error: view: unknown event clik (to listen for an event that the DOM does not define, write its name as a string: [on \"clik\" message])"))
(test err-event-data (expect-compile-error "fail/err-event-data.sub" "err-event-data.sub:10:35: error: expected string, got bool"))
(test err-event-name (expect-compile-error "fail/err-event-name.sub" "err-event-name.sub:9:27: error: view: expected (event-number \"name\")"))
(test err-event-word (expect-compile-error "fail/err-event-word.sub" "err-event-word.sub:10:28: error: view: unknown event data: expected (event value), (event key), (event shift), (event control), (event alt), (event meta), (event checked), (event locked), (event time), (event x), (event y), (event movement-x), (event movement-y), (event button), (event visible), (event-number \"name\") or (event-text \"name\")"))
(test err-frame (expect-compile-error "fail/err-frame.sub" "err-frame.sub:10:16: error: view: frame is an event of the window, not of an element: write [on-window frame message]"))
(test err-key (expect-compile-error "fail/err-key.sub" "err-key.sub:12:45: error: expected u64, got string"))
(test err-mark (expect-compile-error "fail/err-mark.sub" "err-mark.sub:10:8: error: view: the attribute data-n is reserved: ui.sub uses it to mark elements"))
(test err-number (expect-compile-error "fail/err-number.sub" "err-number.sub:10:28: error: expected i64, got string"))
(test err-view-messages (expect-compile-error "fail/err-view-messages.sub" "err-view-messages.sub:18:7: error: view: the view row sends messages of the type row-message, but this view's messages are list-message"))
(test err-truth (expect-compile-error "fail/err-truth.sub" "err-truth.sub:10:7: error: view: hidden is a boolean attribute: write [hidden], or [hidden e] where e is a condition"))
(test err-window-event (expect-compile-error "fail/err-window-event.sub" "err-window-event.sub:10:23: error: view: unknown event keydwn (to listen for an event that the DOM does not define, write its name as a string: [on-window \"keydwn\" message])"))
(test err-changed (expect-compile-error "fail/err-changed.sub" "err-changed.sub:10:13: error: component: #:changed needs parameters"))
(test err-root-view (expect-compile-error "fail/err-root-view.sub" "err-root-view.sub:9:22: error: ui-root: a view put in an element has no component to take its messages"))
(test err-view-option (expect-compile-error "fail/err-view-option.sub" "err-view-option.sub:4:13: error: view: the options are #:messages TYPE and #:style css"))
(test err-route-messages (expect-compile-error "fail/err-route-messages.sub" "err-route-messages.sub:8:11: error: component: #:route needs #:messages"))
(test err-route-case (expect-compile-error "fail/err-route-case.sub" "err-route-case.sub:14:11: error: component: #:route's case must hold a route, a value of a routable type"))
(test err-route-init (expect-compile-error "fail/err-route-init.sub" "err-route-init.sub:15:11: error: component: #:route needs #:init, which takes the route the instance starts at"))
(test err-leaving-case (expect-compile-error "fail/err-leaving-case.sub" "err-leaving-case.sub:16:20: error: component: #:leaving's case must hold a string, the URL that the user went for"))
(test err-attach-routes (expect-compile-error "fail/err-attach-routes.sub" "err-attach-routes.sub:8:18: error: attach: #:routes takes a routable type, and place is not one"))
(test err-match (expect-compile-error "fail/err-match.sub" "err-match.sub:5:3: error: view: expected (match e [pattern child ...] ...)"))
(test err-title (expect-compile-error "fail/err-title.sub" "err-title.sub:5:3: error: view: expected (title e), the document's title while this is shown"))
(test err-svg-in-html (expect-compile-error "fail/err-svg-in-html.sub" "err-svg-in-html.sub:5:9: error: view: circle is an SVG element: it goes inside svg"))
(test err-html-in-svg (expect-compile-error "fail/err-html-in-svg.sub" "err-html-in-svg.sub:5:9: error: view: div is not an SVG element: inside svg, HTML goes in foreignObject"))
(test err-svg-attribute (expect-compile-error "fail/err-svg-attribute.sub" "err-svg-attribute.sub:5:10: error: view: unknown attribute viewbox for the SVG element svg (to use an attribute that SVG does not define, write its name as a string: [\"viewbox\" value])"))
(test err-svg-value (expect-compile-error "fail/err-svg-value.sub" "err-svg-value.sub:5:20: error: view: an SVG attribute's value is a string or a number"))
(test err-svg-view (expect-compile-error "fail/err-svg-view.sub" "err-svg-view.sub:7:8: error: view: the view spot starts with SVG elements, so it goes inside svg"))
(test err-svg-link (expect-compile-error "fail/err-svg-link.sub" "err-svg-link.sub:7:8: error: view: the view spot starts with SVG elements, so it goes inside svg"))
(test err-mixed-roots (expect-compile-error "fail/err-mixed-roots.sub" "err-mixed-roots.sub:4:1: error: view: this view starts with both HTML and SVG elements"))
(test err-math (expect-compile-error "fail/err-math.sub" "err-math.sub:5:9: error: view: math is not supported: a view can contain HTML and SVG, not MathML"))
