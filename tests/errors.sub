(require-unqualified std/test/build)

(test err-arguments (expect-compile-error "fail/err-arguments.sub" "err-arguments.sub:13:9: error: view: the view row takes 1 argument, but this passes 2"))
(test err-attribute (expect-compile-error "fail/err-attribute.sub" "err-attribute.sub:10:10: error: view: unknown attribute clas for the element div (to use an attribute that HTML does not define, write its name as a string: [\"clas\" value])"))
(test err-draw (expect-compile-error "fail/err-draw.sub" "err-draw.sub:10:10: error: view: draw can only be used on a canvas element"))
(test err-draw-key (expect-compile-error "fail/err-draw-key.sub" "err-draw-key.sub:10:18: error: expected i64, got string"))
(test err-element (expect-compile-error "fail/err-element.sub" "err-element.sub:11:6: error: view: unknown element dvi: it is not an HTML element or a view (a custom element's name must be lower-case and contain a hyphen)"))
(test err-event (expect-compile-error "fail/err-event.sub" "err-event.sub:10:16: error: view: unknown event clik (to listen for an event that the DOM does not define, write its name as a string: [on \"clik\" message])"))
(test err-event-data (expect-compile-error "fail/err-event-data.sub" "err-event-data.sub:10:35: error: expected string, got bool"))
(test err-event-word (expect-compile-error "fail/err-event-word.sub" "err-event-word.sub:10:28: error: view: unknown event data: expected (event value), (event key), (event shift), (event control), (event alt), (event meta), (event checked), (event locked), (event time), (event x), (event y), (event movement-x), (event movement-y) or (event button)"))
(test err-format-directive (expect-compile-error "fail/err-format-directive.sub" "err-format-directive.sub:3:30: error: format: ~q is not a formatting directive"))
(test err-format-few (expect-compile-error "fail/err-format-few.sub" "err-format-few.sub:3:30: error: format: the pattern has more directives than there are arguments"))
(test err-format-many (expect-compile-error "fail/err-format-many.sub" "err-format-many.sub:3:43: error: format: there are more arguments than directives in the pattern"))
(test err-format-pattern (expect-compile-error "fail/err-format-pattern.sub" "err-format-pattern.sub:2:58: error: format: the pattern must be written as a string"))
(test err-format-type (expect-compile-error "fail/err-format-type.sub" "err-format-type.sub:3:41: error: expected i64, got string"))
(test err-frame (expect-compile-error "fail/err-frame.sub" "err-frame.sub:10:16: error: view: frame is an event of the window, not of an element: write [on-window frame message]"))
(test err-game-size (expect-compile-error "fail/err-game-size.sub" "err-game-size.sub:10:1: error: game: expected (game World [size width height] init step draw), with the width and height written as numbers"))
(test err-key (expect-compile-error "fail/err-key.sub" "err-key.sub:12:45: error: expected u64, got string"))
(test err-mark (expect-compile-error "fail/err-mark.sub" "err-mark.sub:10:8: error: view: the attribute data-n is reserved: ui.sub uses it to mark elements"))
(test err-number (expect-compile-error "fail/err-number.sub" "err-number.sub:10:28: error: expected i64, got string"))
(test err-shade-arguments (expect-compile-error "fail/err-shade-arguments.sub" "error: shade: dot is not defined on vec2"))
(test err-shade-field (expect-compile-error "fail/err-shade-field.sub" "error: shade: varyings has no field size"))
(test err-shade-literal-vector (expect-compile-error "fail/err-shade-literal-vector.sub" "error: shade: max is not defined on vec3, a decimal number"))
(test err-shade-missing-else (expect-compile-error "fail/err-shade-missing-else.sub" "error: shade: the function's result is this if, so it needs an else"))
(test err-shade-statement (expect-compile-error "fail/err-shade-statement.sub" "error: shade: when is a statement; it has no value to use here"))
(test err-shade-swizzle (expect-compile-error "fail/err-shade-swizzle.sub" "error: shade: vec2 has no z"))
(test err-shade-unknown-variable (expect-compile-error "fail/err-shade-unknown-variable.sub" "error: shade: unknown variable q"))
(test err-shade-wrong-type (expect-compile-error "fail/err-shade-wrong-type.sub" "error: shade: expected f32, got vec3"))
(test err-store-kind (expect-compile-error "fail/err-store-kind.sub" "err-store-kind.sub:11:29: error: expected (handle enemy), got (handle coin)"))
(test err-truth (expect-compile-error "fail/err-truth.sub" "err-truth.sub:10:7: error: view: hidden is a boolean attribute: write [hidden], or [hidden e] where e is a condition"))
(test err-window-event (expect-compile-error "fail/err-window-event.sub" "err-window-event.sub:10:23: error: view: unknown event keydwn (to listen for an event that the DOM does not define, write its name as a string: [on-window \"keydwn\" message])"))
